{
  "entities": {
    "Class": {
      "title": "Class",
      "description": "A class folder containing assignments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "An assignment within a class",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Candidate": {
      "title": "Candidate",
      "description": "A student candidate record with report data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentName": { "type": "string" },
        "date": { "type": "string" },
        "score": { "type": "number" },
        "iaqa_score": { "type": "number" },
        "moderated_score": { "type": "number" },
        "report": { "type": "object" },
        "submissionType": { "type": "string", "enum": ["Draft", "Final"] },
        "subject": { "type": "string" },
        "progressSummary": { "type": "string" },
        "scoreDelta": { "type": "number" }
      },
      "required": ["id", "studentName", "date", "score", "report"]
    }
  },
  "firestore": {
    "classes/{classId}": {
      "schema": "Class",
      "description": "Top-level class folders"
    },
    "classes/{classId}/assignments/{assignmentId}": {
      "schema": "Assignment",
      "description": "Assignments within a class"
    },
    "classes/{classId}/assignments/{assignmentId}/candidates/{candidateId}": {
      "schema": "Candidate",
      "description": "Candidate records within an assignment"
    }
  }
}
