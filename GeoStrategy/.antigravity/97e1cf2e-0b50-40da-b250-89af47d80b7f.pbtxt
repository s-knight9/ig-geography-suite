me=\"p-1 bg-white/20 hover:bg-white/40 border-l border-white/20\"\n                        >\n                          <Trash2 size={12} />\n                        </button>\n                      </div>\n                    ))}\n                  </div>\n                  \n                  <div className=\"space-y-4\">\n                    <label className=\"text-[10px] font-black uppercase tracking-widest text-slate-400\">Targeted Multi-Conceptual Pillars</label>\n                    <div className=\"grid grid-cols-2 md:grid-cols-3 gap-3\">\n                      {GEOGRAPHIC_PILLARS.map((pillar) => (\n                        <button\n                          key={pillar.id}\n                          onClick={() => togglePillar(pillar.label)}\n                          className={cn(\n                            \"px-4 py-2 border-2 text-[10px] font-black uppercase tracking-widest transition-all\",\n                            formData.conceptualPillars.includes(pillar.label)\n                              ? \"bg-emerald-400 border-slate-900 shadow-[3px_3px_0px_0px_rgba(15,23,42,1)]\"\n                              : \"bg-white border-slate-200 text-slate-400 hover:border-slate-900 hover:text-slate-900\"\n                          )}\n                        >\n                          {pillar.label}\n                        </button>\n                      ))}\n                    </div>\n                  </div>\n                </section>\n              </div>\n\n              <div className=\"col-span-12 md:col-span-5 flex flex-col gap-8\">\n                <section className=\"bg-white border-2 border-slate-900 p-8 shadow-[6px_6px_0px_0px_rgba(15,23,42,1)]\">\n                  <label className=\"text-[10px] font-black uppercase tracking-widest text-slate-500 block mb-6\">05. Essay Framework</label>\n                  <div className=\"flex bg-slate-100 p-1 border-2 border-slate-900 mb-8\">\n                    <button \n                      onClick={() => setFormData(prev => ({ ...prev, structure: \'PEEL\' }))}\n                      className={cn(\n                        \"flex-1 py-3 text-xs font-black uppercase tracking-widest transition-all\",\n                        formData.structure === \'PEEL\' ? \"bg-slate-900 text-white\" : \"text-slate-400 hover:text-slate-900\"\n                      )}\n                    >\n                      PEEL\n                    </button>\n                    <button \n                      onClick={() => setFormData(prev => ({ ...prev, structure: \'PEECAL\' }))}\n                      className={cn(\n                        \"flex-1 py-3 text-xs font-black uppercase tracking-widest transition-all\",\n                        formData.structure === \'PEECAL\' ? \"bg-slate-900 text-white\" : \"text-slate-400 hover:text-slate-900\"\n                      )}\n                    >\n                      PEECAL\n                    </button>\n                  </div>\n\n                  <div className=\"grid grid-cols-3 gap-2\">\n                    {(formData.structure === \'PEEL\' ? [\'Point\', \'Evidence\', \'Explain\', \'Link\'] : [\'Point\', \'Evidence\', \'Explain\', \'Counter\', \'Analysis\', \'Link\']).map((label) => (\n                      <div key={label} className=\"border-2 border-slate-900 p-3 flex flex-col items-center justify-center bg-slate-50 shadow-[2px_2px_0px_0px_rgba(15,23,42,1)]\">\n                        <span className=\"text-[9px] font-black uppercase tracking-tighter text-slate-900 italic\">{label}</span>\n                      </div>\n                    ))}\n                  </div>\n                </section>\n\n                <div className=\"mt-auto flex gap-4\">\n                  <button \n                    onClick={() => setCurrentStep(\'question\')}\n                    className=\"flex-1 bg-white border-2 border-slate-900 py-4 font-black uppercase tracking-widest shadow-[4px_4px_0px_0px_rgba(15,23,42,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none\"\n                  >\n                    Back\n                  </button>\n                  <button \n                    onClick={() => setCurrentStep(\'sources\')}\n                    className=\"flex-1 bg-emerald-500 border-2 border-slate-900 py-4 font-black uppercase tracking-widest shadow-[4px_4px_0px_0px_rgba(15,23,42,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none\"\n                  >\n                    Next\n                  </button>\n                </div>\n              </div>\n            </motion.div>\n          )}"
