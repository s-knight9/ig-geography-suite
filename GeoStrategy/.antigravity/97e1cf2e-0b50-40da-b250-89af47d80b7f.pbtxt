    replacement_chunks {
      target_content: "          {currentStep === \'planning\' && (\n            <motion.div \n              key=\"planning\"\n              initial={{ opacity: 0, y: 10 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -10 }}\n              className=\"space-y-12\"\n            >\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-12\">\n                <section className=\"space-y-6\">\n                  <div className=\"flex items-center justify-between\">\n                    <label className=\"text-xs font-bold uppercase tracking-widest text-[#6B7280]\">Body Paragraph Focuses</label>\n                    <button \n                      onClick={() => handleAddField(\'paragraphFocuses\')}\n                      className=\"p-2 hover:bg-gray-100 rounded-full transition-all text-[#5A5E4D]\"\n                    >\n                      <Plus size={20} />\n                    </button>\n                  </div>\n                  <p className=\"text-xs text-[#6B7280] italic\">Identify the core geographic sub-themes for your analysis.</p>\n                  <div className=\"space-y-4\">\n                    {formData.paragraphFocuses.map((focus, idx) => (\n                      <div key={idx} className=\"flex gap-3\">\n                        <div className=\"flex-none w-10 h-12 bg-gray-100 rounded-xl flex items-center justify-center font-mono text-xs font-bold\">\n                          BP{idx + 1}\n                        </div>\n                        <input \n                          className=\"flex-1 h-12 bg-white border border-[#E5E5E5] rounded-xl px-4 focus:outline-none focus:ring-2 focus:ring-[#5A5E4D]/20 transition-all\"\n                          placeholder=\"e.g., Impact of resource extraction on local ecosystems\"\n                          value={focus}\n                          onChange={(e) => handleFieldChange(\'paragraphFocuses\', idx, e.target.value)}\n                        />\n                        <button \n                          onClick={() => handleRemoveField(\'paragraphFocuses\', idx)}\n                          className=\"p-3 text-red-300 hover:text-red-500 transition-colors\"\n                        >\n                          <Trash2 size={18} />\n                        </button>\n                      </div>\n                    ))}\n                  </div>\n                </section>\n\n                <section className=\"space-y-6\">\n                  <div className=\"flex items-center justify-between\">\n                    <label className=\"text-xs font-bold uppercase tracking-widest text-[#6B7280]\">Concepts & Perspectives</label>\n                    <button \n                      onClick={() => handleAddField(\'concepts\')}\n                      className=\"p-2 hover:bg-gray-100 rounded-full transition-all text-[#5A5E4D]\"\n                    >\n                      <Plus size={20} />\n                    </button>\n                  </div>\n                  <p className=\"text-xs text-[#6B7280] italic\">List IB Geography concepts (Scale, Sustainability, Power, etc.) or specific stakeholder perspectives.</p>\n                  <div className=\"space-y-4\">\n                    {formData.concepts.map((concept, idx) => (\n                      <div key={idx} className=\"flex gap-3\">\n                        <input \n                          className=\"flex-1 h-12 bg-[#F9FAFB] border border-[#E5E5E5] rounded-xl px-4 focus:outline-none focus:ring-2 focus:ring-[#5A5E4D]/20 transition-all font-medium\"\n                          placeholder=\"e.g., Sustainability or Malthusian Perspective\"\n                          value={concept}\n                          onChange={(e) => handleFieldChange(\'concepts\', idx, e.target.value)}\n                        />\n                        <button \n                          onClick={() => handleRemoveField(\'concepts\', idx)}\n                          className=\"p-3 text-red-300 hover:text-red-500 transition-colors\"\n                        >\n                          <Trash2 size={18} />\n                        </button>\n                      </div>\n                    ))}\n                  </div>\n                </section>\n              </div>\n\n              <section className=\"space-y-6\">\n                <div>\n                  <label className=\"text-xs font-bold uppercase tracking-widest text-[#6B7280]\">Key Geographic Pillars (4Ps & 2Ss)</label>\n                  <p className=\"text-sm text-gray-500 mt-1 italic\">Select core conceptual frameworks to guide the analysis.</p>\n                </div>\n                <div className=\"grid grid-cols-2 md:grid-cols-6 gap-4\">\n                  {GEOGRAPHIC_PILLARS.map((pillar) => (\n                    <button\n                      key={pillar.id}\n                      onClick={() => togglePillar(pillar.label)}\n                      className={cn(\n                        \"h-20 border rounded-2xl flex flex-col items-center justify-center gap-1 transition-all group\",\n                        formData.conceptualPillars.includes(pillar.label)\n                          ? \"border-[#5A5E4D] bg-[#5A5E4D] text-white shadow-lg shadow-[#5A5E4D]/20 scale-[1.02]\"\n                          : \"border-[#E5E5E5] bg-white text-[#6B7280] hover:border-[#D1D5DB]\"\n                      )}\n                    >\n                      <span className={cn(\n                        \"text-[9px] font-bold uppercase tracking-tighter opacity-60\",\n                        formData.conceptualPillars.includes(pillar.label) ? \"text-white\" : \"text-[#9CA3AF]\"\n                      )}>\n                        {pillar.category}\n                      </span>\n                      <span className=\"text-sm font-bold\">{pillar.label}</span>\n                      {formData.conceptualPillars.includes(pillar.label) && (\n                        <motion.div layoutId=\"check\" className=\"absolute top-2 right-2\">\n                           <CheckCircle2 size={12} className=\"text-white pt-1\" />\n                        </motion.div>\n                      )}\n                    </button>\n                  ))}\n                </div>\n              </section>\n\n              <section className=\"bg-white border border-[#E5E5E5] rounded-3xl p-8 space-y-6\">\n                <div className=\"flex items-center justify-between\">\n                  <div>\n                    <h3 className=\"font-serif italic text-xl font-medium\">Response Architecture</h3>\n                    <p className=\"text-sm text-[#6B7280]\">Select the standard for your evidentiary depth.</p>\n                  </div>\n                  <div className=\"flex bg-gray-100 p-1 rounded-xl\">\n                    <button \n                      onClick={() => setFormData(prev => ({ ...prev, structure: \'PEEL\' }))}\n                      className={cn(\n                        \"px-6 h-10 rounded-lg text-xs font-bold uppercase tracking-widest transition-all\",\n                        formData.structure === \'PEEL\' ? \"bg-white text-[#5A5E4D] shadow-sm\" : \"text-[#9CA3AF] hover:text-[#4B5563]\"\n                      )}\n                    >\n                      PEEL\n                    </button>\n                    <button \n                      onClick={() => setFormData(prev => ({ ...prev, structure: \'PEECAL\' }))}\n                      className={cn(\n                        \"px-6 h-10 rounded-lg text-xs font-bold uppercase tracking-widest transition-all\",\n                        formData.structure === \'PEECAL\' ? \"bg-white text-[#5A5E4D] shadow-sm\" : \"text-[#9CA3AF] hover:text-[#4B5563]\"\n                      )}\n                    >\n                      PEECAL\n                    </button>\n                  </div>\n                </div>\n\n                <div className=\"grid grid-cols-2 md:grid-cols-6 gap-2\">\n                  {(formData.structure === \'PEEL\' ? [\'Point\', \'Evidence\', \'Explain\', \'Link\'] : [\'Point\', \'Evidence\', \'Explain\', \'Counter\', \'Analysis\', \'Link\']).map((label) => (\n                    <div key={label} className=\"h-20 border border-dashed border-[#E5E5E5] rounded-xl flex flex-col items-center justify-center gap-1 bg-gray-50/50\">\n                      <span className=\"text-[10px] uppercase font-bold text-[#9CA3AF] tracking-tighter\">{label}</span>\n                      <CheckCircle2 size={16} className=\"text-[#D1D5DB]\" />\n                    </div>\n                  ))}\n                </div>\n                <div className=\"p-4 bg-[#5A5E4D]/5 rounded-xl border border-[#5A5E4D]/10 text-sm text-[#5A5E4D]/80 leading-relaxed italic\">\n                  {formData.structure === \'PEEL\' \n                    ? \"Point, Evidence, Explanation, Link: Standard for balanced analysis.\" \n                    : \"Point, Evidence, Explanation, Counter-Argument, Analysis, Link: Optimized for 16-mark evaluative essays.\"}\n                </div>\n              </section>\n\n              <div className=\"flex justify-between items-center\">\n                <button \n                  onClick={() => setCurrentStep(\'question\')}\n                  className=\"text-sm font-bold text-[#6B7280] hover:text-[#1A1A1A] transition-all\"\n                >\n                  Back to Question\n                </button>\n                <button \n                  onClick={() => setCurrentStep(\'sources\')}\n                  className=\"bg-[#5A5E4D] text-white px-8 h-14 rounded-full font-bold hover:bg-[#4A4E3D] transition-all flex items-center gap-3 shadow-lg\"\n                >\n                  Advance to Evidence <ChevronRight size={20} />\n                </button>\n              </div>\n            </motion.div>\n          )}"
      replacement_content: "          {currentStep === \'planning\' && (\n            <motion.div \n              key=\"planning\"\n              initial={{ opacity: 0, scale: 0.95 }}\n              animate={{ opacity: 1, scale: 1 }}\n              exit={{ opacity: 0, scale: 0.95 }}\n              className=\"grid grid-cols-12 gap-8\"\n            >\n              <div className=\"col-span-12 md:col-span-7 flex flex-col gap-8\">\n                <section className=\"bg-white border-2 border-slate-900 p-8 shadow-[6px_6px_0px_0px_rgba(15,23,42,1)]\">\n                  <div className=\"flex items-center justify-between mb-8\">\n                    <label className=\"text-[10px] font-black uppercase tracking-widest text-slate-500\">03. Body Paragraph Focuses</label>\n                    <button \n                      onClick={() => handleAddField(\'paragraphFocuses\')}\n                      className=\"p-2 bg-slate-900 text-white border-2 border-slate-900 shadow-[2px_2px_0px_0px_rgba(15,23,42,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all\"\n                    >\n                      <Plus size={20} />\n                    </button>\n                  </div>\n                  <div className=\"space-y-6\">\n                    {formData.paragraphFocuses.map((focus, idx) => (\n                      <div key={idx} className=\"flex gap-4\">\n                        <div className=\"flex-none w-10 h-10 bg-slate-900 text-white flex items-center justify-center font-black text-xs\">\n                          P{idx + 1}\n                        </div>\n                        <input \n                          className=\"flex-1 text-sm font-bold border-b-2 border-slate-100 py-1 focus:outline-none focus:border-emerald-500 transition-colors\"\n                          placeholder=\"Add paragraph focus...\"\n                          value={focus}\n                          onChange={(e) => handleFieldChange(\'paragraphFocuses\', idx, e.target.value)}\n                        />\n                        <button \n                          onClick={() => handleRemoveField(\'paragraphFocuses\', idx)}\n                          className=\"text-slate-300 hover:text-red-500 transition-colors\"\n                        >\n                          <Trash2 size={20} />\n                        </button>\n                      </div>\n                    ))}\n                  </div>\n                </section>\n\n                <section className=\"bg-white border-2 border-slate-900 p-8 shadow-[6px_6px_0px_0px_rgba(15,23,42,1)]\">\n                  <div className=\"flex items-center justify-between mb-6\">\n                    <label className=\"text-[10px] font-black uppercase tracking-widest text-slate-500\">04. Concepts & Perspectives</label>\n                    <button \n                      onClick={() => handleAddField(\'concepts\')}\n                      className=\"p-2 border-2 border-slate-200 text-slate-400 hover:border-slate-900 hover:text-slate-900 transition-all\"\n                    >\n                      <Plus size={20} />\n                    </button>\n                  </div>\n                  <div className=\"flex flex-wrap gap-3 mb-8\">\n                    {formData.concepts.map((concept, idx) => (\n                      <div key={idx} className=\"flex bg-slate-900 text-white border-2 border-slate-900 items-center overflow-hidden\">\n                        <input \n                          className=\"bg-transparent px-3 py-1 text-[10px] font-black uppercase tracking-widest border-none focus:ring-0 w-32\"\n                          placeholder=\"Concept...\"\n                          value={concept}\n                          onChange={(e) => handleFieldChange(\'concepts\', idx, e.target.value)}\n                        />\n                        <button \n                          onClick={() => handleRemoveField(\'concepts\', idx)}\n                          className=\"p-1 bg-white/20 hover:bg-white/40 border-l border-white/20\"\n                        >\n                          <Trash2 size={12} />\n                        </button>\n                      </div>\n                    ))}\n                  </div>\n                  \n                  <div className=\"space-y-4\">\n                    <label className=\"text-[10px] font-black uppercase tracking-widest text-slate-400\">Targeted Multi-Conceptual Pillars</label>\n                    <div className=\"grid grid-cols-2 md:grid-cols-3 gap-3\">\n                      {GEOGRAPHIC_PILLARS.map((pillar) => (\n                        <button\n                          key={pillar.id}\n                          onClick={() => togglePillar(pillar.label)}\n                          className={cn(\n                            \"px-4 py-2 border-2 text-[10px] font-black uppercase tracking-widest transition-all\",\n                            formData.conceptualPillars.includes(pillar.label)\n                              ? \"bg-emerald-400 border-slate-900 shadow-[3px_3px_0px_0px_rgba(15,23,42,1)]\"\n                              : \"bg-white border-slate-200 text-slate-400 hover:border-slate-900 hover:text-slate-900\"\n                          )}\n                        >\n                          {pillar.label}\n                        </button>\n                      ))}\n                    </div>\n                  </div>\n                </section>\n              </div>\n\n              <div className=\"col-span-12 md:col-span-5 flex flex-col gap-8\">\n                <section className=\"bg-white border-2 border-slate-900 p-8 shadow-[6px_6px_0px_0px_rgba(15,23,42,1)]\">\n                  <label className=\"text-[10px] font-black uppercase tracking-widest text-slate-500 block mb-6\">05. Essay Framework</label>\n                  <div className=\"flex bg-slate-100 p-1 border-2 border-slate-900 mb-8\">\n                    <button \n                      onClick={() => setFormData(prev => ({ ...prev, structure: \'PEEL\' }))}\n                      className={cn(\n                        \"flex-1 py-3 text-xs font-black uppercase tracking-widest transition-all\",\n                        formData.structure === \'PEEL\' ? \"bg-slate-900 text-white\" : \"text-slate-400 hover:text-slate-900\"\n                      )}\n                    >\n                      PEEL\n                    </button>\n                    <button \n                      onClick={() => setFormData(prev => ({ ...prev, structure: \'PEECAL\' }))}\n                      className={cn(\n                        \"flex-1 py-3 text-xs font-black uppercase tracking-widest transition-all\",\n                        formData.structure === \'PEECAL\' ? \"bg-slate-900 text-white\" : \"text-slate-400 hover:text-slate-900\"\n                      )}\n                    >\n                      PEECAL\n                    </button>\n                  </div>\n\n                  <div className=\"grid grid-cols-3 gap-2\">\n                    {(formData.structure === \'PEEL\' ? [\'Point\', \'Evidence\', \'Explain\', \'Link\'] : [\'Point\', \'Evidence\', \'Explain\', \'Counter\', \'Analysis\', \'Link\']).map((label) => (\n                      <div key={label} className=\"border-2 border-slate-900 p-3 flex flex-col items-center justify-center bg-slate-50 shadow-[2px_2px_0px_0px_rgba(15,23,42,1)]\">\n                        <span className=\"text-[9px] font-black uppercase tracking-tighter text-slate-900 italic\">{label}</span>\n                      </div>\n                    ))}\n                  </div>\n                </section>\n\n                <div className=\"mt-auto flex gap-4\">\n                  <button \n                    onClick={() => setCurrentStep(\'question\')}\n                    className=\"flex-1 bg-white border-2 border-slate-900 py-4 font-black uppercase tracking-widest shadow-[4px_4px_0px_0px_rgba(15,23,42,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none\"\n                  >\n                    Back\n                  </button>\n                  <button \n                    onClick={() => setCurrentStep(\'sources\')}\n                    className=\"flex-1 bg-emerald-500 border-2 border-slate-900 py-4 font-black uppercase tracking-widest shadow-[4px_4px_0px_0px_rgba(15,23,42,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none\"\n                  >\n                    Next\n                  </button>\n                </div>\n              </div>\n            </motion.div>\n          )}"
    }
    replacement_chunks {
      target_content: "          {currentStep === \'sources\' && (\n            <motion.div \n              key=\"sources\"\n              initial={{ opacity: 0, y: 10 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -10 }}\n              className=\"space-y-8\"\n            >\n              <section className=\"space-y-6\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-10 h-10 bg-blue-50 text-blue-500 rounded-full flex items-center justify-center\">\n                    <Globe size={20} />\n                  </div>\n                  <div>\n                    <h2 className=\"text-lg font-serif italic\">Case Study & External Evidence</h2>\n                    <p className=\"text-sm text-gray-500\">Add links or upload documents to ground your essay in real-world geographic data.</p>\n                  </div>\n                </div>\n\n                <div \n                  {...getRootProps()} \n                  className={cn(\n                    \"border-2 border-dashed rounded-3xl p-12 transition-all flex flex-col items-center justify-center gap-4 cursor-pointer\",\n                    isDragActive ? \"border-[#5A5E4D] bg-[#5A5E4D]/5\" : \"border-[#E5E5E5] hover:border-[#D1D5DB] bg-white\"\n                  )}\n                >\n                  <input {...getInputProps()} />\n                  <div className=\"w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center text-gray-400\">\n                    <Upload size={32} />\n                  </div>\n                  <div className=\"text-center\">\n                    <p className=\"font-bold\">Drop files here or click to upload</p>\n                    <p className=\"text-sm text-gray-400 mt-1\">PDF, DOCX, PPT, or images of lesson notes</p>\n                  </div>\n                </div>\n\n                {formData.sources.length > 0 && (\n                  <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                    {formData.sources.map((source, idx) => (\n                      <div key={idx} className=\"bg-white border border-[#E5E5E5] rounded-xl p-4 flex items-center justify-between group\">\n                        <div className=\"flex items-center gap-3 overflow-hidden\">\n                          <div className={cn(\n                            \"w-8 h-8 rounded shrink-0 flex items-center justify-center text-white\",\n                            source.file ? \"bg-red-400\" : \"bg-blue-400\"\n                          )}>\n                            {source.file ? <FileText size={16} /> : <Globe size={16} />}\n                          </div>\n                          <span className=\"text-sm font-medium truncate\">{source.file ? source.file.name : source.url}</span>\n                        </div>\n                        <button \n                          onClick={() => setFormData(prev => ({\n                            ...prev,\n                            sources: prev.sources.filter((_, i) => i !== idx)\n                          }))}\n                          className=\"text-gray-300 hover:text-red-500 transition-colors\"\n                        >\n                          <Trash2 size={16} />\n                        </button>\n                      </div>\n                    ))}\n                  </div>\n                )}\n              </section>\n\n              <div className=\"flex justify-between items-center\">\n                <button \n                  onClick={() => setCurrentStep(\'planning\')}\n                  className=\"text-sm font-bold text-[#6B7280]\"\n                >\n                  Back to Planning\n                </button>\n                <button \n                  onClick={() => setCurrentStep(\'conclusion\')}\n                  className=\"bg-[#5A5E4D] text-white px-8 h-14 rounded-full font-bold hover:bg-[#4A4E3D] shadow-lg flex items-center gap-3\"\n                >\n                