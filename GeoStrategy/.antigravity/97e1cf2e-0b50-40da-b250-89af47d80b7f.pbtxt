    replacement_chunks {
      replacement_content: "import { GoogleGenAI } from \"@google/genai\";\nimport { fileToGenerativePart } from \"./utils\";\n\nconst ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY || \"\" });\n\nexport interface EssayInput {\n  question: string;\n  marks: \"10\" | \"12\" | \"16\";\n  keyTerms: string;\n  paragraphFocuses: string[];\n  concepts: string[];\n  structure: \"PEEL\" | \"PEECAL\";\n  sources: { url: string; file?: File }[];\n  conclusionStance: string;\n}\n\nexport async function generateEssayPlan(input: EssayInput) {\n  const model = \"gemini-3.1-pro-preview\";\n  \n  const fileParts = await Promise.all(\n    input.sources\n      .filter((s) => s.file)\n      .map((s) => fileToGenerativePart(s.file!))\n  );\n\n  const urlContext = input.sources\n    .filter((s) => s.url)\n    .map((s) => s.url)\n    .join(\", \");\n\n  const prompt = `\n    You are an expert IBDP Geography Moderator and Teacher. \n    Your task is to create a detailed ESSAY PLAN based on the student\'s manual planning inputs.\n    \n    CRITICAL: Maintain the student\'s intellectual direction. Do not write the essay for them, but provide a high-level roadmap.\n    \n    ESSAY PARAMETERS:\n    - Question: ${input.question} (${input.marks} Marks)\n    - Key Terms to Define: ${input.keyTerms}\n    - Student\'s Planned Paragraph Themes: ${input.paragraphFocuses.join(\", \")}\n    - Geographic Concepts/Perspectives to Include: ${input.concepts.join(\", \")}\n    - Framework to Use: ${input.structure} (${input.structure === \'PEEL\' ? \'Point, Evidence, Explain, Link\' : \'Point, Evidence, Explain, Counter-argument, Analysis, Link\'})\n    - Desired Conclusion Stance: ${input.conclusionStance}\n    - Additional URL Context: ${urlContext}\n    \n    REQUIREMENTS:\n    1. Structure the plan exactly according to the chosen framework (${input.structure}).\n    2. Incorporate specific case study advice if sources are provided.\n    3. Ensure the depth matches the mark scheme (${input.marks} marks).\n    4. Focus on geographic terminology and the \"Concepts\" specified.\n    \n    TONE: Academic, encouraging, and precise.\n    FORMAT: Use clear Markdown with headings and bullet points.\n  `;\n\n  const response = await ai.models.generateContent({\n    model,\n    contents: {\n      parts: [\n        ...fileParts,\n        { text: prompt }\n      ]\n    },\n  });\n\n  return response.text;\n}\n"
    }
