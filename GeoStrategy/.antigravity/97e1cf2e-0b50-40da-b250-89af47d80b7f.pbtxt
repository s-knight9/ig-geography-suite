ion}\n                      onChange={(e) => setFormData(prev => ({ ...prev, question: e.target.value }))}\n                    />\n                  </div>\n                </div>\n              </section>\n\n              <section className=\"space-y-4\">\n                <label className=\"text-xs font-bold uppercase tracking-widest text-[#6B7280]\">\n                  Definition of Key Term(s)\n                </label>\n                <textarea \n                  className=\"w-full min-h-[100px] bg-white border border-[#E5E5E5] rounded-xl p-4 focus:outline-none focus:ring-2 focus:ring-[#5A5E4D]/20 transition-all text-gray-700\"\n                  placeholder=\"Define terms you want to include in your introduction...\"\n                  value={formData.keyTerms}\n                  onChange={(e) => setFormData(prev => ({ ...prev, keyTerms: e.target.value }))}\n                />\n              </section>\n\n              <div className=\"flex justify-end\">\n                <button \n                  onClick={() => setCurrentStep(\'planning\')}\n                  className=\"bg-[#5A5E4D] text-white px-8 h-14 rounded-full font-bold hover:bg-[#4A4E3D] transition-all flex items-center gap-3 shadow-lg shadow-[#5A5E4D]/20 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed\"\n                  disabled={!formData.question}\n                >\n                  Confirm & Move to Planning <ChevronRight size={20} />\n                </button>\n              </div>\n            </motion.div>\n          )}"
