 hover:border-[#5A5E4D] hover:bg-[#5A5E4D]/5 transition-all\"\n                    >\n                      {snippet}\n                    </button>\n                  ))}\n                </div>\n              </section>\n\n              <div className=\"pt-12 border-t flex flex-col items-center gap-6\">\n                <button \n                  onClick={handleGenerate}\n                  className=\"w-full md:w-auto px-12 h-16 bg-[#5A5E4D] text-white rounded-full font-bold text-lg hover:bg-[#4A4E3D] shadow-xl shadow-[#5A5E4D]/30 flex items-center justify-center gap-4 group active:scale-95 transition-all\"\n                  disabled={!formData.conclusionStance}\n                >\n                  <Sparkles size={24} className=\"group-hover:rotate-12 transition-transform\" />\n                  Synthesize Essay Plan\n                </button>\n                <div className=\"flex items-center gap-2 text-xs text-gray-400 uppercase tracking-widest font-bold\">\n                  <AlertCircle size={14} />\n                  Requires student intellect for best results\n                </div>\n              </div>\n            </motion.div>\n          )}"
        replacement_content: "          {currentStep === \'conclusion\' && (\n            <motion.div \n              key=\"conclusion\"\n              initial={{ opacity: 0, y: 10 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -10 }}\n              className=\"grid grid-cols-12 gap-8\"\n            >\n              <div className=\"col-span-12 md:col-span-8 flex flex-col gap-6\">\n                <section className=\"bg-emerald-50 border-2 border-emerald-900 p-8 shadow-[6px_6px_0px_0px_rgba(6,78,59,1)]\">\n                  <label className=\"text-[10px] font-black uppercase tracking-widest block mb-4 text-emerald-900\">07. Conclusion Strategy</label>\n                  <p className=\"text-sm font-medium leading-relaxed text-emerald-900 opacity-80 mb-8 max-w-2xl\">\n                    Final judgment should evaluate the spatial variations and overall efficacy of geographic processes or management strategies.\n                  </p>\n                  \n                  <textarea \n                    className=\"w-full min-h-[200px] bg-white border-2 border-emerald-900 p-8 focus:outline-none placeholder:text-emerald-900/20 text-emerald-900 font-bold italic text-lg leading-relaxed shadow-[4px_4px_0px_0px_rgba(6,78,59,1)]\"\n                    placeholder=\"e.g., \'I agree to a large extent that management strategies succeed when local stakeholders are involved, however...\'\"\n                    value={formData.conclusionStance}\n                    onChange={(e) => setFormData(prev => ({ ...prev, conclusionStance: e.target.value }))}\n                  />\n\n                  <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 mt-12\">\n                    {[\'I agree to a large extent...\', \'The evidence suggests that...\', \'While globally true, locally...\'].map((snippet) => (\n                      <button \n                        key={snippet}\n                        onClick={() => setFormData(prev => ({ ...prev, conclusionStance: snippet }))}\n                        className=\"p-4 bg-white border-2 border-emerald-900 text-[10px] font-black uppercase tracking-widest hover:bg-emerald-100 transition-all text-emerald-900 shadow-[2px_2px_0px_0px_rgba(6,78,59,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none text-left\"\n                      >\n                        {snippet}\n                      </button>\n                    ))}\n                  </div>\n                </section>\n              </div>\n\n              <div className=\"col-span-12 md:col-span-4 flex flex-col justify-end gap-6\">\n                <div className=\"bg-slate-900 border-2 border-slate-900 p-6 shadow-[6px_6px_0px_0px_rgba(15,23,42,1)] text-white\">\n                  <div className=\"flex items-center gap-3 mb-4\">\n                    <GraduationCap className=\"text-emerald-400\" />\n                    <span className=\"text-[10px] font-black uppercase tracking-widest italic\">Moderator Tip</span>\n                  </div>\n                  <p className=\"text-xs leading-relaxed opacity-80\">\n                    Ensure your conclusion directly returns to the phrasing of the question. Evaluative language must be sustained.\n                  </p>\n                </div>\n\n                <button \n                  onClick={handleGenerate}\n                  className=\"w-full bg-emerald-500 text-slate-900 px-8 py-8 border-2 border-slate-900 font-black text-2xl uppercase tracking-tighter shadow-[8px_8px_0px_0px_rgba(15,23,42,1)] active:translate-x-1 active:translate-y-1 active:shadow-none transition-all flex items-center justify-center gap-4 group\"\n                  disabled={!formData.conclusionStance}\n                >\n                  <Sparkles size={32} className=\"group-hover:rotate-12 transition-transform\" />\n                  Synthesize Outline\n                </button>\n              </div>\n            </motion.div>\n          )}"
