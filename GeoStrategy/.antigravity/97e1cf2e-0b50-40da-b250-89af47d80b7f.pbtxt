      replacement_content: "    <div className=\"min-h-screen bg-slate-50 text-slate-900 font-sans selection:bg-emerald-100\">\n      {/* Header */}\n      <header class=\"flex justify-between items-end border-b-2 border-slate-900 pb-4 mb-12 max-w-7xl mx-auto px-6 pt-12\">\n        <div>\n          <h1 class=\"text-3xl font-black tracking-tighter uppercase\">GeoStrategy</h1>\n          <p class=\"text-xs font-bold tracking-widest text-slate-500 uppercase\">IBDP Geography Essay Planning Studio</p>\n        </div>\n        <div class=\"hidden md:flex flex-col items-end\">\n          <span class=\"text-[10px] font-bold uppercase text-slate-400\">Status</span>\n          <span class=\"font-mono font-bold uppercase text-emerald-600\">Architect Active</span>\n        </div>\n      </header>\n\n      <div className=\"max-w-7xl mx-auto px-6 mb-12\">\n        <div className=\"flex flex-wrap gap-4\">\n          {steps.map((step, idx) => (\n            <button \n              key={step.id} \n              onClick={() => setCurrentStep(step.id)}\n              className={cn(\n                \"px-4 py-2 border-2 transition-all flex items-center gap-2 text-xs font-black uppercase tracking-widest\",\n                currentStep === step.id \n                  ? \"bg-slate-900 text-white border-slate-900 shadow-[2px_2px_0px_0px_rgba(15,23,42,1)]\" \n                  : \"bg-white text-slate-400 border-slate-200 hover:border-slate-400\"\n              )}\n            >\n              <span className=\"opacity-50\">{idx + 1}.</span> {step.label}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      <main className=\"max-w-7xl mx-auto px-6 pb-20\">"
    }
    replacement_chunks {
      target_content: "          {currentStep === \'question\' && (\n            <motion.div \n              key=\"question\"\n              initial={{ opacity: 0, y: 10 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -10 }}\n              className=\"space-y-8\"\n            >\n              <section className=\"space-y-4\">\n                <label className=\"text-xs font-bold uppercase tracking-widest text-[#6B7280] flex items-center gap-2\">\n                  <FileText size={14} /> Essay Question\n                </label>\n                <div className=\"grid grid-cols-1 md:grid-cols-4 gap-6\">\n                  <div className=\"md:col-span-1 space-y-2\">\n                    <span className=\"text-sm font-medium\">Mark Scheme</span>\n                    <select \n                      className=\"w-full h-12 bg-white border border-[#E5E5E5] rounded-xl px-4 focus:outline-none focus:ring-2 focus:ring-[#5A5E4D]/20 transition-all font-mono\"\n                      value={formData.marks}\n                      onChange={(e) => setFormData(prev => ({ ...prev, marks: e.target.value as any }))}\n                    >\n                      <option value=\"10\">10 Marks</option>\n                      <option value=\"12\">12 Marks</option>\n                      <option value=\"16\">16 Marks</option>\n                    </select>\n                  </div>\n                  <div className=\"md:col-span-3 space-y-2\">\n                    <span className=\"text-sm font-medium\">Prompt / Question</span>\n                    <textarea \n                      className=\"w-full min-h-[120px] bg-white border border-[#E5E5E5] rounded-xl p-4 focus:outline-none focus:ring-2 focus:ring-[#5A5E4D]/20 transition-all text-lg leading-relaxed placeholder:text-gray-300\"\n                      placeholder=\"e.g., \'Examine the relationship between planetary boundaries and the circular economy.\'\"\n                      value={formData.question}\n                      onChange={(e) => setFormData(prev => ({ ...prev, question: e.target.value }))}\n                    />\n                  </div>\n                </div>\n              </section>\n\n              <section className=\"space-y-4\">\n                <label className=\"text-xs font-bold uppercase tracking-widest text-[#6B7280]\">\n                  Definition of Key Term(s)\n                </label>\n                <textarea \n                  className=\"w-full min-h-[100px] bg-white border border-[#E5E5E5] rounded-xl p-4 focus:outline-none focus:ring-2 focus:ring-[#5A5E4D]/20 transition-all text-gray-700\"\n                  placeholder=\"Define terms you want to include in your introduction...\"\n                  value={formData.keyTerms}\n                  onChange={(e) => setFormData(prev => ({ ...prev, keyTerms: e.target.value }))}\n                />\n              </section>\n\n              <div className=\"flex justify-end\">\n                <button \n                  onClick={() => setCurrentStep(\'planning\')}\n                  className=\"bg-[#5A5E4D] text-white px-8 h-14 rounded-full font-bold hover:bg-[#4A4E3D] transition-all flex items-center gap-3 shadow-lg shadow-[#5A5E4D]/20 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed\"\n                  disabled={!formData.question}\n                >\n                  Confirm & Move to Planning <ChevronRight size={20} />\n                </button>\n              </div>\n            </motion.div>\n          )}"
      replacement_content: "          {currentStep === \'question\' && (\n            <motion.div \n              key=\"question\"\n              initial={{ opacity: 0, x: -20 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: 20 }}\n              className=\"grid grid-cols-12 gap-8\"\n            >\n              <div className=\"col-span-12 md:col-span-8 flex flex-col gap-8\">\n                <section className=\"bg-white border-2 border-slate-900 p-8 shadow-[6px_6px_0px_0px_rgba(15,23,42,1)]\">\n                  <label className=\"text-[10px] font-black uppercase tracking-widest block mb-4 text-slate-500\">01. Essay Question</label>\n                  <textarea \n                    className=\"w-full min-h-[160px] text-xl font-bold border-none focus:ring-0 p-0 placeholder:text-slate-200 resize-none leading-tight\"\n                    placeholder=\"Type your essay prompt here...\"\n                    value={formData.question}\n                    onChange={(e) => setFormData(prev => ({ ...prev, question: e.target.value }))}\n                  />\n                  <div className=\"flex flex-wrap mt-8 gap-3 border-t-2 border-slate-100 pt-6\">\n                    {[\'10\', \'12\', \'16\'].map(mark => (\n                      <button \n                        key={mark}\n                        onClick={() => setFormData(prev => ({ ...prev, marks: mark as any }))}\n                        className={cn(\n                          \"px-6 py-2 text-xs font-black border-2 transition-all\",\n                          formData.marks === mark \n                            ? \"bg-emerald-400 border-slate-900 shadow-[3px_3px_0px_0px_rgba(15,23,42,1)]\" \n                            : \"bg-slate-50 border-slate-200 text-slate-400 hover:border-slate-900 hover:text-slate-900\"\n                        )}\n                      >\n                        {mark} MARKS\n                      </button>\n                    ))}\n                  </div>\n                </section>\n\n                <section className=\"bg-white border-2 border-slate-900 p-8 shadow-[6px_6px_0px_0px_rgba(15,23,42,1)]\">\n                  <label className=\"text-[10px] font-black uppercase tracking-widest block mb-4 text-slate-500\">02. Key Term Definitions</label>\n                  <textarea \n                    className=\"w-full min-h-[120px] bg-slate-50 border-2 border-slate-900 p-4 focus:outline-none placeholder:text-slate-300 font-medium italic\"\n                    placeholder=\"Add terms to define in your introduction...\"\n                    value={formData.keyTerms}\n                    onChange={(e) => setFormData(prev => ({ ...prev, keyTerms: e.target.value }))}\n                  />\n                </section>\n              </div>\n\n              <div className=\"col-span-12 md:col-span-4 flex flex-col justify-end\">\n                <button \n                  onClick={() => setCurrentStep(\'planning\')}\n                  className=\"w-full bg-emerald-500 text-slate-900 px-8 py-6 border-2 border-slate-900 font-black text-lg uppercase tracking-widest shadow-[6px_6px_0px_0px_rgba(15,23,42,1)] active:translate-x-1 active:translate-y-1 active:shadow-none transition-all flex items-center justify-center gap-4 disabled:opacity-50 disabled:grayscale\"\n                  disabled={!formData.question}\n                >\n                  Start Planning <ChevronRight size={24} />\n                </button>\n              </div>\n            </motion.div>\n          )}"
