      replacement_content: "import { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { \n  BookOpen, \n  Layout, \n  FileText, \n  MessageSquare, \n  ChevronRight, \n  Plus, \n  Trash2, \n  Upload, \n  Globe,\n  Sparkles,\n  CheckCircle2,\n  AlertCircle,\n  Clock,\n  GraduationCap\n} from \'lucide-react\';\nimport { useDropzone } from \'react-dropzone\';\nimport ReactMarkdown from \'react-markdown\';\nimport { cn } from \'./lib/utils\';\nimport { generateEssayPlan, type EssayInput } from \'./lib/gemini\';\n\ntype Step = \'question\' | \'planning\' | \'sources\' | \'conclusion\' | \'result\';\n\nexport default function App() {\n  const [currentStep, setCurrentStep] = useState<Step>(\'question\');\n  const [loading, setLoading] = useState(false);\n  const [result, setResult] = useState<string | null>(null);\n  \n  const [formData, setFormData] = useState<EssayInput>({\n    question: \'\',\n    marks: \'12\',\n    keyTerms: \'\',\n    paragraphFocuses: [\'\'],\n    concepts: [\'\'],\n    structure: \'PEEL\',\n    sources: [],\n    conclusionStance: \'\'\n  });\n\n  const handleAddField = (field: \'paragraphFocuses\' | \'concepts\') => {\n    setFormData(prev => ({\n      ...prev,\n      [field]: [...prev[field], \'\']\n    }));\n  };\n\n  const handleRemoveField = (field: \'paragraphFocuses\' | \'concepts\', index: number) => {\n    setFormData(prev => ({\n      ...prev,\n      [field]: prev[field].filter((_, i) => i !== index)\n    }));\n  };\n\n  const handleFieldChange = (field: \'paragraphFocuses\' | \'concepts\', index: number, value: string) => {\n    const newArr = [...formData[field]];\n    newArr[index] = value;\n    setFormData(prev => ({ ...prev, [field]: newArr }));\n  };\n\n  const onDrop = (acceptedFiles: File[]) => {\n    setFormData(prev => ({\n      ...prev,\n      sources: [...prev.sources, ...acceptedFiles.map(file => ({ url: \'\', file }))]\n    }));\n  };\n\n  const { getRootProps, getInputProps, isDragActive } = useDropzone({ onDrop });\n\n  const handleGenerate = async () => {\n    setLoading(true);\n    setCurrentStep(\'result\');\n    try {\n      const plan = await generateEssayPlan(formData);\n      setResult(plan || \"Failed to generate plan.\");\n    } catch (err) {\n      console.error(err);\n      setResult(\"An error occurred while generating your essay plan. Please check your AI API key and try again.\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const steps: { id: Step; label: string; icon: any }[] = [\n    { id: \'question\', label: \'Question Analysis\', icon: BookOpen },\n    { id: \'planning\', label: \'Manual Planning\', icon: Layout },\n    { id: \'sources\', label: \'Evidence & Sources\', icon: Globe },\n    { id: \'conclusion\', label: \'Final Stance\', icon: MessageSquare },\n  ];\n\n  return (\n    <div className=\"min-h-screen bg-[#FDFCFB] text-[#1A1A1A] font-sans selection:bg-[#E2E8F0]\">\n      {/* Header */}\n      <header className=\"border-b border-[#E5E5E5] bg-white sticky top-0 z-50\">\n        <div className=\"max-w-7xl mx-auto px-6 h-16 flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 bg-[#5A5E4D] rounded-lg flex items-center justify-center text-white\">\n              <GraduationCap size={24} />\n            </div>\n            <h1 className=\"font-serif italic text-xl font-medium tracking-tight\">Geography Essay Architect</h1>\n          </div>\n          <div className=\"hidden md:flex items-center gap-6\">\n            {steps.map((step, idx) => (\n              <div key={step.id} className=\"flex items-center gap-2\">\n                <div className={cn(\n                  \"w-6 h-6 rounded-full border flex items-center justify-center text-[10px] font-bold transition-all\",\n                  currentStep === step.id ? \"bg-[#5A5E4D] border-[#5A5E4D] text-white\" : \n                  steps.findIndex(s => s.id === currentStep) > idx ? \"bg-green-100 border-green-500 text-green-700\" : \"border-[#D1D5DB] text-[#6B7280]\"\n                )}>\n                  {steps.findIndex(s => s.id === currentStep) > idx ? <CheckCircle2 size={12} /> : idx + 1}\n                </div>\n                <span className={cn(\n                  \"text-xs font-medium uppercase tracking-widest\",\n                  currentStep === step.id ? \"text-[#1A1A1A]\" : \"text-[#9CA3AF]\"\n                )}>{step.label}</span>\n                {idx < steps.length - 1 && <ChevronRight size={14} className=\"text-[#D1D5DB]\" />}\n              </div>\n            ))}\n          </div>\n        </div>\n      </header>\n\n      <main className=\"max-w-5xl mx-auto px-6 py-12\">\n        <AnimatePresence mode=\"wait\">\n          {currentStep === \'question\' && (\n            <motion.div \n              key=\"question\"\n              initial={{ opacity: 0, y: 10 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -10 }}\n              className=\"space-y-8\"\n            >\n              <section className=\"space-y-4\">\n                <label className=\"text-xs font-bold uppercase tracking-widest text-[#6B7280] flex items-center gap-2\">\n                  <FileText size={14} /> Essay Question\n                </label>\n                <div className=\"grid grid-cols-1 md:grid-cols-4 gap-6\">\n                  <div className=\"md:col-span-1 space-y-2\">\n                    <span className=\"text-sm font-medium\">Mark Scheme</span>\n                    <select \n                      className=\"w-full h-12 bg-white border border-[#E5E5E5] rounded-xl px-4 focus:outline-none focus:ring-2 focus:ring-[#5A5E4D]/20 transition-all font-mono\"\n                      value={formData.marks}\n                      onChange={(e) => setFormData(prev => ({ ...prev, marks: e.target.value as any }))}\n                    >\n                      <option value=\"10\">10 Marks</option>\n                      <option value=\"12\">12 Marks</option>\n                      <option value=\"16\">16 Marks</option>\n                    </select>\n                  </div>\n                  <div className=\"md:col-span-3 space-y-2\">\n                    <span className=\"text-sm font-medium\">Prompt / Question</span>\n                    <textarea \n                      className=\"w-full min-h-[120px] bg-white border border-[#E5E5E5] rounded-xl p-4 focus:outline-none focus:ring-2 focus:ring-[#5A5E4D]/20 transition-all text-lg leading-relaxed placeholder:text-gray-300\"\n                      placeholder=\"e.g., \'Examine the relationship between planetary boundaries and the circular economy.\'\"\n                      value={formData.question}\n                      onChange={(e) => setFormData(prev => ({ ...prev, question: e.target.value }))}\n                    />\n                  </div>\n                </div>\n              </section>\n\n              <section className=\"space-y-4\">\n                <label className=\"text-xs font-bold uppercase tracking-widest text-[#6B7280]\">\n                  Definition of Key Term(s)\n                </label>\n                <textarea \n                  className=\"w-full min-h-[100px] bg-white border border-[#E5E5E5] rounded-xl p-4 focus:outline-none focus:ring-2 focus:ring-[#5A5E4D]/20 transition-all text-gray-700\"\n                  placeholder=\"Define terms you want to include in your introduction...\"\n                  value={formData.keyTerms}\n                  onChange={(e) => setFormData(prev => ({ ...prev, keyTerms: e.target.value }))}\n                />\n              </section>\n\n              <div className=\"flex justify-end\">\n                <button \n                  onClick={() => setCurrentStep(\'planning\')}\n                  className=\"bg-[#5A5E4D] text-white px-8 h-14 rounded-full font-bold hover:bg-[#4A4E3D] transition-all flex items-center gap-3 shadow-lg shadow-[#5A5E4D]/20 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed\"\n                  disabled={!formData.question}\n                >\n                  Confirm & Move to Planning <ChevronRight size={20} />\n                </button>\n              </div>\n            </motion.div>\n          )}\n\n          {currentStep === \'planning\' && (\n            <motion.div \n              key=\"planning\"\n              initial={{ opacity: 0, y: 10 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -10 }}\n              className=\"space-y-12\"\n            >\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-12\">\n                <section className=\"space-y-6\">\n                  <div className=\"flex items-center justify-between\">\n                    <label className=\"text-xs font-bold uppercase tracking-widest text-[#6B7280]\">Body Paragraph Focuses</label>\n                    <button \n                      onClick={() => handleAddField(\'paragraphFocuses\')}\n                      className=\"p-2 hover:bg-gray-100 rounded-full transition-all text-[#5A5E4D]\"\n                    >\n                      <Plus size={20} />\n                    </button>\n                  </div>\n                  <p className=\"text-xs text-[#6B7280] italic\">Identify the core geographic sub-themes for your analysis.</p>\n                  <div className=\"space-y-4\">\n                    {formData.paragraphFocuses.map((focus, idx) => (\n                      <div key={idx} className=\"flex gap-3\">\n                        <div className=\"flex-none w-10 h-12 bg-gray-100 rounded-xl flex items-center justify-center font-mono text-xs font-bold\">\n                          BP{idx + 1}\n                        </div>\n                        <input \n                          className=\"flex-1 h-12 bg-white border border-[#E5E5E5] rounded-xl px-4 focus:outline-none focus:ring-2 focus:ring-[#5A5E4D]/20 transition-all\"\n                          placeholder=\"e.g., Impact of resource extraction on local ecosystems\"\n                          value={focus}\n                          onChange={(e) => handleFieldChange(\'paragraphFocuses\', idx, e.target.value)}\n                        />\n                        <button \n                          onClick={() => handleRemoveField(\'paragraphFocuses\', idx)}\n                          className=\"p-3 text-red-300 hover:text-red-500 transition-colors\"\n                        >\n                          <Trash2 size={18} />\n                        </button>\n                      </div>\n                    ))}\n                  </div>\n                </section>\n\n                <section className=\"space-y-6\">\n                  <div className=\"flex items-center justify-between\">\n                    <label className=\"text-xs font-bold uppercase tracking-widest text-[#6B7280]\">Concepts & Perspectives</label>\n                    <button \n                      onClick={() => handleAddField(\'concepts\')}\n                      className=\"p-2 hover:bg-gray-100 rounded-full transition-all text-[#5A5E4D]\"\n                    >\n                      <Plus size={20} />\n                    </button>\n                  </div>\n                  <p className=\"text-xs text-[#6B7280] italic\">List IB Geography concepts (Scale, Sustainability, Power, etc.) or specific stakeholder perspectives.</p>\n                  <div className=\"space-y-4\">\n                    {formData.concepts.map((concept, idx) => (\n                      <div key={idx} className=\"flex gap-3\">\n                        <input \n                          className=\"flex-1 h-12 bg-[#F9FAFB] border border-[#E5E5E5] rounded-xl px-4 focus:outline-none focus:ring-2 focus:ring-[#5A5E4D]/20 transition-all font-medium\"\n                          placeholder=\"e.g., Sustainability or Malthusian Perspective\"\n                          value={concept}\n                          onChange={(e) => handleFieldChange(\'concepts\', idx, e.target.value)}\n                        />\n                        <button \n                          onClick={() => handleRemoveField(\'concepts\', idx)}\n                          className=\"p-3 text-red-300 hover:text-red-500 transition-colors\"\n                        >\n                          <Trash2 size={18} />\n                        </button>\n                      </div>\n                    ))}\n                  </div>\n                </section>\n              </div>\n\n              <section className=\"bg-white border border-[#E5E5E5] rounded-3xl p-8 space-y-6\">\n                <div className=\"flex items-center justify-between\">\n                  <div>\n                    <h3 className=\"font-serif italic text-xl font-medium\">Response Architecture</h3>\n                    <p className=\"text-sm text-[#6B7280]\">Select the standard for your evidentiary depth.</p>\n                  </div>\n                  <div className=\"flex bg-gray-100 p-1 rounded-xl\">\n                    <button \n                      onClick={() => setFormData(prev => ({ ...prev, structure: \'PEEL\' }))}\n                      className={cn(\n                        \"px-6 h-10 rounded-lg text-xs font-bold uppercase tracking-widest transition-all\",\n                        formData.structure === \'PEEL\' ? \"bg-white text-[#5A5E4D] shadow-sm\" : \"text-[#9CA3AF] hover:text-[#4B5563]\"\n                      )}\n                    >\n                      PEEL\n                    </button>\n                    <button \n                      onClick={() => setFormData(prev => ({ ...prev, structure: \'PEECAL\' }))}\n                      className={cn(\n                        \"px-6 h-10 rounded-lg text-xs font-bold uppercase tracking-widest transition-all\",\n                        formData.structure === \'PEECAL\' ? \"bg-white text-[#5A5E4D] shadow-sm\" : \"text-[#9CA3AF] hover:text-[#4B5563]\"\n                      )}\n                    >\n                      PEECAL\n                    </button>\n                  </div>\n                </div>\n\n                <div className=\"grid grid-cols-2 md:grid-cols-6 gap-2\">\n                  {(formData.structure === \'PEEL\' ? [\'Point\', \'Evidence\', \'Explain\', \'Link\'] : [\'Point\', \'Evidence\', \'Explain\', \'Counter\', \'Analysis\', \'Link\']).map((label) => (\n                    <div key={label} className=\"h-20 border border-dashed border-[#E5E5E5] rounded-xl flex flex-col items-center justify-center gap-1 bg-gray-50/50\">\n                      <span className=\"text-[10px] uppercase font-bold text-[#9CA3AF] tracking-tighter\">{label}</span>\n                      <CheckCircle2 size={16} className=\"text-[#D1D5DB]\" />\n                    </div>\n                  ))}\n                </div>\n                <div className=\"p-4 bg-[#5A5E4D]/5 rounded-xl border border-[#5A5E4D]/10 text-sm text-[#5A5E4D]/80 leading-relaxed italic\">\n                  {formData.structure === \'PEEL\' \n                    ? \"Point, Evidence, Explanation, Link: Standard for balanced analysis.\" \n                    : \"Point, Evidence, Explanation, Counter-Argument, Analysis, Link: Optimized for 16-mark evaluative essays.\"}\n                </div>\n              </section>\n\n              <div className=\"flex justify-between items-center\">\n                <button \n                  onClick={() => setCurrentStep(\'question\')}\n                  className=\"text-sm font-bold text-[#6B7280] hover:text-[#1A1A1A] transition-all\"\n                >\n                  Back to Question\n                </button>\n                <button \n                  onClick={() => setCurrentStep(\'sources\')}\n                  className=\"bg-[#5A5E4D] text-white px-8 h-14 rounded-full font-bold hover:bg-[#4A4E3D] transition-all flex items-center gap-3 shadow-lg\"\n                >\n                  Advance to Evidence <ChevronRight size={20} />\n                </button>\n              </div>\n            </motion.div>\n          )}\n\n          {currentStep === \'sources\' && (\n            <motion.div \n              key=\"sources\"\n              initial={{ opacity: 0, y: 10 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -10 }}\n              className=\"space-y-8\"\n            >\n              <section className=\"space-y-6\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-10 h-10 bg-blue-50 text-blue-500 rounded-full flex items-center justify-center\">\n                    <Globe size={20} />\n                  </div>\n                  <div>\n                    <h2 className=\"text-lg font-serif italic\">Case Study & External Evidence</h2>\n                    <p className=\"text-sm text-gray-500\">Add links or upload documents to ground your essay in real-world geographic data.</p>\n                  </div>\n                </div>\n\n                <div \n                  {...getRootProps()} \n                  className={cn(\n                    \"border-2 border-dashed rounded-3xl p-12 transition-all flex flex-col items-center justify-center gap-4 cursor-pointer\",\n                    isDragActive ? \"border-[#5A5E4D] bg-[#5A5E4D]/5\" : \"border-[#E5E5E5] hover:border-[#D1D5DB] bg-white\"\n                  )}\n                >\n                  <input {...getInputProps()} />\n                  <div className=\"w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center text-gray-400\">\n                    <Upload size={32} />\n                  </div>\n                  <div className=\"text-center\">\n                    <p className=\"font-bold\">Drop files here or click to upload</p>\n                    <p className=\"text-sm text-gray-400 mt-1\">PDF, DOCX, PPT, or images of lesson notes</p>\n                  </div>\n                </div>\n\n                {formData.sources.length > 0 && (\n                  <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                    {formData.sources.map((source, idx) => (\n                      <div key={idx} className=\"bg-white border border-[#E5E5E5] rounded-xl p-4 flex items-center justify-between group\">\n                        <div className=\"flex items-center gap-3 overflow-hidden\">\n                          <div className={cn(\n                            \"w-8 h-8 rounded shrink-0 flex items-center justify-center text-white\",\n                            source.file ? \"bg-red-400\" : \"bg-blue-400\"\n                          )}>\n                            {source.file ? <FileText size={16} /> : <Globe size={16} />}\n                          </div>\n                          <span className=\"text-sm font-medium truncate\">{source.file ? source.file.name : source.url}</span>\n                        </div>\n                        <button \n                          onClick={() => setFormData(prev => ({\n                            ...prev,\n                            sources: prev.sources.filter((_, i) => i !== idx)\n                          }))}\n                          className=\"text-gray-300 hover:text-red-500 transition-colors\"\n                        >\n                          <Trash2 size={16} />\n                        </button>\n                      </div>\n                    ))}\n                  </div>\n                )}\n              </section>\n\n              <div className=\"flex justify-between items-center\">\n                <button \n                  onClick={() => setCurrentStep(\'planning\')}\n                  className=\"text-sm font-bold text-[#6B7280]\"\n                >\n                  Back to Planning\n                </button>\n                <button \n                  onClick={() => setCurrentStep(\'conclusion\')}\n                  className=\"bg-[#5A5E4D] text-white px-8 h-14 rounded-full font-bold hover:bg-[#4A4E3D] shadow-lg flex items-center gap-3\"\n                >\n                  Set Conclusion Stance <ChevronRight size={20} />\n                </button>\n              </div>\n            </motion.div>\n          )}\n\n          {currentStep === \'conclusion\' && (\n            <motion.div \n              key=\"conclusion\"\n              initial={{ opacity: 0, y: 10 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -10 }}\n              className=\"space-y-8\"\n            >\n              <section className=\"space-y-4\">\n                <div className=\"flex flex-col gap-2\">\n                  <label className=\"text-xs font-bold uppercase tracking-widest text-[#6B7280]\">Evaluating the Proposition</label>\n                  <h2 className=\"text-2xl font-serif italic text-[#1A1A1A]\">How should your essay conclude?</h2>\n                  <p className=\"text-sm text-gray-500 max-w-2xl\">Geography essays require a clear, justified conclusion. Set the \"direction of travel\" for your final judgment.</p>\n                </div>\n                \n                <textarea \n                  className=\"w-full min-h-[160px] bg-white border border-[#E5E5E5] rounded-3xl p-8 focus:outline-none focus:ring-2 focus:ring-[#5A5E4D]/20 transition-all text-xl font-serif italic leading-relaxed\"\n                  placeholder=\"e.g., \'I agree to a large extent that planetary boundaries are being significantly exceeded, though national policies vary in efficacy...\'\"\n                  value={formData.conclusionStance}\n                  onChange={(e) => setFormData(prev => ({ ...prev, conclusionStance: e.target.value }))}\n                />\n\n                <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 mt-6\">\n                  {[\'I agree to a large extent...\', \'The evidence suggests that...\', \'While globally true, locally...\'].map((snippet) => (\n                    <button \n                      key={snippet}\n                      onClick={() => setFormData(prev => ({ ...prev, conclusionStance: snippet }))}\n                      className=\"h-14 border border-[#E5E5E5] rounded-2xl px-4 text-left text-sm hover:border-[#5A5E4D] hover:bg-[#5A5E4D]/5 transition-all\"\n                    >\n                      {snippet}\n                    </button>\n                  ))}\n                </div>\n              </section>\n\n              <div className=\"pt-12 border-t flex flex-col items-center gap-6\">\n                <button \n                  onClick={handleGenerate}\n                  className=\"w-full md:w-auto px-12 h-16 bg-[#5A5E4D] text-white rounded-full font-bold text-lg hover:bg-[#4A4E3D] shadow-xl shadow-[#5A5E4D]/30 flex items-center justify-center gap-4 group active:scale-95 transition-all\"\n                  disabled={!formData.conclusionStance}\n                >\n                  <Sparkles size={24} className=\"group-hover:rotate-12 transition-transform\" />\n                  Synthesize Essay Plan\n                </button>\n                <div className=\"flex items-center gap-2 text-xs text-gray-400 uppercase tracking-widest font-bold\">\n                  <AlertCircle size={14} />\n                  Requires student intellect for best results\n                </div>\n              </div>\n            </motion.div>\n          )}\n\n          {currentStep === \'result\' && (\n            <motion.div \n              key=\"result\"\n              initial={{ opacity: 0, scale: 0.98 }}\n              animate={{ opacity: 1, scale: 1 }}\n              className=\"space-y-6\"\n            >\n              {loading ? (\n                <div className=\"flex flex-col items-center justify-center py-20 gap-6\">\n                  <div className=\"w-16 h-16 border-4 border-[#5A5E4D]/20 border-t-[#5A5E4D] rounded-full animate-spin\" />\n                  <div className=\"text-center space-y-2\">\n                    <h3 className=\"font-serif italic text-xl\">Architecting your plan...</h3>\n                    <p className=\"text-sm text-gray-500 font-mono tracking-widest animate-pulse\">EVALUATING CASE STUDIES | FRAMING ARGUMENTS</p>\n                  </div>\n                </div>\n              ) : (\n                <div className=\"bg-white border border-[#E5E5E5] rounded-[2rem] overflow-hidden shadow-2xl\">\n                  <div className=\"bg-[#5A5E4D] px-8 py-6 flex items-center justify-between text-white\">\n                    <div className=\"flex items-center gap-4\">\n                      <div className=\"bg-white/10 p-2 rounded-lg\">\n                        <CheckCircle2 size={24} />\n                      </div>\n                      <div>\n                        <h2 className=\"text-lg font-serif italic leading-tight\">Structured Essay Roadmap</h2>\n                        <div className=\"flex items-center gap-3 text-[10px] font-bold uppercase tracking-widest opacity-70\">\n                          <span>{formData.marks} Marks Target</span>\n                          <span className=\"w-1 h-1 bg-white rounded-full\" />\n                          <span>{formData.structure} Framework</span>\n                        </div>\n                      </div>\n                    </div>\n                    <button \n                      onClick={() => window.print()}\n                      className=\"bg-white/10 hover:bg-white/20 p-3 rounded-full transition-all\"\n                    >\n                      <Upload size={20} />\n                    </button>\n                  </div>\n                  \n                  <div className=\"p-8 md:p-12 prose prose-stone max-w-none prose-headings:font-serif prose-headings:italic prose-a:text-[#5A5E4D] leading-relaxed\">\n                    <ReactMarkdown>{result || \"\"}</ReactMarkdown>\n                  </div>\n\n                  <div className=\"border-t border-[#E5E5E5] bg-gray-50 p-8 flex flex-col md:flex-row items-center justify-between gap-6\">\n                    <div className=\"flex items-center gap-3 text-sm text-gray-500\">\n                      <Clock size={16} />\n                      Generated at {new Date().toLocaleTimeString()}\n                    </div>\n                    <button \n                      onClick={() => {\n                        setResult(null);\n                        setCurrentStep(\'question\');\n                      }}\n                      className=\"border border-[#D1D5DB] px-8 h-12 rounded-full font-bold hover:bg-white transition-all text-sm\"\n                    >\n                      Start New Architect\n                    </button>\n                  </div>\n                </div>\n              )}\n            </motion.div>\n          )}\n        </AnimatePresence>\n      </main>\n\n      {/* Footer Branding */}\n      <footer className=\"mt-20 pb-12 text-center space-y-4\">\n        <div className=\"h-px bg-gradient-to-r from-transparent via-[#E5E5E5] to-transparent max-w-md mx-auto\" />\n        <div className=\"text-[10px] font-bold uppercase tracking-[0.2em] text-[#9CA3AF]\">\n          Powered by Gemini 3.1 Pro & Student Faculty\n        </div>\n      </footer>\n    </div>\n  );\n}\n"
    }
    diff {
      end_line: 8
      unified_diff {
        lines {
          text: "/**"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: " * @license"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: " * SPDX-License-Identifier: Apache-2.0"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: " */"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "import { useState } from \'react\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import { motion, AnimatePresence } from \'motion/react\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import { "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  BookOpen, "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Layout, "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  FileText, "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  MessageSquare, "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ChevronRight, "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Plus, "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Trash2, "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Upload, "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Globe,"
