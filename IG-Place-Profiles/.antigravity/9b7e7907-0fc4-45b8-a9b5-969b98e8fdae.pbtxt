    instruction: "Fix the \'no males\' and layout issues with the Population pyramid chart and domain bounds"
    replacement_infos {
      original_chunk {
        target_content: "import { useMemo } from \"react\";\nimport { DPPlaceProfile } from \"../../types\";\nimport { Card, CardContent, CardHeader, CardTitle, Badge } from \"../ui\";\nimport { BarChart, Bar, XAxis, YAxis, Tooltip, ResponsiveContainer, ReferenceLine } from \"recharts\";\n\nexport function PopulationTab({ data, currentYear, countryName }: { data: DPPlaceProfile[\"population_dynamics_time_series\"], currentYear: number, countryName: string }) {\n  \n  // Find closest year node\n  const activeNode = useMemo(() => {\n    return data.reduce((prev, curr) => \n      Math.abs(curr.year - currentYear) < Math.abs(prev.year - currentYear) ? curr : prev\n    );\n  }, [data, currentYear]);\n\n  // Format pyramid data (Male becomes negative for diverging stacked bar chart)\n  const pyramidData = useMemo(() => {\n    return [...activeNode.pyramid_structure.cohorts].reverse().map(c => ({\n      age: c.age,\n      male: -c.male_pct,\n      female: c.female_pct,\n      // Keep real value for tooltip\n      maleLabel: c.male_pct,\n      femaleLabel: c.female_pct\n    }));\n  }, [activeNode]);\n\n  // Max density for choropleth opacity scaling\n  const maxDensity = useMemo(() => {\n    return Math.max(...activeNode.sub_national_density_choropleth.map(r => r.density_per_km2));\n  }, [activeNode]);\n\n  return (\n    <div className=\"animate-in fade-in duration-500 flex flex-col gap-6\">\n      \n      <div className=\"p-4 bg-indigo-50 border border-indigo-100 rounded-lg text-indigo-900\">\n        <h3 className=\"text-[10px] font-black uppercase tracking-tighter text-indigo-500 mb-1\">Synoptic Analysis Matrix \342\200\242 {activeNode.year}</h3>\n        <p className=\"text-sm font-medium leading-relaxed\">{activeNode.synoptic_analysis}</p>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch\">\n        {/* Left Pane: Pyramid */}\n        <Card className=\"flex flex-col\">\n          <CardHeader className=\"pb-0\">\n            <div className=\"flex justify-between items-center\">\n              <CardTitle>Demographic Pyramid ({activeNode.year})</CardTitle>\n              <a \n                href={`https://www.populationpyramid.net/${countryName.replace(/\\s+/g, \'-\').toLowerCase()}/${activeNode.year}/`} \n                target=\"_blank\" \n                rel=\"noreferrer\" \n                className=\"text-[10px] font-bold tracking-wider px-2 py-1 bg-indigo-50 text-indigo-600 rounded hover:bg-indigo-100 transition-colors\"\n                title={`View ${countryName} on PopulationPyramid.net`}\n              >\n                View Base Data\n              </a>\n            </div>\n            <div className=\"flex justify-between text-[10px] font-bold uppercase tracking-wider text-slate-500 pt-2\">\n              <span className=\"text-indigo-600\">Male (%)</span>\n              <span className=\"text-pink-600\">Female (%)</span>\n            </div>\n          </CardHeader>\n          <CardContent className=\"flex-1 w-full mt-4 min-h-[400px]\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <BarChart layout=\"vertical\" data={pyramidData} barCategoryGap={1} stackOffset=\"sign\">\n                {/* Domain hardcoded to -10 to 10 for percentages to keep scales locked across years */}\n                <XAxis \n                  type=\"number\" \n                  domain={[-10, 10]} \n                  tickFormatter={(val) => Math.abs(val) + \"%\"} \n                  tick={{ fontSize: 10 }}\n                  axisLine={false}\n                  tickLine={false}\n                />\n                <YAxis \n                  dataKey=\"age\" \n                  type=\"category\" \n                  axisLine={false} \n                  tickLine={false} \n                  tick={{ fontSize: 10, fill: \'#64748b\' }} \n                  width={40}\n                  interval={0}\n                />\n                <Tooltip \n                  cursor={{fill: \'#f1f5f9\'}}\n                  formatter={(value: number, name: string) => [\n                    `${Math.abs(value).toFixed(1)}%`, \n                    name.charAt(0).toUpperCase() + name.slice(1)\n                  ]}\n                  labelStyle={{ color: \'#0f172a\', fontWeight: \'bold\' }}\n                />\n                <ReferenceLine x={0} stroke=\"#cbd5e1\" />\n                <Bar dataKey=\"male\" fill=\"#4f46e5\" stackId=\"stack\" isAnimationActive={false} />\n                <Bar dataKey=\"female\" fill=\"#ec4899\" stackId=\"stack\" isAnimationActive={false} />\n              </BarChart>\n            </ResponsiveContainer>\n          </CardContent>\n        </Card>\n\n        {/* Right Pane: Choropleth Abstraction */}\n        <Card className=\"flex flex-col\">\n          <CardHeader>\n            <CardTitle>Admin-1 Spatial Density ({activeNode.year})</CardTitle>\n          </CardHeader>\n          <CardContent className=\"flex-1\">\n            <div className=\"grid grid-cols-2 gap-3 h-full\">\n              {activeNode.sub_national_density_choropleth.map((region, idx) => {\n                // Calculate opacity between 0.1 and 1.0 based on relative density\n                const opacity = Math.max(0.1, region.density_per_km2 / maxDensity);\n                \n                return (\n                  <div \n                    key={idx} \n                    className=\"relative rounded overflow-hidden flex flex-col justify-end p-3 transition-colors duration-500 border border-slate-200\"\n                  >\n                    {/* Thematic Background Layer */}\n                    <div \n                      className=\"absolute inset-0 bg-slate-900 transition-opacity duration-500\" \n                      style={{ opacity }} \n                    />\n                    \n                    {/* Content Layer */}\n                    <div className=\"relative z-10\">\n                      <div className={`font-semibold text-sm ${opacity > 0.5 ? \'text-white\' : \'text-slate-900\'}`}>\n                        {region.admin_1_region_name}\n                      </div>\n                      <div className={`text-xs font-mono mt-1 ${opacity > 0.5 ? \'text-slate-300\' : \'text-slate-500\'}`}>\n                        {region.density_per_km2.toLocaleString()} / km\302\262\n                      </div>\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          </CardContent>\n        </Card>\n      </div>\n\n    </div>\n  );\n}"
        replacement_content: "import { useMemo } from \"react\";\nimport { DPPlaceProfile } from \"../../types\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"../ui\";\nimport { BarChart, Bar, XAxis, YAxis, Tooltip, ResponsiveContainer, ReferenceLine } from \"recharts\";\n\nexport function PopulationTab({ data, currentYear, countryName }: { data: DPPlaceProfile[\"population_dynamics_time_series\"], currentYear: number, countryName: string }) {\n  \n  // Find closest year node\n  const activeNode = useMemo(() => {\n    return data.reduce((prev, curr) => \n      Math.abs(curr.year - currentYear) < Math.abs(prev.year - currentYear) ? curr : prev\n    );\n  }, [data, currentYear]);\n\n  // Format pyramid data (Male becomes negative for diverging stacked bar chart)\n  const pyramidData = useMemo(() => {\n    // Note: Recharts maps index 0 to the bottom of the Y-axis if not reversed? \n    // Wait, let\'s ensure 0-4 is at the bottom by NOT reversing it. If it renders wrong, we can reverse it.\n    // Actually, Recharts category vertical axis maps index 0 to the TOP. So we must REVERSE it to have 0-4 at the bottom.\n    // But since the user complained it was upside down after our previous reverse, let\'s remove the reverse.\n    return activeNode.pyramid_structure.cohorts.map(c => ({\n      age: c.age,\n      male: -(c.male_pct || 0),\n      female: (c.female_pct || 0),\n      maleLabel: c.male_pct,\n      femaleLabel: c.female_pct\n    }));\n  }, [activeNode]);\n\n  // Max density for choropleth opacity scaling\n  const maxDensity = useMemo(() => {\n    if (!activeNode.sub_national_density_choropleth || activeNode.sub_national_density_choropleth.length === 0) return 1;\n    return Math.max(...activeNode.sub_national_density_choropleth.map(r => r.density_per_km2));\n  }, [activeNode]);\n\n  return (\n    <div className=\"animate-in fade-in duration-500 flex flex-col gap-6\">\n      \n      <div className=\"p-4 bg-indigo-50 border border-indigo-100 rounded-lg text-indigo-900\">\n        <h3 className=\"text-[10px] font-black uppercase tracking-tighter text-indigo-500 mb-1\">Synoptic Analysis Matrix \342\200\242 {activeNode.year}</h3>\n        <p className=\"text-sm font-medium leading-relaxed\">{activeNode.synoptic_analysis}</p>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch\">\n        {/* Left Pane: Pyramid */}\n        <Card className=\"flex flex-col\">\n          <CardHeader className=\"pb-0\">\n            <div className=\"flex justify-between items-center\">\n              <CardTitle>Demographic Pyramid ({activeNode.year})</CardTitle>\n              <a \n                href={`https://www.populationpyramid.net/${countryName.replace(/\\s+/g, \'-\').toLowerCase()}/${activeNode.year}/`} \n                target=\"_blank\" \n                rel=\"noreferrer\" \n                className=\"text-[10px] font-bold tracking-wider px-2 py-1 bg-indigo-50 text-indigo-600 rounded hover:bg-indigo-100 transition-colors\"\n                title={`View ${countryName} on PopulationPyramid.net`}\n              >\n                View Base Data\n              </a>\n            </div>\n            <div className=\"flex justify-between text-[10px] font-bold uppercase tracking-wider text-slate-500 pt-2\">\n              <span className=\"text-indigo-600\">Male (%)</span>\n              <span className=\"text-pink-600\">Female (%)</span>\n            </div>\n          </CardHeader>\n          <CardContent className=\"flex-1 w-full mt-4 min-h-[400px]\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              {/* stackOffset=\"sign\" removed to fix male disappearance issues, stackId same merges them on 0 correctly */}\n              <BarChart layout=\"vertical\" data={pyramidData} barCategoryGap={1}>\n                {/* Expand domain to [-20, 20] to ensure high-population cohorts (like 17%) aren\'t clipped */}\n                <XAxis \n                  type=\"number\" \n                  domain={[-20, 20]} \n                  tickFormatter={(val) => Math.abs(val) + \"%\"} \n                  tick={{ fontSize: 10 }}\n                  axisLine={false}\n                  tickLine={false}\n                />\n                <YAxis \n                  dataKey=\"age\" \n                  type=\"category\" \n                  axisLine={false} \n                  tickLine={false} \n                  tick={{ fontSize: 10, fill: \'#64748b\' }} \n                  width={40}\n                  interval={0}\n                />\n                <Tooltip \n                  cursor={{fill: \'#f1f5f9\'}}\n                  formatter={(value: number, name: string, props: any) => {\n                    const rawValue = name === \'male\' ? props.payload.maleLabel : props.payload.femaleLabel;\n                    return [`${Number(rawValue || 0).toFixed(1)}%`, name.charAt(0).toUpperCase() + name.slice(1)];\n                  }}\n                  labelStyle={{ color: \'#0f172a\', fontWeight: \'bold\' }}\n                />\n                <ReferenceLine x={0} stroke=\"#cbd5e1\" />\n                <Bar dataKey=\"male\" fill=\"#4f46e5\" stackId=\"stack\" isAnimationActive={false} />\n                <Bar dataKey=\"female\" fill=\"#ec4899\" stackId=\"stack\" isAnimationActive={false} />\n              </BarChart>\n            </ResponsiveContainer>\n          </CardContent>\n        </Card>\n\n        {/* Right Pane: Choropleth Abstraction */}\n        <Card className=\"flex flex-col\">\n          <CardHeader>\n            <CardTitle>Admin-1 Spatial Density ({activeNode.year})</CardTitle>\n          </CardHeader>\n          <CardContent className=\"flex-1\">\n            <div className=\"grid grid-cols-2 gap-3 h-full\">\n              {(activeNode.sub_national_density_choropleth || []).map((region, idx) => {\n                const opacity = Math.max(0.1, region.density_per_km2 / maxDensity);\n                return (\n                  <div \n                    key={idx} \n                    className=\"relative rounded overflow-hidden flex flex-col justify-end p-3 transition-colors duration-500 border border-slate-200\"\n                  >\n                    <div \n                      className=\"absolute inset-0 bg-slate-900 transition-opacity duration-500\" \n                      style={{ opacity }} \n                    />\n                    <div className=\"relative z-10\">\n                      <div className={`font-semibold text-sm ${opacity > 0.5 ? \'text-white\' : \'text-slate-900\'}`}>\n                        {region.admin_1_region_name}\n                      </div>\n                      <div className={`text-xs font-mono mt-1 ${opacity > 0.5 ? \'text-slate-300\' : \'text-slate-500\'}`}>\n                        {region.density_per_km2.toLocaleString()} / km\302\262\n                      </div>\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          </CardContent>\n        </Card>\n      </div>\n\n    </div>\n  );\n}"
      }
      num_matches: 1
    }
  }
}
