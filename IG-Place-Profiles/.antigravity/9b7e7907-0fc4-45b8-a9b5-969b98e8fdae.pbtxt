      replacement_content: "import fs from \'fs\';\n\nconst countries = [\n  \"united-states-of-america\", \"china\", \"chad\", \"niger\", \"nigeria\",\n  \"united-kingdom\", \"tuvalu\", \"switzerland\", \"ethiopia\", \"sudan\",\n  \"australia\", \"germany\", \"mexico\", \"brazil\", \"democratic-republic-of-the-congo\", \"bangladesh\"\n];\n\nconst getCountryId = async (slug) => {\n  try {\n    const res = await fetch(`https://populationpyramid.net/${slug}/2026/`);\n    const text = await res.text();\n    const match = text.match(/countryId\\s*=\\s*(\\d+)/);\n    return match ? match[1] : null;\n  } catch(e) {\n    return null;\n  }\n};\n\nconst main = async () => {\n  const map = {};\n  for(const c of countries) {\n    const id = await getCountryId(c);\n    map[c] = id;\n    console.log(c, id);\n  }\n  fs.writeFileSync(\'country_map.json\', JSON.stringify(map, null, 2));\n}\n\nmain();"
