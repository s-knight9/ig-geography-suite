  file_change {
    absolute_path_uri: "file:///src/components/tabs/HumanGeographyTab.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { DPPlaceProfile } from \"../../types\";\nimport { Card, CardContent, CardHeader, CardTitle, Badge } from \"../ui\";\nimport { MapPin, PlaneTakeoff, Network } from \"lucide-react\";\n\nexport function HumanGeographyTab({ data }: { data: DPPlaceProfile[\"human_geography_tab\"] }) {\n  const { spatial_hubs, political_economy } = data;\n\n  return (\n    <div className=\"space-y-6 animate-in fade-in duration-500\">\n      \n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        <Card className=\"lg:col-span-2\">\n          <CardHeader>\n            <CardTitle className=\"flex items-center gap-2\">\n              <MapPin className=\"w-5 h-5 text-blue-600\" />\n              Special Economic & Export Processing Zones\n            </CardTitle>\n          </CardHeader>\n          <CardContent>\n            <div className=\"grid sm:grid-cols-2 gap-4\">\n              {spatial_hubs.epz_sez_zones.map((zone, idx) => (\n                <div key={idx} className=\"p-4 border border-slate-100 rounded-lg bg-slate-50 flex flex-col justify-between\">\n                  <div>\n                    <h4 className=\"font-semibold text-slate-900\">{zone.name}</h4>\n                    <p className=\"text-xs font-mono text-slate-500 mt-1\">{zone.location_lat_long}</p>\n                  </div>\n                  <div className=\"mt-3 text-sm text-slate-700\">\n                    <span className=\"font-medium mr-1 border-b border-blue-200 pb-0.5\">Focus:</span> \n                    {zone.primary_focus}\n                  </div>\n                </div>\n              ))}\n            </div>\n          </CardContent>\n        </Card>\n\n        <Card>\n          <CardHeader>\n            <CardTitle className=\"flex items-center gap-2\">\n              <Network className=\"w-5 h-5 text-blue-600\" />\n              Core-Periphery Dynamics\n            </CardTitle>\n          </CardHeader>\n          <CardContent className=\"space-y-4\">\n            <div>\n              <Label badge=\"Core\" color=\"bg-slate-900\" />\n              <p className=\"text-sm mt-1.5 font-medium\">{spatial_hubs.core_periphery_zones.core}</p>\n            </div>\n            <div className=\"pt-2 border-t\">\n              <Label badge=\"Periphery\" color=\"bg-slate-400\" />\n              <p className=\"text-sm mt-1.5 text-slate-600\">{spatial_hubs.core_periphery_zones.periphery}</p>\n            </div>\n          </CardContent>\n        </Card>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        <Card>\n          <CardHeader>\n            <CardTitle className=\"flex items-center gap-2\">\n              <PlaneTakeoff className=\"w-5 h-5 text-blue-600\" />\n              Mass Tourism Enclaves\n            </CardTitle>\n          </CardHeader>\n          <CardContent>\n            <ul className=\"space-y-4\">\n              {spatial_hubs.tourism_enclaves.map((t, idx) => (\n                <li key={idx} className=\"flex flex-col space-y-1\">\n                  <span className=\"font-semibold text-slate-900\">{t.name}</span>\n                  <span className=\"text-sm text-slate-600 leading-relaxed\">{t.spatial_impact}</span>\n                </li>\n              ))}\n            </ul>\n          </CardContent>\n        </Card>\n\n        <Card className=\"bg-slate-950 text-slate-100 border-none shadow-xl\">\n          <CardHeader>\n            <CardTitle className=\"text-white\">Political Economy Ledger</CardTitle>\n          </CardHeader>\n          <CardContent>\n            <div className=\"grid grid-cols-2 gap-x-8 gap-y-6\">\n              <div>\n                <div className=\"text-xs text-slate-400 uppercase font-bold tracking-wider mb-1\">Informal Economy</div>\n                <div className=\"text-2xl font-mono text-amber-400\">{political_economy.informal_economy_pct_gdp}% <span className=\"text-sm text-slate-500\">of GDP</span></div>\n              </div>\n              <div>\n                <div className=\"text-xs text-slate-400 uppercase font-bold tracking-wider mb-1\">EIU Classification</div>\n                <div className=\"text-lg font-medium tracking-tight text-slate-200\">{political_economy.eiu_governance_type}</div>\n              </div>\n              <div>\n                <div className=\"text-xs text-slate-400 uppercase font-bold tracking-wider mb-1\">Freedom House</div>\n                <div className=\"text-lg font-medium tracking-tight\">{political_economy.freedom_house_status}</div>\n              </div>\n              <div>\n                <div className=\"text-xs text-slate-400 uppercase font-bold tracking-wider mb-1\">Corruption (CPI)</div>\n                <div className=\"flex items-end gap-2\">\n                  <span className=\"text-2xl font-mono text-red-400\">{political_economy.corruption_perceptions_index.score}</span>\n                  <span className=\"text-sm text-slate-500 mb-1\">Rank #{political_economy.corruption_perceptions_index.rank}</span>\n                </div>\n              </div>\n            </div>\n          </CardContent>\n        </Card>\n      </div>\n\n    </div>\n  );\n}\n\nfunction Label({ badge, color }: { badge: string, color: string }) {\n  return (\n    <span className={`inline-flex items-center px-2 py-0.5 rounded text-xs font-bold text-white ${color}`}>\n      {badge}\n    </span>\n  );\n}"
    }
