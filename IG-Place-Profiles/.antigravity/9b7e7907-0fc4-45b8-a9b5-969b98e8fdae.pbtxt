    replacement_chunks {
      target_content: "import { useState } from \"react\";\nimport { Globe, TrendingUp, Users, Map, Link2 } from \"lucide-react\";\nimport { bangladeshProfile, chinaProfile, nigeriaProfile } from \"./data\";\n\nimport { GlobalisationTab } from \"./components/tabs/GlobalisationTab\";\nimport { EconomyTab } from \"./components/tabs/EconomyTab\";\nimport { HumanGeographyTab } from \"./components/tabs/HumanGeographyTab\";\nimport { PhysicalLayerTab } from \"./components/tabs/PhysicalLayerTab\";\nimport { PopulationTab } from \"./components/tabs/PopulationTab\";\n\ntype TabId = \'globalisation\' | \'economy\' | \'human_geography\' | \'physical_layer\' | \'population\';\n\nconst profiles: Record<string, typeof bangladeshProfile> = {\n  bangladesh: bangladeshProfile,\n  china: chinaProfile,\n  nigeria: nigeriaProfile\n};\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<TabId>(\'globalisation\');\n  const [sliderYear, setSliderYear] = useState<number>(2026);\n  const [selectedCountry, setSelectedCountry] = useState<string>(\'bangladesh\');\n  \n  const data = profiles[selectedCountry];\n\n  const tabs: { id: TabId, label: string, icon: React.ReactNode }[] = [\n    { id: \'globalisation\', label: \'Globalisation\', icon: <Globe className=\"w-4 h-4 mr-2\" /> },\n    { id: \'economy\', label: \'Economy\', icon: <TrendingUp className=\"w-4 h-4 mr-2\" /> },\n    { id: \'human_geography\', label: \'Human Geography\', icon: <Link2 className=\"w-4 h-4 mr-2\" /> },\n    { id: \'physical_layer\', label: \'Physical Layer\', icon: <Map className=\"w-4 h-4 mr-2\" /> },\n    { id: \'population\', label: \'Population Dynamics\', icon: <Users className=\"w-4 h-4 mr-2\" /> },\n  ];\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900 font-sans selection:bg-indigo-100 selection:text-indigo-900\">\n      \n      {/* Top Header / Nav */}\n      <header className=\"sticky top-0 z-40 bg-white border-b border-slate-200 shadow-sm\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"flex flex-col md:flex-row md:items-center justify-between py-4 gap-4\">\n            \n            {/* Branding / Dropdown */}\n            <div className=\"flex items-center gap-4\">\n              <div className=\"bg-indigo-600 text-white font-bold px-2 py-1.5 rounded-md text-sm\">\n                DP\n              </div>\n              <div className=\"hidden sm:block\">\n                <h1 className=\"text-lg font-bold leading-tight uppercase tracking-wider text-slate-800\">Place Profiles</h1>\n                <p className=\"text-xs text-slate-500 font-medium\">IB Geography Case-Study Analysis</p>\n              </div>\n              <select \n                value={selectedCountry}\n                onChange={(e) => setSelectedCountry(e.target.value)}\n                className=\"bg-slate-100 border-none text-slate-800 text-sm font-semibold rounded-md px-3 py-1.5 focus:ring-2 focus:ring-indigo-500 outline-none cursor-pointer border border-slate-300 ml-4\"\n              >\n                <option value=\"bangladesh\">Bangladesh</option>\n                <option value=\"china\">China</option>\n                <option value=\"nigeria\">Nigeria</option>\n              </select>\n              <div className=\"hidden sm:flex text-xs font-medium text-slate-500 divide-x divide-slate-300\">\n                <span className=\"pr-3\">{data.country_metadata.income_classification}</span>\n                <span className=\"px-3\">HDI Rank #{data.country_metadata.hdi.rank}</span>\n                <span className=\"pl-3\">${data.country_metadata.gni_per_capita_atlas.value_usd} GNI/c</span>\n              </div>\n            </div>\n\n            {/* Global Timeline Slider (Only impacts Population Tab for now, but in header as global state) */}\n            <div className=\"flex items-center gap-4 bg-slate-50 px-5 py-2.5 rounded-lg border border-slate-200 shadow-sm\">\n              <span className=\"text-[10px] font-black text-slate-400 uppercase tracking-tighter\">Timeline</span>\n              <input \n                type=\"range\" \n                min=\"1990\" \n                max=\"2026\" \n                step=\"36\" // Simplified to 2 steps for this mock: 1990 and 2026\n                value={sliderYear}\n                onChange={(e) => setSliderYear(parseInt(e.target.value))}\n                className=\"w-32 md:w-48 h-1.5 bg-slate-300 rounded-lg appearance-none cursor-pointer accent-indigo-600\"\n              />\n              <span className=\"text-sm font-mono font-bold text-indigo-700 w-10 text-right\">{sliderYear}</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Tab Navigation */}\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 overflow-x-auto hide-scrollbar\">\n          <nav className=\"flex space-x-1\" aria-label=\"Tabs\">\n            {tabs.map((tab) => (\n              <button\n                key={tab.id}\n                onClick={() => setActiveTab(tab.id)}\n                className={`\n                  flex items-center px-4 py-3 text-xs font-bold uppercase tracking-widest border-b-2 transition-colors whitespace-nowrap\n                  ${activeTab === tab.id \n                    ? \"border-indigo-600 text-indigo-600 bg-indigo-50/50\" \n                    : \"border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300\"}\n                `}\n              >\n                {tab.icon}\n                {tab.label}\n              </button>\n            ))}\n          </nav>\n        </div>\n      </header>\n\n      {/* Main Content Area */}\n      <main className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8\">\n        {activeTab === \'globalisation\' && <GlobalisationTab data={data.globalisation_tab} />}\n        {activeTab === \'economy\' && <EconomyTab data={data.economy_tab} />}\n        {activeTab === \'human_geography\' && <HumanGeographyTab data={data.human_geography_tab} />}\n        {activeTab === \'physical_layer\' && <PhysicalLayerTab data={data.prisoners_of_geography_map} />}\n        {activeTab === \'population\' && <PopulationTab data={data.population_dynamics_time_series} currentYear={sliderYear} countryName={data.country_metadata.name} />}\n      </main>\n\n    </div>\n  );\n}"
      replacement_content: "import { useState, useEffect } from \"react\";\nimport { Globe, TrendingUp, Users, Map, Link2, Loader2 } from \"lucide-react\";\nimport type { DPPlaceProfile } from \"./types\";\n\nimport { GlobalisationTab } from \"./components/tabs/GlobalisationTab\";\nimport { EconomyTab } from \"./components/tabs/EconomyTab\";\nimport { HumanGeographyTab } from \"./components/tabs/HumanGeographyTab\";\nimport { PhysicalLayerTab } from \"./components/tabs/PhysicalLayerTab\";\nimport { PopulationTab } from \"./components/tabs/PopulationTab\";\n\ntype TabId = \'globalisation\' | \'economy\' | \'human_geography\' | \'physical_layer\' | \'population\';\n\nconst availableCountries = [\n  { id: \'bangladesh\', name: \'Bangladesh\' },\n  { id: \'usa\', name: \'United States of America\' },\n  { id: \'china\', name: \'China\' },\n  { id: \'chad\', name: \'Chad\' },\n  { id: \'niger\', name: \'Niger\' },\n  { id: \'nigeria\', name: \'Nigeria\' },\n  { id: \'uk\', name: \'United Kingdom\' },\n  { id: \'switzerland\', name: \'Switzerland\' },\n  { id: \'ethiopia\', name: \'Ethiopia\' },\n  { id: \'sudan\', name: \'Sudan\' },\n  { id: \'australia\', name: \'Australia\' },\n  { id: \'germany\', name: \'Germany\' },\n  { id: \'mexico\', name: \'Mexico\' },\n  { id: \'brazil\', name: \'Brazil\' },\n  { id: \'drc\', name: \'DRC\' }\n];\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<TabId>(\'population\');\n  const [sliderYear, setSliderYear] = useState<number>(2026);\n  const [selectedCountry, setSelectedCountry] = useState<string>(\'bangladesh\');\n  const [data, setData] = useState<DPPlaceProfile | null>(null);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    setLoading(true);\n    fetch(`/data/${selectedCountry}.json`)\n      .then(res => res.json())\n      .then((json: DPPlaceProfile) => {\n        setData(json);\n        setLoading(false);\n      })\n      .catch(err => {\n        console.error(\"Failed to load country data\", err);\n        setLoading(false);\n      });\n  }, [selectedCountry]);\n\n  const tabs: { id: TabId, label: string, icon: React.ReactNode }[] = [\n    { id: \'population\', label: \'Population Dynamics\', icon: <Users className=\"w-4 h-4 mr-2\" /> },\n    { id: \'globalisation\', label: \'Globalisation\', icon: <Globe className=\"w-4 h-4 mr-2\" /> },\n    { id: \'economy\', label: \'Economy\', icon: <TrendingUp className=\"w-4 h-4 mr-2\" /> },\n    { id: \'human_geography\', label: \'Human Geography\', icon: <Link2 className=\"w-4 h-4 mr-2\" /> },\n    { id: \'physical_layer\', label: \'Physical Layer\', icon: <Map className=\"w-4 h-4 mr-2\" /> },\n  ];\n\n  if (!data) {\n    return (\n      <div className=\"min-h-screen flex items-center justify-center bg-slate-50 text-slate-800\">\n        <Loader2 className=\"w-8 h-8 animate-spin text-indigo-600\" />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900 font-sans selection:bg-indigo-100 selection:text-indigo-900\">\n      \n      {/* Top Header / Nav */}\n      <header className=\"sticky top-0 z-40 bg-white border-b border-slate-200 shadow-sm flex-none\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"flex flex-col md:flex-row md:items-center justify-between py-4 gap-4\">\n            \n            {/* Branding / Dropdown */}\n            <div className=\"flex items-center gap-4\">\n              <div className=\"bg-indigo-600 text-white font-bold px-2 py-1.5 rounded-md text-sm\">\n                DP\n              </div>\n              <div className=\"hidden sm:block\">\n                <h1 className=\"text-lg font-bold leading-tight uppercase tracking-wider text-slate-800\">Place Profiles</h1>\n                <p className=\"text-xs text-slate-500 font-medium\">IB Geography Case-Study Analysis</p>\n              </div>\n              <select \n                value={selectedCountry}\n                onChange={(e) => setSelectedCountry(e.target.value)}\n                className=\"bg-slate-100 border-none text-slate-800 text-sm font-semibold rounded-md px-3 py-1.5 focus:ring-2 focus:ring-indigo-500 outline-none cursor-pointer border border-slate-300 ml-4 max-w-[200px]\"\n              >\n                {availableCountries.map(c => (\n                  <option key={c.id} value={c.id}>{c.name}</option>\n                ))}\n              </select>\n              <div className=\"hidden sm:flex text-xs font-medium text-slate-500 divide-x divide-slate-300\">\n                <span className=\"pr-3\">{data.country_metadata.income_classification}</span>\n                <span className=\"px-3\">HDI Rank #{data.country_metadata.hdi.rank}</span>\n                <span className=\"pl-3\">${data.country_metadata.gni_per_capita_atlas.value_usd} GNI/c</span>\n              </div>\n            </div>\n\n            {/* Global Timeline Slider */}\n            <div className=\"flex items-center gap-4 bg-slate-50 px-5 py-2.5 rounded-lg border border-slate-200 shadow-sm\">\n              <span className=\"text-[10px] font-black text-slate-400 uppercase tracking-tighter\">Timeline</span>\n              <input \n                type=\"range\" \n                min=\"1970\" \n                max=\"2040\" \n                step=\"1\"\n                value={sliderYear}\n                onChange={(e) => setSliderYear(parseInt(e.target.value))}\n                className=\"w-32 md:w-48 h-1.5 bg-slate-300 rounded-lg appearance-none cursor-pointer accent-indigo-600\"\n              />\n              <span className=\"text-sm font-mono font-bold text-indigo-700 w-10 text-right\">{sliderYear}</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Tab Navigation */}\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 overflow-x-auto hide-scrollbar\">\n          <nav className=\"flex space-x-1\" aria-label=\"Tabs\">\n            {tabs.map((tab) => (\n              <button\n                key={tab.id}\n                onClick={() => setActiveTab(tab.id)}\n                className={`\n                  flex items-center px-4 py-3 text-xs font-bold uppercase tracking-widest border-b-2 transition-colors whitespace-nowrap\n                  ${activeTab === tab.id \n                    ? \"border-indigo-600 text-indigo-600 bg-indigo-50/50\" \n                    : \"border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300\"}\n                `}\n              >\n                {tab.icon}\n                {tab.label}\n              </button>\n            ))}\n          </nav>\n        </div>\n      </header>\n\n      {/* Main Content Area */}\n      <main className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 relative\">\n        {loading && (\n           <div className=\"absolute inset-0 bg-slate-50/80 z-10 flex items-start mt-20 justify-center\">\n             <div className=\"bg-white p-4 rounded-full shadow-lg border border-slate-200 text-indigo-600\">\n               <Loader2 className=\"w-6 h-6 animate-spin\" />\n             </div>\n           </div>\n        )}\n        <div className={`transition-opacity duration-300 ${loading ? \'opacity-30\' : \'opacity-100\'}`}>\n          {activeTab === \'globalisation\' && <GlobalisationTab data={data.globalisation_tab} />}\n          {activeTab === \'economy\' && <EconomyTab data={data.economy_tab} />}\n          {activeTab === \'human_geography\' && <HumanGeographyTab data={data.human_geography_tab} />}\n          {activeTab === \'physical_layer\' && <PhysicalLayerTab data={data.prisoners_of_geography_map} />}\n          {activeTab === \'population\' && <PopulationTab data={data.population_dynamics_time_series} currentYear={sliderYear} countryName={data.country_metadata.name} />}\n        </div>\n      </main>\n\n    </div>\n  );\n}"
    }
