    generator_model: MODEL_GOOGLE_GEMINI_INTERNAL_BYOM
    execution_id: "9b7e7907-0fc4-45b8-a9b5-969b98e8fdae"
    source_trajectory_step_info {
      trajectory_id: "9b7e7907-0fc4-45b8-a9b5-969b98e8fdae"
