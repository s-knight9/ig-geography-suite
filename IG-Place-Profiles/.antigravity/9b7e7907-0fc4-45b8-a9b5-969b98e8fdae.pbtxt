  file_change {
    absolute_path_uri: "file:///src/components/tabs/GlobalisationTab.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { DPPlaceProfile } from \"../../types\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"../ui\";\n\nexport function GlobalisationTab({ data }: { data: DPPlaceProfile[\"globalisation_tab\"] }) {\n  const kof = data.kof_index;\n\n  const renderKOFBar = (label: string, deFacto: number, deJure: number) => (\n    <div className=\"mb-6\">\n      <div className=\"flex justify-between items-center mb-2\">\n        <span className=\"text-sm font-semibold text-slate-700\">{label}</span>\n      </div>\n      <div className=\"space-y-3\">\n        <div className=\"relative\">\n          <div className=\"flex justify-between text-xs text-slate-500 mb-1\">\n            <span>De Facto (Flows)</span>\n            <span>{deFacto}</span>\n          </div>\n          <div className=\"h-2.5 w-full bg-slate-100 rounded-full overflow-hidden\">\n            <div className=\"h-full bg-blue-600 rounded-full\" style={{ width: `${deFacto}%` }} />\n          </div>\n        </div>\n        <div className=\"relative\">\n          <div className=\"flex justify-between text-xs text-slate-500 mb-1\">\n            <span>De Jure (Policies)</span>\n            <span>{deJure}</span>\n          </div>\n          <div className=\"h-2.5 w-full bg-slate-100 rounded-full overflow-hidden\">\n            <div className=\"h-full bg-slate-800 rounded-full\" style={{ width: `${deJure}%` }} />\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n\n  return (\n    <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 animate-in fade-in duration-500\">\n      <Card className=\"md:col-span-2\">\n        <CardHeader>\n          <CardTitle>KOF Globalisation Index Vectors</CardTitle>\n        </CardHeader>\n        <CardContent>\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-8\">\n            <div>\n              <h4 className=\"text-xs font-bold tracking-wider uppercase text-slate-400 mb-4 border-b pb-2\">Core Dimensions</h4>\n              {renderKOFBar(\"Economic\", kof.economic.de_facto, kof.economic.de_jure)}\n              {renderKOFBar(\"Political\", kof.political.de_facto, kof.political.de_jure)}\n            </div>\n            <div>\n              <h4 className=\"text-xs font-bold tracking-wider uppercase text-slate-400 mb-4 border-b pb-2\">Social Sub-Dimensions</h4>\n              {renderKOFBar(\"Interpersonal\", kof.social.interpersonal.de_facto, kof.social.interpersonal.de_jure)}\n              {renderKOFBar(\"Informational\", kof.social.informational.de_facto, kof.social.informational.de_jure)}\n              {renderKOFBar(\"Cultural\", kof.social.cultural.de_facto, kof.social.cultural.de_jure)}\n            </div>\n          </div>\n        </CardContent>\n      </Card>\n\n      <div className=\"space-y-6\">\n        <Card>\n          <CardHeader>\n            <CardTitle>A.T. Kearney Framework</CardTitle>\n          </CardHeader>\n          <CardContent>\n            <div className=\"text-sm\">\n              <p className=\"text-slate-500 mb-1\">Status Classification</p>\n              <div className=\"text-xl font-bold text-slate-900 mb-4\">{data.at_kearney_framework.status}</div>\n              <p className=\"text-slate-500 mb-1\">Global City Tier Analysis</p>\n              <div className=\"text-sm font-medium text-slate-800\">{data.at_kearney_framework.gci_score_or_tier}</div>\n            </div>\n          </CardContent>\n        </Card>\n\n        <Card className=\"bg-slate-900 text-white\">\n          <CardHeader>\n            <CardTitle className=\"text-slate-100\">EY Historical Index</CardTitle>\n          </CardHeader>\n          <CardContent>\n            <div className=\"text-3xl font-mono text-blue-400 mb-3\">{data.ey_index_historical.score}</div>\n            <p className=\"text-sm text-slate-300 leading-relaxed\">{data.ey_index_historical.analysis}</p>\n          </CardContent>\n        </Card>\n      </div>\n    </div>\n  );\n}\n"
    }
    diff {
      unified_diff {
