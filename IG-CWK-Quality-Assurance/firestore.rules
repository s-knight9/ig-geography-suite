rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PUBLIC ACCESS RULES (Per user request: No sign-in required)
    // WARNING: These rules allow anyone with the project ID to read/write data.
    
    match /{document=**} {
      allow read, write: if true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /config/structure {
      allow read: if true;
      allow write: if true; // In a production app, this should be restricted
    }

    match /submissions/{submissionId} {
      allow read: if true;
      allow list: if true;
      allow create, update: if (
        request.resource.data.candidateName is string &&
        request.resource.data.candidateName.size() <= 200 &&
        request.resource.data.className is string &&
        request.resource.data.assignmentName is string
      );
      allow delete: if true;
    }
  }
}
