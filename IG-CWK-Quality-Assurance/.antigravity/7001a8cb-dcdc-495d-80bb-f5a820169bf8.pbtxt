        lines {
          text: "  let teacherTotal = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  criteriaData.forEach(c => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    teacherTotal += teacherScores[c.scoreKey] ?? (evalData.scores as any)[c.scoreKey]?.score ?? 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
