      replacement_content: "import { EvaluationResult } from \"./types\";\n\nexport interface StudentSubmission {\n  candidateName: string;\n  className: string;\n  assignmentName: string;\n  draftEvaluation?: EvaluationResult;\n  draftTeacherScores?: Record<string, number>; // key: ao1_knowledge etc.\n  finalEvaluation?: EvaluationResult;\n  finalTeacherScores?: Record<string, number>;\n  status: \"Draft\" | \"Final\";\n}\n\nconst STORAGE_KEY = \"ig_cwk_directory_data\";\n\nexport function loadDirectoryData(): StudentSubmission[] {\n  const data = localStorage.getItem(STORAGE_KEY);\n  if (!data) return [];\n  try {\n    return JSON.parse(data);\n  } catch {\n    return [];\n  }\n}\n\nexport function saveDirectoryData(data: StudentSubmission[]) {\n  localStorage.setItem(STORAGE_KEY, JSON.stringify(data));\n}\n\nexport function addOrUpdateSubmission(submission: StudentSubmission) {\n  const data = loadDirectoryData();\n  const existingIndex = data.findIndex(\n    (s) =>\n      s.candidateName === submission.candidateName &&\n      s.className === submission.className &&\n      s.assignmentName === submission.assignmentName\n  );\n\n  if (existingIndex >= 0) {\n    data[existingIndex] = { ...data[existingIndex], ...submission };\n  } else {\n    data.push(submission);\n  }\n  saveDirectoryData(data);\n}\n"
