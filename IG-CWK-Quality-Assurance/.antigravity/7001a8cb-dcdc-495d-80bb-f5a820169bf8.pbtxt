    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { ChevronLeft, Folder, ChevronRight, FileText, Upload, Columns, Edit2, Play, Plus } from \'lucide-react\';\nimport { loadDirectoryData, StudentSubmission, saveDirectoryData } from \'../db\';\nimport { EvaluationResult } from \'../types\';\n\ninterface DirectoryViewProps {\n  onBack: () => void;\n  isDarkMode: boolean;\n  onUploadFinal: (submission: StudentSubmission) => void;\n}\n\nexport default function DirectoryView({ onBack, isDarkMode, onUploadFinal }: DirectoryViewProps) {\n  const [data, setData] = useState<StudentSubmission[]>([]);\n  const [selectedClass, setSelectedClass] = useState<string | null>(null);\n  const [selectedAssignment, setSelectedAssignment] = useState<string | null>(null);\n  const [selectedStudent, setSelectedStudent] = useState<StudentSubmission | null>(null);\n\n  useEffect(() => {\n    setData(loadDirectoryData());\n  }, []);\n\n  const classes = Array.from(new Set(data.map(d => d.className)));\n  const assignmentsForClass = selectedClass \n    ? Array.from(new Set(data.filter(d => d.className === selectedClass).map(d => d.assignmentName)))\n    : [];\n  const studentsForAssignment = selectedAssignment\n    ? data.filter(d => d.className === selectedClass && d.assignmentName === selectedAssignment)\n    : [];\n\n  const handleTeacherScoreChange = (ao: string, newScore: number, isFinal: boolean) => {\n    if (!selectedStudent) return;\n    const upd = [...data];\n    const idx = upd.findIndex(s => s.candidateName === selectedStudent.candidateName && s.className === selectedClass && s.assignmentName === selectedAssignment);\n    if (idx >= 0) {\n      if (isFinal) {\n        upd[idx].finalTeacherScores = { ...(upd[idx].finalTeacherScores || {}), [ao]: newScore };\n      } else {\n        upd[idx].draftTeacherScores = { ...(upd[idx].draftTeacherScores || {}), [ao]: newScore };\n      }\n      setData(upd);\n      saveDirectoryData(upd);\n      setSelectedStudent(upd[idx]);\n    }\n  };\n\n  const renderStudentDetails = () => {\n    if (!selectedStudent) return null;\n\n    const hasFinal = !!selectedStudent.finalEvaluation;\n    \n    return (\n      <div className=\"bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm p-8 flex flex-col h-full overflow-y-auto\">\n        <h2 className=\"text-2xl font-black text-slate-800 dark:text-slate-100 mb-6\">{selectedStudent.candidateName}</h2>\n        \n        {hasFinal ? (\n          <div className=\"grid grid-cols-2 gap-6\">\n            <div>\n              <h3 className=\"text-sm font-bold text-slate-400 uppercase tracking-widest mb-4\">Draft Report</h3>\n              <EvaluationDisplay \n                evalData={selectedStudent.draftEvaluation!} \n                teacherScores={selectedStudent.draftTeacherScores || {}} \n                onScoreChange={(ao, s) => handleTeacherScoreChange(ao, s, false)}\n                isFinal={false}\n              />\n            </div>\n            <div>\n               <h3 className=\"text-sm font-bold text-[#00bda5] uppercase tracking-widest mb-4 flex items-center justify-between\">\n                 <span>Final Report</span>\n                 <span className=\"text-xs bg-[#00bda5]/10 px-2 py-1 rounded-full text-[#00bda5]\">Comparison Mode</span>\n               </h3>\n               <EvaluationDisplay \n                evalData={selectedStudent.finalEvaluation!} \n                teacherScores={selectedStudent.finalTeacherScores || {}} \n                onScoreChange={(ao, s) => handleTeacherScoreChange(ao, s, true)}\n                isFinal={true}\n              />\n            </div>\n          </div>\n        ) : (\n          <div>\n            <div className=\"flex justify-between items-center mb-6\">\n              <h3 className=\"text-sm font-bold text-slate-400 uppercase tracking-widest\">Draft Report</h3>\n              <button \n                onClick={() => onUploadFinal(selectedStudent)}\n                className=\"bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-bold text-xs uppercase tracking-wider flex items-center gap-2 transition-colors\"\n               >\n                 <Upload className=\"w-4 h-4\" /> Upload Final CWK\n              </button>\n            </div>\n            {selectedStudent.draftEvaluation ? (\n              <EvaluationDisplay \n                evalData={selectedStudent.draftEvaluation} \n                teacherScores={selectedStudent.draftTeacherScores || {}} \n                onScoreChange={(ao, s) => handleTeacherScoreChange(ao, s, false)}\n                isFinal={false}\n              />\n            ) : <p className=\"text-slate-500\">Draft data not available</p>}\n          </div>\n        )}\n      </div>\n    );\n  };\n\n  return (\n    <div className={`min-h-screen bg-[#f8f9fc] dark:bg-slate-900 flex flex-col font-sans transition-colors ${isDarkMode ? \'dark\' : \'\'}`}>\n      <header className=\"bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 h-20 px-8 flex items-center justify-between shrink-0\">\n        <div className=\"flex items-center gap-4\">\n          <button onClick={onBack} className=\"w-10 h-10 rounded-full border border-slate-200 dark:border-slate-600 flex items-center justify-center text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors\">\n            <ChevronLeft className=\"w-5 h-5\" />\n          </button>\n          <div className=\"w-12 h-12 bg-slate-800 dark:bg-slate-700 rounded-xl flex items-center justify-center shadow-sm\">\n            <Folder className=\"text-slate-100 w-6 h-6\" />\n          </div>\n          <div className=\"flex flex-col\">\n            <h1 className=\"text-[22px] font-black text-slate-700 dark:text-slate-200 uppercase tracking-tight leading-tight\">Folder Directory</h1>\n            <p className=\"text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest\">Saved CWK Assessments</p>\n          </div>\n        </div>\n      </header>\n\n      <main className=\"flex-1 p-8 flex gap-6 h-[calc(100vh-80px)] overflow-hidden\">\n        {/* Navigation Sidebar */}\n        <div className=\"w-80 flex flex-col gap-4 overflow-y-auto shrink-0\">\n          {!selectedClass ? (\n            <div className=\"space-y-3\">\n              <h3 className=\"text-xs font-bold text-slate-400 uppercase tracking-widest mb-2 px-2\">Classes</h3>\n              {classes.length === 0 && <p className=\"text-slate-500 text-sm px-2\">No folders created yet. Save an assessment to create folders.</p>}\n              {classes.map(c => (\n                <button key={c} onClick={() => setSelectedClass(c)} className=\"w-full bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-200 dark:border-slate-700 shadow-sm flex items-center justify-between hover:border-blue-300 transition-all text-left group\">\n                  <div className=\"flex items-center gap-3\">\n                    <Folder className=\"w-5 h-5 text-blue-500\" />\n                    <span className=\"font-bold text-slate-700 dark:text-slate-200\">{c}</span>\n                  </div>\n                  <ChevronRight className=\"w-4 h-4 text-slate-300 group-hover:text-blue-500\" />\n                </button>\n              ))}\n            </div>\n          ) : !selectedAssignment ? (\n            <div className=\"space-y-3\">\n              <button onClick={() => setSelectedClass(null)} className=\"text-xs font-bold text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 uppercase tracking-widest mb-2 px-2 flex items-center gap-1\">\n                <ChevronLeft className=\"w-3 h-3\" /> Back to Classes\n              </button>\n              <h3 className=\"text-xl font-bold text-slate-800 dark:text-slate-100 px-2 flex items-center gap-2\">\n                <Folder className=\"w-5 h-5 text-blue-500\" /> {selectedClass}\n              </h3>\n              <div className=\"pt-2\">\n                {assignmentsForClass.map(a => (\n                  <button key={a} onClick={() => setSelectedAssignment(a)} className=\"w-full bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-200 dark:border-slate-700 shadow-sm flex items-center justify-between hover:border-blue-300 transition-all text-left mt-2 group\">\n                    <div className=\"flex flex-col\">\n                      <span className=\"font-bold text-slate-700 dark:text-slate-200 text-sm\">{a}</span>\n                      <span className=\"text-[10px] uppercase font-bold text-slate-400 tracking-widest mt-1\">Assignment Folder</span>\n                    </div>\n                    <ChevronRight className=\"w-4 h-4 text-slate-300 group-hover:text-blue-500\" />\n                  </button>\n                ))}\n              </div>\n            </div>\n          ) : (\n            <div className=\"space-y-3\">\n              <button onClick={() => setSelectedAssignment(null)} className=\"text-xs font-bold text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 uppercase tracking-widest mb-2 px-2 flex items-center gap-1\">\n                <ChevronLeft className=\"w-3 h-3\" /> Back to Assignments\n              </button>\n              <h3 className=\"text-lg font-bold text-slate-800 dark:text-slate-100 px-2 flex flex-col gap-1\">\n                <span className=\"text-xs text-slate-500 font-medium\">Class: {selectedClass}</span>\n                {selectedAssignment}\n              </h3>\n              <div className=\"pt-2 space-y-2\">\n                {studentsForAssignment.map(s => (\n                  <button key={s.candidateName} onClick={() => setSelectedStudent(s)} className={`w-full bg-white dark:bg-slate-800 rounded-xl p-3 border shadow-sm flex items-center justify-between transition-all text-left group ${selectedStudent?.candidateName === s.candidateName ? \'border-blue-500 ring-1 ring-blue-500/20\' : \'border-slate-200 dark:border-slate-700 hover:border-blue-300\'}`}>\n                    <div className=\"flex items-center gap-3\">\n                      <div className={`p-2 rounded-lg ${s.finalEvaluation ? \'bg-green-100 dark:bg-green-900/30 text-green-600\' : \'bg-slate-100 dark:bg-slate-700 text-slate-500\'}`}>\n                        {s.finalEvaluation ? <Columns className=\"w-4 h-4\" /> : <FileText className=\"w-4 h-4\" />}\n                      </div>\n                      <div className=\"flex flex-col\">\n                        <span className=\"font-bold text-slate-700 dark:text-slate-200 text-sm\">{s.candidateName}</span>\n                        <span className=\"text-[10px] uppercase font-bold text-slate-400 tracking-widest mt-0.5\">{s.status}</span>\n                      </div>\n                    </div>\n                  </button>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* Main Content Pane */}\n        <div className=\"flex-1\">\n          {selectedStudent ? renderStudentDetails() : (\n            <div className=\"h-full border-2 border-dashed border-slate-200 dark:border-slate-700 rounded-2xl flex flex-col items-center justify-center text-slate-400\">\n              <Folder className=\"w-16 h-16 mb-4 text-slate-300 dark:text-slate-600\" />\n              <p className=\"font-bold text-lg text-slate-500 dark:text-slate-400\">Select a candidate to view their evaluation details</p>\n            </div>\n          )}\n        </div>\n      </main>\n    </div>\n  );\n}\n\nfunction EvaluationDisplay({ evalData, teacherScores, onScoreChange, isFinal }: { evalData: EvaluationResult, teacherScores: Record<string, number>, onScoreChange: (ao: string, s: number) => void, isFinal: boolean }) {\n  const criteriaData = [\n    { id: \'1\', name: \'Knowledge\', scoreKey: \'ao1_knowledge\' },\n    { id: \'2\', name: \'Observation\', scoreKey: \'ao2_observation\' },\n    { id: \'3\', name: \'Organisation\', scoreKey: \'ao2_organisation\' },\n    { id: \'4\', name: \'Analysis\', scoreKey: \'ao2_analysis\' },\n    { id: \'5\', name: \'Conclusion\', scoreKey: \'ao3_conclusion\' }\n  ];\n\n  const totalPossible = 60;\n  \n  // Calculate total teacher score\n  let teacherTotal = 0;\n  criteriaData.forEach(c => {\n    teacherTotal += teacherScores[c.scoreKey] ?? (evalData.scores as any)[c.scoreKey]?.score ?? 0;\n  });\n\n  return (\n    <div className=\"space-y-6 pb-20\">\n      <div className=\"flex flex-col gap-4\">\n        <div className=\"bg-slate-50 dark:bg-slate-700/50 rounded-xl p-4 border border-slate-200 dark:border-slate-600\">\n           <div className=\"flex justify-between items-end mb-2\">\n             <span className=\"text-xs font-bold text-slate-500 tracking-widest uppercase\">IGQA Score</span>\n             <span className=\"text-3xl font-black text-slate-800 dark:text-slate-100\">{evalData.total_score} <span className=\"text-lg text-slate-400\">/{totalPossible}</span></span>\n           </div>\n           \n           <div className=\"flex justify-between items-end pt-3 border-t border-slate-200 dark:border-slate-600\">\n             <span className=\"text-xs font-bold text-blue-600 dark:text-blue-400 tracking-widest uppercase\">Teacher Mod.</span>\n             <span className=\"text-3xl font-black text-blue-600 dark:text-blue-400\">{teacherTotal} <span className=\"text-lg text-blue-400/50\">/{totalPossible}</span></span>\n           </div>\n        </div>\n      </div>\n      \n      <div className=\"space-y-4\">\n        {criteriaData.map((crit) => {\n          const res = (evalData.scores as any)[crit.scoreKey];\n          if (!res) return null;\n          const ts = teacherScores[crit.scoreKey] ?? res.score;\n          \n          return (\n            <div key={crit.id} className=\"border border-slate-200 dark:border-slate-700 rounded-xl p-4 bg-white dark:bg-slate-800\">\n              <div className=\"flex items-center justify-between mb-3\">\n                 <h4 className=\"font-bold text-sm text-slate-700 dark:text-slate-200 flex items-center gap-2\">\n                   <span className=\"bg-slate-100 dark:bg-slate-700 text-slate-500 w-6 h-6 rounded flex items-center justify-center text-xs\">{crit.id}</span>\n                   {crit.name}\n                 </h4>\n              </div>\n              <div className=\"flex items-center justify-between text-sm\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"text-xs font-bold text-slate-400 uppercase\">IGQA</span>\n                  <span className=\"font-black text-slate-700 dark:text-slate-200\">{res.score}/12</span>\n                </div>\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"text-xs font-bold text-blue-600 uppercase flex items-center gap-1\">Teach <Edit2 className=\"w-3 h-3\" /></span>\n                  <input \n                    type=\"number\" \n                    min=\"0\" max=\"12\" \n                    value={ts}\n                    onChange={(e) => onScoreChange(crit.scoreKey, parseInt(e.target.value) || 0)}\n                    className=\"w-14 px-2 py-1 text-center font-black bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 rounded border outline-none focus:border-blue-400 transition-colors\" \n                  />\n                  <span className=\"font-bold text-slate-400\">/12</span>\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n}\n"
    }
