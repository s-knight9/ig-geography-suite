      target_content: "import React, { useState } from \'react\';\nimport { EvaluationResult } from \'./types\';\nimport { Upload, ChevronRight, CheckCircle2, AlertCircle, PlayCircle, Info } from \'lucide-react\';\nimport Login from \'./components/Login\';\n\nexport default function App() {\n  const [isLoggedIn, setIsLoggedIn] = useState(false);\n  const [draftText, setDraftText] = useState(\"\");\n  const [draftTitle, setDraftTitle] = useState(\"\");\n  const [isEvaluating, setIsEvaluating] = useState(false);\n  const [evaluation, setEvaluation] = useState<EvaluationResult | null>(null);\n  \n  const handleEvaluate = async () => {\n    if (!draftText.trim()) return;\n    setIsEvaluating(true);\n    setEvaluation(null);\n    try {\n      const response = await fetch(\'/api/evaluate\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ text: draftText })\n      });\n      if (response.ok) {\n        const data = await response.json();\n        setEvaluation(data);\n      }\n    } catch (error) {\n      console.error(error);\n    } finally {\n      setIsEvaluating(false);\n    }\n  };\n  \n  const handleNewModeration = () => {\n    setDraftText(\"\");\n    setDraftTitle(\"\");\n    setEvaluation(null);\n  };\n\n  if (!isLoggedIn) {\n    return <Login onLogin={() => setIsLoggedIn(true)} />;\n  }\n\n  return (\n    <div className=\"flex flex-col h-screen w-full bg-slate-50 font-sans text-slate-900 overflow-hidden\">\n      {/* Top Navigation Bar */}\n      <header className=\"flex items-center justify-between h-16 px-8 bg-white border-b border-slate-200 shrink-0\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-8 h-8 bg-blue-600 rounded flex items-center justify-center text-white font-bold\">C</div>\n          <h1 className=\"text-lg font-bold tracking-tight text-slate-800 underline decoration-blue-500 underline-offset-4\">Cambridge IGCSE 0460 Moderator</h1>\n        </div>\n        <div className=\"flex items-center gap-4\">\n          <span className=\"text-xs font-semibold px-2.5 py-1 bg-blue-50 text-blue-700 rounded-full border border-blue-100 uppercase tracking-wider\">2027 Standards Active</span>\n          <button \n            onClick={handleNewModeration}\n            className=\"px-4 py-2 bg-blue-600 text-white rounded-md text-sm font-semibold hover:bg-blue-700 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed\"\n            disabled={isEvaluating}\n          >\n            New Moderation\n          </button>\n        </div>\n      </header>"
      replacement_content: "import React, { useState } from \'react\';\nimport { EvaluationResult } from \'./types\';\nimport { Upload, ChevronRight, CheckCircle2, AlertCircle, PlayCircle, Info, ChevronLeft } from \'lucide-react\';\nimport Login from \'./components/Login\';\nimport UploadView from \'./components/UploadView\';\n\nexport default function App() {\n  const [isLoggedIn, setIsLoggedIn] = useState(false);\n  const [appState, setAppState] = useState<\'upload\' | \'moderation\'>(\'upload\');\n  const [draftText, setDraftText] = useState(\"\");\n  const [draftTitle, setDraftTitle] = useState(\"\");\n  \n  const [isEvaluating, setIsEvaluating] = useState(false);\n  const [evaluation, setEvaluation] = useState<EvaluationResult | null>(null);\n  \n  const handleEvaluate = async () => {\n    if (!draftText.trim()) return;\n    setIsEvaluating(true);\n    setEvaluation(null);\n    try {\n      const response = await fetch(\'/api/evaluate\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ text: draftText })\n      });\n      if (response.ok) {\n        const data = await response.json();\n        setEvaluation(data);\n      }\n    } catch (error) {\n      console.error(error);\n    } finally {\n      setIsEvaluating(false);\n    }\n  };\n  \n  const handleNewModeration = () => {\n    setDraftText(\"\");\n    setDraftTitle(\"\");\n    setEvaluation(null);\n    setAppState(\'upload\');\n  };\n\n  const handleUploadComplete = (text: string, title: string) => {\n    setDraftText(text);\n    setDraftTitle(title);\n    setAppState(\'moderation\');\n  };\n\n  if (!isLoggedIn) {\n    return <Login onLogin={() => setIsLoggedIn(true)} />;\n  }\n\n  if (appState === \'upload\') {\n    return <UploadView onUploadComplete={handleUploadComplete} onLogout={() => setIsLoggedIn(false)} />;\n  }\n\n  return (\n    <div className=\"flex flex-col h-screen w-full bg-slate-50 font-sans text-slate-900 overflow-hidden\">\n      {/* Top Navigation Bar */}\n      <header className=\"flex items-center justify-between h-16 px-8 bg-white border-b border-slate-200 shrink-0\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-8 h-8 bg-blue-600 rounded flex items-center justify-center text-white font-bold\">IG</div>\n          <h1 className=\"text-lg font-bold tracking-tight text-slate-800 underline decoration-blue-500 underline-offset-4\">IG CWK Quality assurance</h1>\n        </div>\n        <div className=\"flex items-center gap-4\">\n          <span className=\"text-xs font-semibold px-2.5 py-1 bg-blue-50 text-blue-700 rounded-full border border-blue-100 uppercase tracking-wider\">2027 Standards Active</span>\n          <button \n            onClick={() => setAppState(\'upload\')}\n            className=\"px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-md text-sm font-semibold transition-colors mr-2 flex items-center gap-2\"\n          >\n            <ChevronLeft className=\"w-4 h-4\" /> Back to Upload\n          </button>\n          <button \n            onClick={handleNewModeration}\n            className=\"px-4 py-2 bg-blue-600 text-white rounded-md text-sm font-semibold hover:bg-blue-700 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed\"\n            disabled={isEvaluating}\n          >\n            New Moderation\n          </button>\n        </div>\n      </header>"
    }
