    instruction: "Add SwipeableItem component and update DirectoryView state"
    replacement_infos {
      original_chunk {
        target_content: "export default function DirectoryView({ onBack, isDarkMode, onUploadFinal }: DirectoryViewProps) {\n  const [data, setData] = useState<StudentSubmission[]>([]);\n  const [selectedClass, setSelectedClass] = useState<string | null>(null);\n  const [selectedAssignment, setSelectedAssignment] = useState<string | null>(null);\n  const [selectedStudent, setSelectedStudent] = useState<StudentSubmission | null>(null);\n\n  useEffect(() => {\n    setData(loadDirectoryData());\n  }, []);\n\n  const classes = Array.from(new Set(data.map(d => d.className)));\n  const assignmentsForClass = selectedClass \n    ? Array.from(new Set(data.filter(d => d.className === selectedClass).map(d => d.assignmentName)))\n    : [];"
        replacement_content: "function SwipeableItem({ name, isSelected, onClick, onRename, onDelete, subtitle, icon: Icon, rightIcon: RightIcon }: any) {\n  const controls = useAnimation();\n  const [isRenaming, setIsRenaming] = useState(false);\n  const [tempName, setTempName] = useState(name);\n\n  const handleDragEnd = (event: any, info: any) => {\n    if (info.offset.x < -40) {\n      controls.start({ x: -60 });\n    } else {\n      controls.start({ x: 0 });\n    }\n  };\n\n  const submitRename = () => {\n    if (tempName.trim() && tempName !== name) {\n      onRename(tempName.trim());\n    } else {\n      setTempName(name); // revert\n    }\n    setIsRenaming(false);\n  };\n\n  return (\n    <div className=\"relative w-full mb-3 rounded-xl overflow-hidden bg-red-100 dark:bg-red-900/30\">\n      <div className=\"absolute right-0 top-0 bottom-0 w-16 flex items-center justify-center bg-red-500\">\n        <button onClick={() => { if (confirm(`Delete \'${name}\'?`)) onDelete(); controls.start({ x: 0 }); }} className=\"text-white\">\n          <Trash2 className=\"w-4 h-4\" />\n        </button>\n      </div>\n\n      <motion.div \n        drag=\"x\"\n        dragConstraints={{ left: -60, right: 0 }}\n        onDragEnd={handleDragEnd}\n        animate={controls}\n        className={`w-full bg-white dark:bg-slate-800 rounded-xl p-4 border shadow-sm flex items-center justify-between transition-all text-left group cursor-pointer ${isSelected ? \'border-blue-500 ring-1 ring-blue-500/20\' : \'border-slate-200 dark:border-slate-700 hover:border-blue-300\'}`}\n      >\n        <div className=\"flex items-center gap-3 w-full\" onClick={isRenaming ? undefined : onClick}>\n          <Icon className={`w-5 h-5 ${isSelected ? \'text-blue-600\' : \'text-blue-500\'}`} />\n          \n          <div className=\"flex flex-col flex-1 min-w-0\">\n            {isRenaming ? (\n              <input\n                autoFocus\n                className=\"w-full font-bold text-sm bg-transparent border-b border-blue-400 outline-none text-slate-800 dark:text-slate-100\"\n                value={tempName}\n                onChange={e => setTempName(e.target.value)}\n                onBlur={submitRename}\n                onClick={e => e.stopPropagation()}\n                onKeyDown={e => { if (e.key === \'Enter\') submitRename(); if (e.key === \'Escape\') setIsRenaming(false); }}\n              />\n            ) : (\n              <span className=\"font-bold text-slate-700 dark:text-slate-200 text-sm truncate\">{name}</span>\n            )}\n            {subtitle && !isRenaming && <span className=\"text-[10px] uppercase font-bold text-slate-400 tracking-widest mt-1\">{subtitle}</span>}\n          </div>\n        </div>\n\n        {!isRenaming && (\n          <div className=\"flex flex-col items-center justify-center gap-2\">\n            <button\n               onClick={(e) => { e.stopPropagation(); setIsRenaming(true); controls.start({ x: 0 }); }}\n               className=\"text-slate-300 hover:text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity p-1\"\n               title=\"Rename\"\n            >\n               <Edit2 className=\"w-3 h-3\" />\n            </button>\n            <RightIcon className=\"w-4 h-4 text-slate-300 group-hover:text-blue-500 shrink-0\" />\n          </div>\n        )}\n      </motion.div>\n    </div>\n  );\n}\n\nexport default function DirectoryView({ onBack, isDarkMode, onUploadFinal }: DirectoryViewProps) {\n  const [data, setData] = useState<StudentSubmission[]>([]);\n  const [struct, setStruct] = useState({ classes: [] as string[], assignments: {} as Record<string, string[]> });\n  const [selectedClass, setSelectedClass] = useState<string | null>(null);\n  const [selectedAssignment, setSelectedAssignment] = useState<string | null>(null);\n  const [selectedStudent, setSelectedStudent] = useState<StudentSubmission | null>(null);\n\n  const refreshData = () => {\n    setData(loadDirectoryData());\n    setStruct(loadStructure());\n  };\n\n  useEffect(() => {\n    refreshData();\n  }, []);\n\n  const classes = Array.from(new Set([...struct.classes, ...data.map(d => d.className)]));\n  const assignmentsForClass = selectedClass \n    ? Array.from(new Set([...(struct.assignments[selectedClass] || []), ...data.filter(d => d.className === selectedClass).map(d => d.assignmentName)]))\n    : [];"
      }
      num_matches: 1
    }
  }
}
