    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { EvaluationResult } from \'./types\';\nimport { Upload, ChevronRight, CheckCircle2, AlertCircle, PlayCircle, Info } from \'lucide-react\';\n\nexport default function App() {\n  const [draftText, setDraftText] = useState(\"\");\n  const [draftTitle, setDraftTitle] = useState(\"\");\n  const [isEvaluating, setIsEvaluating] = useState(false);\n  const [evaluation, setEvaluation] = useState<EvaluationResult | null>(null);\n  \n  const handleEvaluate = async () => {\n    if (!draftText.trim()) return;\n    setIsEvaluating(true);\n    setEvaluation(null);\n    try {\n      const response = await fetch(\'/api/evaluate\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ text: draftText })\n      });\n      if (response.ok) {\n        const data = await response.json();\n        setEvaluation(data);\n      }\n    } catch (error) {\n      console.error(error);\n    } finally {\n      setIsEvaluating(false);\n    }\n  };\n  \n  const handleNewModeration = () => {\n    setDraftText(\"\");\n    setDraftTitle(\"\");\n    setEvaluation(null);\n  };\n\n  return (\n    <div className=\"flex flex-col h-screen w-full bg-slate-50 font-sans text-slate-900 overflow-hidden\">\n      {/* Top Navigation Bar */}\n      <header className=\"flex items-center justify-between h-16 px-8 bg-white border-b border-slate-200 shrink-0\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-8 h-8 bg-blue-600 rounded flex items-center justify-center text-white font-bold\">C</div>\n          <h1 className=\"text-lg font-bold tracking-tight text-slate-800 underline decoration-blue-500 underline-offset-4\">Cambridge IGCSE 0460 Moderator</h1>\n        </div>\n        <div className=\"flex items-center gap-4\">\n          <span className=\"text-xs font-semibold px-2.5 py-1 bg-blue-50 text-blue-700 rounded-full border border-blue-100 uppercase tracking-wider\">2027 Standards Active</span>\n          <button \n            onClick={handleNewModeration}\n            className=\"px-4 py-2 bg-blue-600 text-white rounded-md text-sm font-semibold hover:bg-blue-700 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed\"\n            disabled={isEvaluating}\n          >\n            New Moderation\n          </button>\n        </div>\n      </header>\n\n      <main className=\"flex flex-1 overflow-hidden h-full\">\n        {/* Left Navigation: Assessment Framework */}\n        <nav className=\"w-64 bg-slate-100 border-r border-slate-200 flex flex-col p-4 shrink-0 overflow-y-auto\">\n          <p className=\"text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-4\">Assessment Criteria</p>\n          <div className=\"space-y-1\">\n            <div className={`flex justify-between items-center p-2 rounded ${evaluation ? \'bg-white shadow-sm border border-slate-200\' : \'bg-slate-50 border border-transparent\'}`}>\n              <span className=\"text-xs font-medium\">AO1: Knowledge</span>\n              <span className={`text-xs font-bold ${evaluation ? \'text-blue-600\' : \'text-slate-400\'}`}>{evaluation ? `${evaluation.scores.ao1_knowledge.score}/12` : \'-/12\'}</span>\n            </div>\n            <div className={`flex justify-between items-center p-2 rounded ${evaluation ? \'bg-white shadow-sm border border-slate-200\' : \'bg-slate-50 border border-transparent\'}`}>\n              <span className=\"text-xs font-medium\">AO2: Observation</span>\n              <span className={`text-xs font-bold ${evaluation ? \'text-blue-600\' : \'text-slate-400\'}`}>{evaluation ? `${evaluation.scores.ao2_observation.score}/12` : \'-/12\'}</span>\n            </div>\n            <div className={`flex justify-between items-center p-2 rounded ${evaluation ? \'bg-white shadow-sm border border-slate-200 ring-1 ring-blue-500/20\' : \'bg-slate-50 border border-transparent\'}`}>\n              <span className=\"text-xs font-medium\">AO2: Organisation</span>\n              <span className={`text-xs font-bold ${evaluation ? \'text-blue-600\' : \'text-slate-400\'}`}>{evaluation ? `${evaluation.scores.ao2_organisation.score}/12` : \'-/12\'}</span>\n            </div>\n            <div className={`flex justify-between items-center p-2 rounded ${evaluation ? \'bg-white shadow-sm border border-slate-200\' : \'bg-slate-50 border border-transparent\'}`}>\n              <span className=\"text-xs font-medium\">AO2: Analysis</span>\n              <span className={`text-xs font-bold ${evaluation ? \'text-blue-600\' : \'text-slate-400\'}`}>{evaluation ? `${evaluation.scores.ao2_analysis.score}/12` : \'-/12\'}</span>\n            </div>\n            <div className={`flex justify-between items-center p-2 rounded ${evaluation ? \'bg-white shadow-sm border border-slate-200\' : \'bg-slate-50 border border-transparent\'}`}>\n              <span className=\"text-xs font-medium\">AO3: Conclusion</span>\n              <span className={`text-xs font-bold ${evaluation ? \'text-blue-600\' : \'text-slate-400\'}`}>{evaluation ? `${evaluation.scores.ao3_conclusion.score}/12` : \'-/12\'}</span>\n            </div>\n          </div>\n\n          <div className=\"mt-auto pt-6\">\n            <div className=\"bg-blue-900 rounded-xl p-4 text-white\">\n              <p className=\"text-xs opacity-80 mb-1\">Indicative Total</p>\n              <h2 className=\"text-3xl font-bold\">{evaluation ? evaluation.total_score : \'--\'}<span className=\"text-sm font-normal opacity-60\">/60</span></h2>\n              {evaluation && (\n                <p className=\"text-[10px] mt-2 bg-white/10 px-2 py-1 rounded inline-block\">{evaluation.grade_indication}</p>\n              )}\n            </div>\n          </div>\n        </nav>\n\n        {/* Central View: Document Content & Annotations */}\n        <section className=\"flex-1 bg-slate-200/50 flex flex-col relative p-4 h-full\">\n          <div className=\"bg-white shadow-lg rounded-lg border border-slate-300 flex-1 overflow-hidden flex flex-col\">\n            <div className=\"p-4 border-b border-slate-100 flex items-center justify-between shrink-0 bg-slate-50/50\">\n              <input \n                type=\"text\"\n                placeholder=\"Coursework Title (Optional)\"\n                value={draftTitle}\n                onChange={(e) => setDraftTitle(e.target.value)}\n                className=\"font-serif text-lg italic bg-transparent border-none outline-none focus:ring-0 w-2/3 placeholder-slate-400\"\n              />\n              <span className=\"text-xs text-slate-400 font-mono\">\n                {draftText.length > 0 ? `${draftText.split(/\\s+/).filter(w => w.length > 0).length} words` : \'\'}\n              </span>\n            </div>\n            \n            <div className=\"flex-1 flex flex-col overflow-hidden relative group\">\n                <textarea\n                  className={`w-full h-full p-8 resize-none outline-none font-serif text-slate-700 leading-relaxed ${evaluation ? \'opacity-30 pb-48\' : \'\'}`}\n                  placeholder=\"Paste student coursework draft here... (approx. 2000 words)\"\n                  value={draftText}\n                  onChange={(e) => setDraftText(e.target.value)}\n                  disabled={isEvaluating}\n                />\n                \n                {/* Annotations Overlay (Only active when evaluated) */}\n                {evaluation && (\n                  <div className=\"absolute inset-x-0 bottom-0 top-0 pointer-events-none p-8 overflow-y-auto\">\n                    <div className=\"mt-[20vh] space-y-8 pointer-events-auto\">\n                      {evaluation.annotations.map((ann, idx) => (\n                        <div key={idx} className=\"relative bg-white shadow-xl border-l-4 border-blue-500 p-5 rounded-r-lg max-w-3xl mx-auto opacity-95\">\n                          <p className=\"text-[10px] text-blue-600 font-sans font-bold mb-1 uppercase tracking-widest\">Annotation: {ann.criteria}</p>\n                          <div className=\"mb-3 text-slate-500 italic text-sm pl-2 border-l-2 border-slate-200\">\n                             \"{ann.quote}\"\n                          </div>\n                          <p className=\"text-sm font-sans text-slate-800\">\n                            {ann.comment}\n                          </p>\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                )}\n\n                {/* Evaluate Overlay Button */}\n                {!evaluation && draftText.trim().length > 0 && (\n                   <div className=\"absolute bottom-6 right-6 transition-opacity opacity-0 group-hover:opacity-100\">\n                     <button \n                        onClick={handleEvaluate}\n                        disabled={isEvaluating}\n                        className=\"flex items-center gap-2 bg-blue-600 text-white px-6 py-3 rounded-full shadow-lg font-bold hover:bg-blue-700 transition cursor-pointer disabled:opacity-50\"\n                     >\n                       {isEvaluating ? (\n                         <>\n                          <div className=\"w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin\" />\n                          Analyzing...\n                         </>\n                       ) : (\n                         <>\n                          <PlayCircle className=\"w-5 h-5\" />\n                          Moderate Draft\n                         </>\n                       )}\n                     </button>\n                   </div>\n                )}\n            </div>\n          </div>\n        </section>\n\n        {/* Right Sidebar: Level Up Feedback */}\n        <aside className=\"w-80 bg-white border-l border-slate-200 flex flex-col p-5 shrink-0 overflow-y-auto overflow-x-hidden\">\n          <h4 className=\"text-sm font-bold border-b border-slate-100 pb-3 mb-4 flex items-center gap-2\">\n            <svg className=\"w-4 h-4 text-amber-500\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path d=\"M11 3a1 1 0 10-2 0v1a1 1 0 102 0V3zM15.657 5.757a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414l.707-.707zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zM5 10a1 1 0 01-1 1H3a1 1 0 110-2h1a1 1 0 011 1zM8 16v-1a1 1 0 112 0v1a1 1 0 11-2 0zM13.536 14.95a1 1 0 011.414 0l.707.707a1 1 0 01-1.414 1.414l-.707-.707a1 1 0 010-1.414zM16.243 17.243a1 1 0 01-1.414 1.414l-.707-.707a1 1 0 011.414-1.414l.707.707z\"></path></svg>\n            Level 2 to Level 3 Roadmap\n          </h4>\n          \n          <div className=\"space-y-4 flex-1\">\n            {evaluation ? (\n              evaluation.roadmap.map((item, idx) => (\n                <div key={idx} className=\"p-3 bg-slate-50 rounded-lg border border-slate-200\">\n                  <p className=\"text-[11px] font-bold text-blue-600 uppercase mb-1\">{item.criteria}</p>\n                  <p className=\"text-xs leading-relaxed text-slate-600\" dangerouslySetInnerHTML={{ __html: item.suggestion.replace(/\\*\\*(.*?)\\*\\*/g, \'<strong>$1</strong>\') }}></p>\n                </div>\n              ))\n            ) : (\n                <div className=\"flex flex-col items-center justify-center h-48 text-center text-slate-400 px-4\">\n                  <Info className=\"w-8 h-8 mb-3 opacity-20\" />\n                  <p className=\"text-xs\">Paste coursework and click moderate to view improvement suggestions.</p>\n                </div>\n            )}\n          </div>\n\n          <div className=\"mt-8 pt-4 border-t border-slate-100 shrink-0\">\n            <p className=\"text-[10px] text-slate-400 uppercase font-bold tracking-widest mb-3\">Best Fit Moderation Log</p>\n            <ul className=\"text-[11px] space-y-2 text-slate-500\">\n              {evaluation ? (\n                evaluation.moderation_log.map((log, idx) => (\n                  <li key={idx} className=\"flex items-start gap-2\">\n                    <div className={`w-1.5 h-1.5 rounded-full mt-1 shrink-0 ${log.type === \'positive\' ? \'bg-green-500\' : \'bg-amber-500\'}`}></div>\n                    <span><strong className={`${log.type === \'positive\' ? \'text-green-700\' : \'text-amber-700\'}`}>{log.criteria}:</strong> {log.comment}</span>\n                  </li>\n                ))\n              ) : (\n                  <li className=\"text-slate-400 italic\">No logs available.</li>\n              )}\n            </ul>\n          </div>\n        </aside>\n      </main>\n\n      {/* Footer Status */}\n      <footer className=\"h-8 px-6 bg-slate-800 text-slate-400 flex items-center justify-between text-[10px] uppercase tracking-tighter shrink-0\">\n        <div className=\"flex gap-4\">\n          <span>Session ID: MOD-0460-{Math.random().toString(36).substr(2, 6).toUpperCase()}</span>\n          <span>{isEvaluating ? \'Evaluating...\' : \'Ready\'}</span>\n        </div>\n        <div className=\"flex gap-2 items-center\">\n          <div className={`w-2 h-2 rounded-full ${isEvaluating ? \'bg-amber-400 animate-pulse\' : \'bg-green-400\'}`}></div>\n          <span>AI Engine: Route-to-Enquiry v4.2</span>\n        </div>\n      </footer>\n    </div>\n  );\n}\n"
    }
