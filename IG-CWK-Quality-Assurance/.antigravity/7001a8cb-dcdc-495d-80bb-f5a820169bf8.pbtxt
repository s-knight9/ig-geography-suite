    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "      <main className=\"flex-1 p-8 flex gap-6 h-[calc(100vh-80px)] overflow-hidden\">\n        {/* Navigation Sidebar */}\n        <div className=\"w-80 flex flex-col gap-4 overflow-y-auto shrink-0\">\n          {!selectedClass ? (\n            <div className=\"space-y-3\">\n              <div className=\"flex items-center justify-between px-2 mb-2\">\n                <h3 className=\"text-xs font-bold text-slate-400 uppercase tracking-widest\">Classes</h3>\n              </div>\n              <button \n                 onClick={() => setIsCreatingClass(true)} \n                 className=\"w-full border-2 border-dashed border-slate-200 dark:border-slate-700 rounded-xl p-3 flex items-center justify-center text-slate-500 hover:border-blue-300 hover:text-blue-500 transition-colors mb-2 gap-2 font-bold text-sm\"\n              >\n                <Plus className=\"w-4 h-4\" /> Add Class Folder\n              </button>\n              {isCreatingClass && (\n                <NewFolderInput \n                   placeholder=\"New Class Name...\"\n                   onSubmit={(name) => { createClass(name); refreshData(); setIsCreatingClass(false); }}\n                   onCancel={() => setIsCreatingClass(false)}\n                />\n              )}\n              {classes.length === 0 && <p className=\"text-slate-500 text-sm px-2\">No folders created yet. Save an assessment to create folders.</p>}\n              {classes.map(c => (\n                <SwipeableItem \n                   key={c}\n                   name={c}\n                   isSelected={false}\n                   onClick={() => setSelectedClass(c)}\n                   onRename={(newN: string) => { renameClass(c, newN); refreshData(); }}\n                   onDelete={() => { deleteClass(c); refreshData(); }}\n                   icon={Folder}\n                   rightIcon={ChevronRight}\n                />\n              ))}\n            </div>\n          ) : !selectedAssignment ? (\n            <div className=\"space-y-3\">\n              <button onClick={() => setSelectedClass(null)} className=\"text-xs font-bold text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 uppercase tracking-widest mb-2 px-2 flex items-center gap-1\">\n                <ChevronLeft className=\"w-3 h-3\" /> Back to Classes\n              </button>\n              <h3 className=\"text-xl font-bold text-slate-800 dark:text-slate-100 px-2 flex items-center gap-2\">\n                <Folder className=\"w-5 h-5 text-blue-500\" /> {selectedClass}\n              </h3>\n              <div className=\"flex items-center justify-between px-2 mt-4 mb-2\">\n                <span className=\"text-xs font-bold text-slate-400 uppercase tracking-widest\">Assignments</span>\n              </div>\n              <button \n                 onClick={() => setIsCreatingAssignment(true)} \n                 className=\"w-full border-2 border-dashed border-slate-200 dark:border-slate-700 rounded-xl p-3 flex items-center justify-center text-slate-500 hover:border-blue-300 hover:text-blue-500 transition-colors mb-2 gap-2 font-bold text-sm\"\n              >\n                <Plus className=\"w-4 h-4\" /> Add Assignment Folder\n              </button>\n              {isCreatingAssignment && (\n                <NewFolderInput \n                   placeholder=\"New Assignment Name...\"\n                   onSubmit={(name) => { if(selectedClass) { createAssignment(selectedClass, name); refreshData(); } setIsCreatingAssignment(false); }}\n                   onCancel={() => setIsCreatingAssignment(false)}\n                />\n              )}\n              <div className=\"pt-2\">\n                {assignmentsForClass.map(a => (\n                  <SwipeableItem \n                     key={a}\n                     name={a}\n                     subtitle=\"Assignment Folder\"\n                     isSelected={false}\n                     onClick={() => setSelectedAssignment(a)}\n                     onRename={(newN: string) => { if(selectedClass) renameAssignment(selectedClass, a, newN); refreshData(); }}\n                     onDelete={() => { if(selectedClass) deleteAssignment(selectedClass, a); refreshData(); }}\n                     icon={Folder}\n                     rightIcon={ChevronRight}\n                  />\n                ))}\n              </div>\n            </div>\n          ) : (\n            <div className=\"space-y-3\">\n              <button onClick={() => setSelectedAssignment(null)} className=\"text-xs font-bold text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 uppercase tracking-widest mb-2 px-2 flex items-center gap-1\">\n                <ChevronLeft className=\"w-3 h-3\" /> Back to Assignments\n              </button>\n              <h3 className=\"text-lg font-bold text-slate-800 dark:text-slate-100 px-2 flex flex-col gap-1\">\n                <span className=\"text-xs text-slate-500 font-medium\">Class: {selectedClass}</span>\n                {selectedAssignment}\n              </h3>\n              <div className=\"pt-2 space-y-2\">\n                {studentsForAssignment.map(s => (\n                  <button key={s.candidateName} onClick={() => setSelectedStudent(s)} className={`w-full bg-white dark:bg-slate-800 rounded-xl p-3 border shadow-sm flex items-center justify-between transition-all text-left group ${selectedStudent?.candidateName === s.candidateName ? \'border-blue-500 ring-1 ring-blue-500/20\' : \'border-slate-200 dark:border-slate-700 hover:border-blue-300\'}`}>\n                    <div className=\"flex items-center gap-3\">\n                      <div className={`p-2 rounded-lg ${s.finalEvaluation ? \'bg-green-100 dark:bg-blue-900/30 text-blue-600\' : \'bg-slate-100 dark:bg-slate-700 text-slate-500\'}`}>\n                        {s.finalEvaluation ? <Columns className=\"w-4 h-4\" /> : <FileText className=\"w-4 h-4\" />}\n                      </div>\n                      <div className=\"flex flex-col\">\n                        <span className=\"font-bold text-slate-700 dark:text-slate-200 text-sm\">{s.candidateName}</span>\n                        <span className=\"text-[10px] uppercase font-bold text-slate-400 tracking-widest mt-0.5\">{s.status}</span>\n                      </div>\n                    </div>\n                  </button>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n        \n        {/* Main Content Pane */}\n        <div className=\"flex-1\">\n          {selectedStudent ? renderStudentDetails() : (\n            <div className=\"h-full border-2 border-dashed border-slate-200 dark:border-slate-700 rounded-2xl flex flex-col items-center justify-center text-slate-400\">\n              <Folder className=\"w-16 h-16 mb-4 text-slate-300 dark:text-slate-600\" />\n              <p className=\"font-bold text-lg text-slate-500 dark:text-slate-400\">Select a candidate to view their evaluation details</p>\n            </div>\n          )}\n        </div>\n      </main>"
      replacement_content: "      <main className=\"flex-1 p-6 flex h-[calc(100vh-80px)] overflow-hidden\">\n        {/* Navigation Sidebar: Classes & Assignments */}\n        <div className=\"w-80 flex flex-col gap-4 overflow-y-auto shrink-0 border-r border-slate-200 dark:border-slate-700 pr-6\">\n          <div className=\"flex items-center gap-2 mb-2 px-2\">\n            <Folder className=\"w-5 h-5 text-green-600\" />\n            <h3 className=\"font-bold text-slate-800 dark:text-slate-100 uppercase tracking-widest text-sm\">Master Directory</h3>\n          </div>\n\n          <button \n             onClick={() => setIsCreatingClass(true)} \n             className=\"w-full border border-dashed border-slate-300 dark:border-slate-600 rounded-xl p-3 flex items-center justify-center text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors bg-white dark:bg-slate-900 font-bold text-sm shadow-sm\"\n          >\n            <Plus className=\"w-4 h-4 mr-2\" /> Add Teacher Folder\n          </button>\n          \n          {isCreatingClass && (\n            <NewFolderInput \n               placeholder=\"New Class Name...\"\n               onSubmit={(name) => { createClass(name); refreshData(); setIsCreatingClass(false); }}\n               onCancel={() => setIsCreatingClass(false)}\n            />\n          )}\n\n          <div className=\"flex flex-col gap-2 pb-10\">\n            {classes.map(c => (\n              <ClassAccordion \n                key={c}\n                name={c}\n                isExpanded={selectedClass === c}\n                onToggle={() => setSelectedClass(selectedClass === c ? null : c)}\n                onRename={(newN: string) => { renameClass(c, newN); refreshData(); if (selectedClass === c) setSelectedClass(newN); }}\n                onDelete={() => { deleteClass(c); refreshData(); if (selectedClass === c) setSelectedClass(null); }}\n                assignments={Array.from(new Set([\n                  ...(struct.assignments[c] || []),\n                  ...data.filter(d => d.className === c).map(d => d.assignmentName)\n                ]))}\n                onAddAssignment={(name: string) => { createAssignment(c, name); refreshData(); }}\n                onDeleteAssignment={(a: string) => { deleteAssignment(c, a); refreshData(); if(selectedAssignment === a) setSelectedAssignment(null); }}\n                onRenameAssignment={(oldN: string, newN: string) => { renameAssignment(c, oldN, newN); refreshData(); if(selectedAssignment === oldN) setSelectedAssignment(newN); }}\n                selectedAssignment={selectedClass === c ? selectedAssignment : null}\n                onSelectAssignment={(a: string) => {\n                  setSelectedClass(c);\n                  setSelectedAssignment(a);\n                  setSelectedStudent(null);\n                }}\n              />\n            ))}\n          </div>\n        </div>\n\n        {/* Middle Pane: Students */}\n        {selectedClass && selectedAssignment && (\n          <div className=\"w-80 flex flex-col gap-4 overflow-y-auto shrink-0 border-r border-slate-200 dark:border-slate-700 px-6\">\n            <h3 className=\"text-lg font-bold text-slate-800 dark:text-slate-100 flex flex-col gap-1\">\n              <span className=\"text-xs text-slate-500 font-medium\">Class: {selectedClass}</span>\n              {selectedAssignment} Submissions\n            </h3>\n            \n            <div className=\"pt-2 space-y-2 pb-10\">\n              {studentsForAssignment.length === 0 && (\n                <p className=\"text-sm text-slate-500 italic\">No submissions yet.</p>\n              )}\n              {studentsForAssignment.map(s => (\n                <button \n                  key={s.candidateName} \n                  onClick={() => setSelectedStudent(s)} \n                  className={`w-full bg-white dark:bg-slate-800 rounded-xl p-3 border shadow-sm flex items-center justify-between transition-all text-left group ${selectedStudent?.candidateName === s.candidateName ? \'border-blue-500 ring-1 ring-blue-500/20\' : \'border-slate-200 dark:border-slate-700 hover:border-blue-300\'}`}\n                >\n                  <div className=\"flex items-center gap-3 w-full min-w-0\">\n                    <div className={`shrink-0 p-2 rounded-lg ${s.finalEvaluation ? \'bg-green-100 dark:bg-green-900/30 text-green-600\' : \'bg-slate-100 dark:bg-slate-700 text-slate-500\'}`}>\n                      {s.finalEvaluation ? <Columns className=\"w-4 h-4\" /> : <FileText className=\"w-4 h-4\" />}\n                    </div>\n                    <div className=\"flex flex-col min-w-0 flex-1 pr-2\">\n                      <span className=\"font-bold text-slate-700 dark:text-slate-200 text-sm truncate\">{s.candidateName}</span>\n                      <span className=\"text-[10px] uppercase font-bold text-slate-400 tracking-widest mt-0.5 truncate\">{s.status}</span>\n                    </div>\n                  </div>\n                </button>\n              ))}\n            </div>\n          </div>\n        )}\n\n        {/* Main Content Pane: Evaluation Details */}\n        <div className=\"flex-1 overflow-y-auto pl-6\">\n          {selectedStudent ? renderStudentDetails() : (\n            <div className=\"h-full border-2 border-dashed border-slate-200 dark:border-slate-700 rounded-2xl flex flex-col items-center justify-center text-slate-400\">\n              <Folder className=\"w-16 h-16 mb-4 text-slate-300 dark:text-slate-600\" />\n              {selectedClass && selectedAssignment ? (\n                  <p className=\"font-bold text-lg text-slate-500 dark:text-slate-400\">Select a candidate to view their evaluation details</p>\n              ) : (\n                  <p className=\"font-bold text-lg text-slate-500 dark:text-slate-400\">Select an assignment folder to view submissions</p>\n              )}\n            </div>\n          )}\n        </div>\n      </main>"
    }
    instruction: "Update layout to three panes for directory, selecting students, and student details"
  }
}
