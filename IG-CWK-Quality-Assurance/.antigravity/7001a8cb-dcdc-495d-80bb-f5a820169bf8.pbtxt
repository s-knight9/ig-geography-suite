    replacement_chunks {
      replacement_content: "import express from \"express\";\nimport path from \"path\";\nimport { createServer as createViteServer } from \"vite\";\nimport { GoogleGenAI } from \"@google/genai\";\nimport multer from \"multer\";\n\nconst ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });\nconst upload = multer();\n\nasync function startServer() {\n  const app = express();\n  const PORT = 3000;\n\n  app.use(express.json());\n\n  app.post(\"/api/evaluate\", upload.single(\"document\"), async (req, res) => {\n    try {\n      const text = req.body.text; // Or parse from file if needed\n      \n      const prompt = `You are an expert Cambridge IGCSE Geography (0460) Coursework Moderator.\nEvaluate the following student coursework draft based on the \"Route to Geographical Enquiry\" framework. \nProvide analysis across the five assessment criteria (A01, AO2, AO2, AO2, AO3), each out of 12 (Total 60).\nUse a \'Best Fit\' marking method to provide a grade.\nProvide feedback on how to move from Level 2 to Level 3.\n\nStudent Draft:\n${text}\n\nRespond in the following JSON format ONLY:\n{\n  \"scores\": {\n    \"ao1_knowledge\": { \"score\": number, \"feedback\": \"string\" },\n    \"ao2_observation\": { \"score\": number, \"feedback\": \"string\" },\n    \"ao2_organisation\": { \"score\": number, \"feedback\": \"string\" },\n    \"ao2_analysis\": { \"score\": number, \"feedback\": \"string\" },\n    \"ao3_conclusion\": { \"score\": number, \"feedback\": \"string\" }\n  },\n  \"total_score\": number,\n  \"grade_indication\": \"string (e.g. Solid B / Entry A)\",\n  \"annotations\": [\n    {\n      \"criteria\": \"string (e.g. AO2 Organisation)\",\n      \"quote\": \"string (excerpt from text)\",\n      \"comment\": \"string (your comment)\"\n    }\n  ],\n  \"roadmap\": [\n    {\n      \"criteria\": \"string (e.g. Data Presentation)\",\n      \"suggestion\": \"string\"\n    }\n  ],\n  \"moderation_log\": [\n    { \"type\": \"positive\" | \"negative\", \"criteria\": \"AO1\", \"comment\": \"string\" }\n  ]\n}`;\n\n      const response = await ai.models.generateContent({\n        model: \"gemini-3.1-pro\",\n        contents: prompt,\n        config: {\n            responseMimeType: \"application/json\",\n        }\n      });\n      \n      if (!response.text) throw new Error(\"No text in response\");\n      \n      const result = JSON.parse(response.text);\n      res.json(result);\n      \n    } catch (error) {\n      console.error(error);\n      res.status(500).json({ error: \"Failed to evaluate coursework.\" });\n    }\n  });\n\n  if (process.env.NODE_ENV !== \"production\") {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \"spa\",\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.join(process.cwd(), \"dist\");\n    app.use(express.static(distPath));\n    app.get(\"*\", (req, res) => {\n      res.sendFile(path.join(distPath, \"index.html\"));\n    });\n  }\n\n  app.listen(PORT, \"0.0.0.0\", () => {\n    console.log(`Server running on http://localhost:${PORT}`);\n  });\n}\n\nstartServer();"
    }
