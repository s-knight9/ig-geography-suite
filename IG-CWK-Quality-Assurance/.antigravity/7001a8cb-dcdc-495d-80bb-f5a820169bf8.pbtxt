      target_content: "const STORAGE_KEY = \"ig_cwk_directory_data\";\n\nexport function loadDirectoryData(): StudentSubmission[] {"
      replacement_content: "export interface DirectoryStructure {\n  classes: string[];\n  assignments: Record<string, string[]>;\n}\n\nconst STRUCT_STORAGE_KEY = \"ig_cwk_structure\";\n\nexport function loadStructure(): DirectoryStructure {\n  const data = localStorage.getItem(STRUCT_STORAGE_KEY);\n  if (!data) return { classes: [], assignments: {} };\n  try {\n    return JSON.parse(data);\n  } catch {\n    return { classes: [], assignments: {} };\n  }\n}\n\nexport function saveStructure(data: DirectoryStructure) {\n  localStorage.setItem(STRUCT_STORAGE_KEY, JSON.stringify(data));\n}\n\nexport function renameClass(oldName: string, newName: string) {\n  // Update explicitly saved structure\n  const struct = loadStructure();\n  const classIdx = struct.classes.indexOf(oldName);\n  if (classIdx >= 0) {\n    struct.classes[classIdx] = newName;\n  }\n  if (struct.assignments[oldName]) {\n    struct.assignments[newName] = struct.assignments[oldName];\n    delete struct.assignments[oldName];\n  }\n  saveStructure(struct);\n\n  // Update all submission entries\n  const data = loadDirectoryData();\n  let changed = false;\n  for (const s of data) {\n    if (s.className === oldName) {\n      s.className = newName;\n      changed = true;\n    }\n  }\n  if (changed) saveDirectoryData(data);\n}\n\nexport function renameAssignment(className: string, oldName: string, newName: string) {\n  const struct = loadStructure();\n  if (struct.assignments[className]) {\n    const idx = struct.assignments[className].indexOf(oldName);\n    if (idx >= 0) {\n      struct.assignments[className][idx] = newName;\n      saveStructure(struct);\n    }\n  }\n\n  const data = loadDirectoryData();\n  let changed = false;\n  for (const s of data) {\n    if (s.className === className && s.assignmentName === oldName) {\n      s.assignmentName = newName;\n      changed = true;\n    }\n  }\n  if (changed) saveDirectoryData(data);\n}\n\nexport function deleteClass(className: string) {\n  const struct = loadStructure();\n  struct.classes = struct.classes.filter(c => c !== className);\n  delete struct.assignments[className];\n  saveStructure(struct);\n\n  const data = loadDirectoryData();\n  const filtered = data.filter(s => s.className !== className);\n  if (filtered.length !== data.length) {\n    saveDirectoryData(filtered);\n  }\n}\n\nexport function deleteAssignment(className: string, assignmentName: string) {\n  const struct = loadStructure();\n  if (struct.assignments[className]) {\n    struct.assignments[className] = struct.assignments[className].filter(a => a !== assignmentName);\n    saveStructure(struct);\n  }\n\n  const data = loadDirectoryData();\n  const filtered = data.filter(s => !(s.className === className && s.assignmentName === assignmentName));\n  if (filtered.length !== data.length) {\n    saveDirectoryData(filtered);\n  }\n}"
    }
