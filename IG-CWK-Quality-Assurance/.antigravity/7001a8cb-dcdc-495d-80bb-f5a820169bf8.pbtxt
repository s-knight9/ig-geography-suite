  file_change {
    absolute_path_uri: "file:///src/components/UploadView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { FolderOpen, Moon, LogOut, FileText, Upload } from \'lucide-react\';\n\ninterface UploadViewProps {\n  onUploadComplete: (text: string, title: string) => void;\n  onLogout: () => void;\n}\n\nexport default function UploadView({ onUploadComplete, onLogout }: UploadViewProps) {\n  const [forename, setForename] = React.useState(\'\');\n  const [surname, setSurname] = React.useState(\'\');\n  const [preferredName, setPreferredName] = React.useState(\'\');\n  const [submissionType, setSubmissionType] = React.useState<\'DRAFT\' | \'FINAL\'>(\'DRAFT\');\n  const [analysisMode, setAnalysisMode] = React.useState<\'SINGLE\' | \'COMPARE\'>(\'SINGLE\');\n\n  const handleFileUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (file) {\n      // In a real app, we would parse the PDF here or send it to the backend.\n      // For now, we will just simulate extracting text or pass a placeholder.\n      // We can use a FileReader to read text if it was a txt, but for PDF we\'d hit our backend endpoint.\n      \n      const formData = new FormData();\n      formData.append(\'document\', file);\n      \n      try {\n        // Quick simulate for now to transition\n        const mockText = \"This is a simulated extraction of the uploaded coursework document...\";\n        const docTitle = `${forename || \'Unknown\'} ${surname || \'Student\'} - ${submissionType}`;\n        onUploadComplete(mockText, docTitle);\n      } catch (error) {\n        console.error(\"Upload failed\", error);\n      }\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#f8f9fc] flex flex-col font-sans\">\n      {/* Top Header */}\n      <header className=\"bg-white border-b border-slate-200 h-20 px-8 flex items-center justify-between shrink-0\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"w-12 h-12 bg-blue-600 rounded-xl flex items-center justify-center shadow-sm\">\n            <span className=\"text-white text-2xl font-bold tracking-tight\">IG</span>\n          </div>\n          <div className=\"flex flex-col\">\n            <h1 className=\"text-[22px] font-black text-blue-600 uppercase tracking-tight leading-tight\">CWK QUALITY ASSURANCE</h1>\n            <p className=\"text-[10px] font-bold text-slate-400 uppercase tracking-widest\">GRADING & MODERATION SUITE</p>\n          </div>\n        </div>\n        \n        <div className=\"flex items-center gap-3\">\n          <button className=\"w-10 h-10 rounded-full border border-slate-200 flex items-center justify-center text-slate-500 hover:bg-slate-50 transition-colors\">\n            <FolderOpen className=\"w-4 h-4\" />\n          </button>\n          <button className=\"w-10 h-10 rounded-full border border-slate-200 flex items-center justify-center text-slate-500 hover:bg-slate-50 transition-colors\">\n            <Moon className=\"w-4 h-4\" />\n          </button>\n          <button \n            onClick={onLogout}\n            className=\"h-10 px-4 rounded-full border border-slate-200 flex items-center justify-center text-red-500 hover:bg-red-50 transition-colors font-bold text-xs\"\n          >\n            EXIT\n          </button>\n          <div className=\"h-10 px-4 rounded-lg bg-slate-50 border border-slate-200 flex flex-col items-end justify-center ml-2\">\n            <span className=\"text-[9px] font-bold text-slate-400 leading-none\">STANDARD</span>\n            <span className=\"text-xs font-bold text-slate-700 leading-tight\">MAY 2026</span>\n          </div>\n        </div>\n      </header>\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 p-8 flex justify-center\">\n        <div className=\"max-w-6xl w-full\">\n          <div className=\"bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col\">\n            \n            {/* Card Header */}\n            <div className=\"px-8 py-4 border-b border-slate-100 flex justify-between items-center bg-white shrink-0\">\n              <div className=\"flex items-center gap-2 text-blue-600\">\n                <FileText className=\"w-5 h-5\" />\n                <span className=\"font-bold text-sm tracking-wide\">CWK UPLOAD ENTRY</span>\n              </div>\n              \n              <div className=\"flex items-center gap-4\">\n                <div className=\"bg-slate-100 p-1 rounded-lg flex border border-slate-200/60\">\n                  <button \n                    className={`px-4 py-1.5 rounded-md text-[11px] font-bold transition-all ${analysisMode === \'SINGLE\' ? \'bg-white shadow-sm text-slate-800\' : \'text-slate-500 hover:text-slate-700\'}`}\n                    onClick={() => setAnalysisMode(\'SINGLE\')}\n                  >\n                    SINGLE ANALYSIS\n                  </button>\n                  <button \n                    className={`px-4 py-1.5 rounded-md text-[11px] font-bold transition-all ${analysisMode === \'COMPARE\' ? \'bg-white shadow-sm text-slate-800\' : \'text-slate-500 hover:text-slate-700\'}`}\n                    onClick={() => setAnalysisMode(\'COMPARE\')}\n                  >\n                    COMPARE 2 CWKs\n                  </button>\n                </div>\n                \n                <div className=\"bg-blue-100 text-blue-700 px-4 py-1.5 rounded-md text-[11px] font-bold tracking-widest border border-blue-200/50\">\n                  READY\n                </div>\n              </div>\n            </div>\n\n            {/* Card Body */}\n            <div className=\"p-8\">\n              \n              {/* Form Row 1 */}\n              <div className=\"grid grid-cols-3 gap-6 mb-8\">\n                <div className=\"flex flex-col gap-2\">\n                  <label className=\"text-[11px] font-bold text-slate-500 tracking-wider\">\n                    FORENAME <span className=\"text-red-500\">*</span>\n                  </label>\n                  <input \n                    type=\"text\" \n                    placeholder=\"e.g. Jane\"\n                    value={forename}\n                    onChange={(e) => setForename(e.target.value)}\n                    className=\"border border-slate-200 rounded-lg px-4 py-3 outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100 transition-all font-medium text-slate-700 placeholder:text-slate-300\"\n                  />\n                </div>\n                <div className=\"flex flex-col gap-2\">\n                  <label className=\"text-[11px] font-bold text-slate-500 tracking-wider\">\n                    SURNAME <span className=\"text-red-500\">*</span>\n                  </label>\n                  <input \n                    type=\"text\" \n                    placeholder=\"e.g. Doe\"\n                    value={surname}\n                    onChange={(e) => setSurname(e.target.value)}\n                    className=\"border border-slate-200 rounded-lg px-4 py-3 outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100 transition-all font-medium text-slate-700 placeholder:text-slate-300\"\n                  />\n                </div>\n                <div className=\"flex flex-col gap-2\">\n                  <label className=\"text-[11px] font-bold text-slate-500 tracking-wider\">\n                    PREFERRED NAME <span className=\"text-red-500\">*</span>\n                  </label>\n                  <input \n                    type=\"text\" \n                    placeholder=\"e.g. Janie\"\n                    value={preferredName}\n                    onChange={(e) => setPreferredName(e.target.value)}\n                    className=\"border border-slate-200 rounded-lg px-4 py-3 outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100 transition-all font-medium text-slate-700 placeholder:text-slate-300\"\n                  />\n                </div>\n              </div>\n\n              {/* Form Row 2 */}\n              <div className=\"mb-10\">\n                <label className=\"text-[11px] font-bold text-slate-500 tracking-wider block mb-2\">\n                  SUBMISSION TYPE\n                </label>\n                <div className=\"bg-slate-50 p-1 rounded-xl flex border border-slate-200/60 w-fit\">\n                  <button \n                    className={`px-8 py-2.5 rounded-lg text-xs font-bold transition-all ${submissionType === \'DRAFT\' ? \'bg-white shadow border border-slate-200/50 text-blue-600\' : \'text-slate-500 hover:text-slate-700\'}`}\n                    onClick={() => setSubmissionType(\'DRAFT\')}\n                  >\n                    DRAFT\n                  </button>\n                  <button \n                    className={`px-8 py-2.5 rounded-lg text-xs font-bold transition-all ${submissionType === \'FINAL\' ? \'bg-white shadow border border-slate-200/50 text-blue-600\' : \'text-slate-500 hover:text-slate-700\'}`}\n                    onClick={() => setSubmissionType(\'FINAL\')}\n                  >\n                    FINAL\n                  </button>\n                </div>\n              </div>\n\n              {/* Dropzone */}\n              <label className=\"border-2 border-dashed border-slate-300 hover:border-blue-400 rounded-2xl py-24 flex flex-col items-center justify-center bg-slate-50/50 hover:bg-blue-50/20 transition-all cursor-pointer group\">\n                <input \n                  type=\"file\" \n                  accept=\".pdf\" \n                  className=\"hidden\" \n                  onChange={handleFileUpload}\n                />\n                <div className=\"bg-slate-100 group-hover:bg-blue-100 text-slate-400 group-hover:text-blue-500 p-4 rounded-2xl w-16 h-16 mb-4 flex items-center justify-center transition-colors\">\n                  <Upload className=\"w-8 h-8\" />\n                </div>\n                <h3 className=\"text-2xl font-bold text-slate-700 mb-2 group-hover:text-slate-800 transition-colors\">Click to upload candidate CWK</h3>\n                <p className=\"text-slate-400 font-medium\">Only PDF files are supported</p>\n              </label>\n\n            </div>\n          </div>\n        </div>\n      </main>\n    </div>\n  );\n}\n"
    }
