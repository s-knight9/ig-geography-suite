  file_change {
    absolute_path_uri: "file:///src/components/ArchiveModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { X, Plus } from \'lucide-react\';\n\ninterface ArchiveModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  initialCandidateName: string;\n  onSave: (data: any) => void;\n}\n\nexport default function ArchiveModal({ isOpen, onClose, initialCandidateName, onSave }: ArchiveModalProps) {\n  const [step, setStep] = useState(1);\n  const [candidateName, setCandidateName] = useState(initialCandidateName);\n  const [submissionType, setSubmissionType] = useState<\'Draft\' | \'Final\'>(\'Draft\');\n  \n  // Mock local data for classes and assignments\n  const [classes, setClasses] = useState([\'CHE\', \'SMK\', \'SKN\']);\n  const [assignments, setAssignments] = useState<Record<string, string[]>>({\n    \'SKN\': [\'Y13 IA Final (2026)\', \'Y12 Core Draft\'],\n    \'CHE\': [\'Y13 Coursework\'],\n    \'SMK\': [\'Y12 Fieldwork\']\n  });\n\n  const [selectedClass, setSelectedClass] = useState(\'\');\n  const [selectedAssignment, setSelectedAssignment] = useState(\'\');\n\n  const [isAddingClass, setIsAddingClass] = useState(false);\n  const [newClassName, setNewClassName] = useState(\'\');\n\n  const [isAddingAssignment, setIsAddingAssignment] = useState(false);\n  const [newAssignmentName, setNewAssignmentName] = useState(\'\');\n\n  useEffect(() => {\n    if (isOpen) {\n      setStep(1);\n      setCandidateName(initialCandidateName);\n      setSubmissionType(\'Draft\');\n      setSelectedClass(\'\');\n      setSelectedAssignment(\'\');\n      setIsAddingClass(false);\n      setIsAddingAssignment(false);\n    }\n  }, [isOpen, initialCandidateName]);\n\n  if (!isOpen) return null;\n\n  const handleNext = () => setStep(s => Math.min(s + 1, 3));\n  const handleBack = () => setStep(s => Math.max(s - 1, 1));\n\n  const handleAddClass = () => {\n    if (newClassName.trim() && !classes.includes(newClassName.trim())) {\n      setClasses([...classes, newClassName.trim()]);\n      setSelectedClass(newClassName.trim());\n      setAssignments({ ...assignments, [newClassName.trim()]: [] });\n    }\n    setIsAddingClass(false);\n    setNewClassName(\'\');\n  };\n\n  const handleAddAssignment = () => {\n    if (newAssignmentName.trim() && selectedClass) {\n      const currentAssignments = assignments[selectedClass] || [];\n      if (!currentAssignments.includes(newAssignmentName.trim())) {\n        setAssignments({\n          ...assignments,\n          [selectedClass]: [...currentAssignments, newAssignmentName.trim()]\n        });\n        setSelectedAssignment(newAssignmentName.trim());\n      }\n    }\n    setIsAddingAssignment(false);\n    setNewAssignmentName(\'\');\n  };\n\n  const handleCommit = () => {\n    onSave({\n      candidateName,\n      submissionType,\n      classFolder: selectedClass,\n      assignmentName: selectedAssignment\n    });\n    onClose();\n  };\n\n  const isStep2Valid = selectedClass && (assignments[selectedClass]?.length === 0 ? true : selectedAssignment);\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4\">\n      <div className=\"bg-white rounded-xl shadow-2xl w-full max-w-lg overflow-hidden border border-slate-200\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between p-6 pb-2\">\n          <h2 className=\"text-xl font-bold flex items-center gap-2 text-slate-800\">\n            <svg className=\"w-5 h-5 text-[#00bda5]\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"2\">\n              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z\" />\n            </svg>\n            Archive Assessment\n          </h2>\n          <button onClick={onClose} className=\"text-slate-400 hover:text-slate-600 transition-colors\">\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Progress Bar */}\n        <div className=\"px-6 py-4 flex gap-2\">\n          <div className={`h-1 flex-1 rounded-full ${step >= 1 ? \'bg-[#00bda5]\' : \'bg-slate-100\'}`} />\n          <div className={`h-1 flex-1 rounded-full ${step >= 2 ? \'bg-[#00bda5]\' : \'bg-slate-100\'}`} />\n          <div className={`h-1 flex-1 rounded-full ${step >= 3 ? \'bg-[#00bda5]\' : \'bg-slate-100\'}`} />\n        </div>\n\n        {/* Content Body */}\n        <div className=\"px-6 py-4 min-h-[220px]\">\n          {step === 1 && (\n            <div className=\"space-y-6\">\n              <div>\n                <label className=\"block text-xs font-bold text-slate-500 tracking-widest uppercase mb-2\">Candidate Identity</label>\n                <input\n                  type=\"text\"\n                  className=\"w-full px-4 py-3 border border-[#00bda5] rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00bda5]/20 text-slate-800 font-medium\"\n                  value={candidateName}\n                  onChange={(e) => setCandidateName(e.target.value)}\n                  placeholder=\"Type name to continue\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-500 tracking-widest uppercase mb-3\">Submission Type</label>\n                <div className=\"flex items-center gap-6\">\n                  <label className=\"flex items-center gap-2 cursor-pointer\">\n                    <input\n                      type=\"radio\"\n                      name=\"submissionType\"\n                      className=\"w-4 h-4 text-[#00bda5] border-slate-300 focus:ring-[#00bda5] accent-[#00bda5]\"\n                      checked={submissionType === \'Draft\'}\n                      onChange={() => setSubmissionType(\'Draft\')}\n                    />\n                    <span className=\"text-slate-700 font-medium text-sm\">Draft</span>\n                  </label>\n                  <label className=\"flex items-center gap-2 cursor-pointer\">\n                    <input\n                      type=\"radio\"\n                      name=\"submissionType\"\n                      className=\"w-4 h-4 text-[#00bda5] border-slate-300 focus:ring-[#00bda5] accent-[#00bda5]\"\n                      checked={submissionType === \'Final\'}\n                      onChange={() => setSubmissionType(\'Final\')}\n                    />\n                    <span className=\"text-slate-700 font-medium text-sm\">Final</span>\n                  </label>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {step === 2 && (\n            <div className=\"space-y-6\">\n              <div>\n                <label className=\"block text-xs font-bold text-slate-500 tracking-widest uppercase mb-2\">Class Folder</label>\n                {!isAddingClass ? (\n                  <div className=\"flex gap-2\">\n                    <select\n                      className={`flex-1 px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00bda5]/20 text-slate-800 font-medium appearance-none bg-white ${selectedClass ? \'border-[#00bda5]\' : \'border-[#00bda5]\'}`}\n                      value={selectedClass}\n                      onChange={(e) => {\n                        setSelectedClass(e.target.value);\n                        setSelectedAssignment(\'\');\n                      }}\n                    >\n                      <option value=\"\" disabled>Select a Class...</option>\n                      {classes.map(c => (\n                        <option key={c} value={c}>{c}</option>\n                      ))}\n                    </select>\n                    <button\n                      onClick={() => setIsAddingClass(true)}\n                      className=\"w-12 flex-shrink-0 bg-[#00bda5]/10 text-[#00bda5] hover:bg-[#00bda5]/20 rounded-lg flex items-center justify-center transition-colors\"\n                    >\n                      <Plus className=\"w-5 h-5\" />\n                    </button>\n                  </div>\n                ) : (\n                  <div className=\"flex gap-2 items-center\">\n                    <input\n                      autoFocus\n                      type=\"text\"\n                      placeholder=\"New Class Name...\"\n                      className=\"flex-1 px-4 py-3 border border-[#00bda5] rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00bda5]/20 text-slate-800 font-medium\"\n                      value={newClassName}\n                      onChange={(e) => setNewClassName(e.target.value)}\n                      onKeyDown={(e) => e.key === \'Enter\' && handleAddClass()}\n                    />\n                    <div className=\"flex flex-col gap-1\">\n                      <button onClick={handleAddClass} className=\"text-xs font-bold text-[#00bda5] uppercase hover:underline\">Add</button>\n                      <button onClick={() => setIsAddingClass(false)} className=\"text-xs font-bold text-slate-400 border-none bg-transparent hover:underline text-left\">Cancel</button>\n                    </div>\n                  </div>\n                )}\n              </div>\n\n              {selectedClass && (\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-500 tracking-widest uppercase mb-2\">Assignment Name</label>\n                  {!isAddingAssignment ? (\n                    <div className=\"flex gap-2\">\n                      <select\n                        className={`flex-1 px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00bda5]/20 text-slate-800 font-medium appearance-none bg-white ${selectedAssignment ? \'border-slate-200\' : \'border-slate-200\'}`}\n                        value={selectedAssignment}\n                        onChange={(e) => setSelectedAssignment(e.target.value)}\n                      >\n                        <option value=\"\" disabled>Select Assignment...</option>\n                        {(assignments[selectedClass] || []).map(a => (\n                          <option key={a} value={a}>{a}</option>\n                        ))}\n                      </select>\n                      <button\n                        onClick={() => setIsAddingAssignment(true)}\n                        className=\"w-12 flex-shrink-0 bg-[#00bda5]/10 text-[#00bda5] hover:bg-[#00bda5]/20 rounded-lg flex items-center justify-center transition-colors\"\n                      >\n                        <Plus className=\"w-5 h-5\" />\n                      </button>\n                    </div>\n                  ) : (\n                    <div className=\"flex gap-2 items-center\">\n                      <input\n                        autoFocus\n                        type=\"text\"\n                        placeholder=\"New Assignment...\"\n                        className=\"flex-1 px-4 py-3 border border-[#00bda5] rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00bda5]/20 text-slate-800 font-medium\"\n                        value={newAssignmentName}\n                        onChange={(e) => setNewAssignmentName(e.target.value)}\n                        onKeyDown={(e) => e.key === \'Enter\' && handleAddAssignment()}\n                      />\n                       <div className=\"flex flex-col gap-1\">\n                        <button onClick={handleAddAssignment} className=\"text-xs font-bold text-[#00bda5] uppercase hover:underline\">Add</button>\n                        <button onClick={() => setIsAddingAssignment(false)} className=\"text-xs font-bold text-slate-400 border-none bg-transparent hover:underline text-left\">Cancel</button>\n                      </div>\n                    </div>\n                  )}\n                </div>\n              )}\n            </div>\n          )}\n\n          {step === 3 && (\n            <div className=\"space-y-4 pt-2\">\n               <div className=\"border border-slate-100 rounded-xl overflow-hidden shadow-sm\">\n                  <div className=\"bg-slate-50 px-5 py-3 border-b border-slate-100\">\n                    <p className=\"text-xs font-bold tracking-widest text-slate-400 uppercase\">Summary</p>\n                  </div>\n                  <div className=\"p-5 space-y-4\">\n                     <div className=\"flex justify-between items-center\">\n                        <span className=\"text-sm text-slate-500\">Candidate:</span>\n                        <span className=\"text-sm font-bold text-slate-900\">{candidateName}</span>\n                     </div>\n                     <div className=\"flex justify-between items-center\">\n                        <span className=\"text-sm text-slate-500\">Submission Type:</span>\n                        <span className=\"text-[10px] font-bold uppercase tracking-wider bg-[#00bda5]/10 text-[#00bda5] px-2.5 py-1 rounded-full\">{submissionType}</span>\n                     </div>\n                     <div className=\"flex justify-between items-center\">\n                        <span className=\"text-sm text-slate-500\">Class:</span>\n                        <span className=\"text-sm font-bold text-slate-900\">{selectedClass}</span>\n                     </div>\n                     <div className=\"flex justify-between items-center\">\n                        <span className=\"text-sm text-slate-500\">Assignment:</span>\n                        <span className=\"text-sm font-bold text-[#00bda5]\">{selectedAssignment || \'N/A\'}</span>\n                     </div>\n                  </div>\n               </div>\n            </div>\n          )}\n        </div>\n\n        {/* Footer actions */}\n        <div className=\"px-6 py-6 flex items-center justify-between mt-2\">\n          {step === 1 ? (\n             <button onClick={onClose} className=\"text-sm font-bold text-slate-500 hover:text-slate-700 transition-colors uppercase tracking-wider\">\n               Cancel\n             </button>\n          ) : (\n             <button onClick={handleBack} className=\"text-sm font-bold text-slate-500 hover:text-slate-700 transition-colors uppercase tracking-wider\">\n               Back\n             </button>\n          )}\n\n          {step < 3 ? (\n             <button \n                onClick={handleNext} \n                disabled={step === 1 ? !candidateName.trim() : !isStep2Valid}\n                className=\"bg-[#00bda5] hover:bg-[#00a893] text-white px-6 py-3 rounded-lg text-sm font-bold uppercase tracking-wider shadow-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed\"\n             >\n               Continue\n             </button>\n          ) : (\n             <button \n                onClick={handleCommit} \n                className=\"bg-[#00bda5] hover:bg-[#00a893] text-white px-6 py-3 rounded-lg text-sm font-bold uppercase tracking-wider shadow-sm transition-colors\"\n             >\n               Commit Save\n             </button>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    }
