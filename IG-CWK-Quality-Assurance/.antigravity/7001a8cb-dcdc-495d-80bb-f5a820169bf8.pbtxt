er-blue-300 transition-all text-left mt-2 group\">\n                    <div className=\"flex flex-col\">\n                      <span className=\"font-bold text-slate-700 dark:text-slate-200 text-sm\">{a}</span>\n                      <span className=\"text-[10px] uppercase font-bold text-slate-400 tracking-widest mt-1\">Assignment Folder</span>\n                    </div>\n                    <ChevronRight className=\"w-4 h-4 text-slate-300 group-hover:text-blue-500\" />\n                  </button>\n                ))}\n              </div>\n            </div>"
      replacement_content: "            <div className=\"space-y-3\">\n              <div className=\"flex items-center justify-between px-2 mb-2\">\n                <h3 className=\"text-xs font-bold text-slate-400 uppercase tracking-widest\">Classes</h3>\n                <button onClick={() => {\n                  const name = prompt(\"Enter new class name:\");\n                  if (name && name.trim()) {\n                    createClass(name.trim());\n                    refreshData();\n                  }\n                }} className=\"text-blue-500 hover:bg-blue-50 dark:hover:bg-blue-900/30 p-1 rounded-md transition-colors\">\n                  <Plus className=\"w-4 h-4\" />\n                </button>\n              </div>\n              {classes.length === 0 && <p className=\"text-slate-500 text-sm px-2\">No folders created yet. Save an assessment to create folders.</p>}\n              {classes.map(c => (\n                <SwipeableItem \n                   key={c}\n                   name={c}\n                   isSelected={false}\n                   onClick={() => setSelectedClass(c)}\n                   onRename={(newN: string) => { renameClass(c, newN); refreshData(); }}\n                   onDelete={() => { deleteClass(c); refreshData(); }}\n                   icon={Folder}\n                   rightIcon={ChevronRight}\n                />\n              ))}\n            </div>\n          ) : !selectedAssignment ? (\n            <div className=\"space-y-3\">\n              <button onClick={() => setSelectedClass(null)} className=\"text-xs font-bold text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 uppercase tracking-widest mb-2 px-2 flex items-center gap-1\">\n                <ChevronLeft className=\"w-3 h-3\" /> Back to Classes\n              </button>\n              <h3 className=\"text-xl font-bold text-slate-800 dark:text-slate-100 px-2 flex items-center gap-2\">\n                <Folder className=\"w-5 h-5 text-blue-500\" /> {selectedClass}\n              </h3>\n              <div className=\"flex items-center justify-between px-2 mt-4 mb-2\">\n                <span className=\"text-xs font-bold text-slate-400 uppercase tracking-widest\">Assignments</span>\n                <button onClick={() => {\n                  const name = prompt(\"Enter new assignment name:\");\n                  if (name && name.trim() && selectedClass) {\n                    createAssignment(selectedClass, name.trim());\n                    refreshData();\n                  }\n                }} className=\"text-blue-500 hover:bg-blue-50 dark:hover:bg-blue-900/30 p-1 rounded-md transition-colors\">\n                  <Plus className=\"w-4 h-4\" />\n                </button>\n              </div>\n              <div className=\"pt-2\">\n                {assignmentsForClass.map(a => (\n                  <SwipeableItem \n                     key={a}\n                     name={a}\n                     subtitle=\"Assignment Folder\"\n                     isSelected={false}\n                     onClick={() => setSelectedAssignment(a)}\n                     onRename={(newN: string) => { if(selectedClass) renameAssignment(selectedClass, a, newN); refreshData(); }}\n                     onDelete={() => { if(selectedClass) deleteAssignment(selectedClass, a); refreshData(); }}\n                     icon={Folder}\n                     rightIcon={ChevronRight}\n                  />\n                ))}\n              </div>\n            </div>"
