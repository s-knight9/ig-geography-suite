    replacement_chunks {
      target_content: "import { Check, BarChart2 } from \'lucide-react\';\n\nexport default function App() {\n  return (\n    <div className=\"w-screen h-screen bg-white flex flex-col font-sans text-slate-900 overflow-hidden border border-slate-200\">\n      {/* Header Navigation */}\n      <header className=\"h-16 border-b border-slate-100 px-8 flex items-center justify-between bg-white shrink-0 shadow-sm\">\n        <div className=\"flex items-center space-x-4\">\n          <div className=\"w-10 h-10 bg-[#5cb36d] rounded-2xl flex items-center justify-center text-white font-bold text-xl border-[3px] border-emerald-50 shadow-sm leading-none pt-0.5\">\n            DP\n          </div>\n          <h1 className=\"text-lg font-semibold tracking-tight text-slate-800\">\n            Infographic Generator\n          </h1>\n        </div>\n        <div className=\"flex items-center space-x-3\">\n          <span className=\"flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse\"></span>\n          <span className=\"text-xs font-medium uppercase tracking-widest text-slate-500\">\n            Model Training Active\n          </span>\n        </div>\n      </header>\n\n      {/* Main Workspace */}\n      <div className=\"flex-1 flex overflow-hidden bg-slate-50\">\n        {/* Sidebar: Dataset Inventory */}\n        <aside className=\"w-72 bg-white border-r border-slate-200 p-6 flex flex-col\">\n          <div className=\"mb-8\">\n            <label className=\"text-[10px] font-bold uppercase tracking-widest text-slate-400 block mb-4\">\n              Training Queue\n            </label>\n            <nav className=\"space-y-1\">\n              <div className=\"group flex items-center p-3 rounded-lg bg-emerald-50 border border-emerald-100\">\n                <div className=\"w-6 h-6 rounded border border-emerald-200 flex items-center justify-center bg-white text-[10px] font-bold text-emerald-600 mr-3\">\n                  01\n                </div>\n                <div className=\"text-sm font-medium text-emerald-900\">\n                  Hydrological Cycles\n                </div>\n                <div className=\"ml-auto text-emerald-500\">\n                  <Check className=\"w-4 h-4\" />\n                </div>\n              </div>\n              <div className=\"group flex items-center p-3 rounded-lg hover:bg-slate-50 transition-colors cursor-pointer\">\n                <div className=\"w-6 h-6 rounded border border-slate-200 flex items-center justify-center bg-white text-[10px] font-bold text-slate-400 mr-3\">\n                  02\n                </div>\n                <div className=\"text-sm font-medium text-slate-600\">\n                  Urban Stress Patterns\n                </div>\n                <div className=\"ml-auto text-emerald-500\">\n                  <Check className=\"w-4 h-4\" />\n                </div>\n              </div>\n              <div className=\"group flex items-center p-3 rounded-lg hover:bg-slate-50 transition-colors cursor-pointer\">\n                <div className=\"w-6 h-6 rounded border border-slate-200 flex items-center justify-center bg-white text-[10px] font-bold text-slate-400 mr-3\">\n                  03\n                </div>\n                <div className=\"text-sm font-medium text-slate-600\">\n                  GNI & HDI Disparities\n                </div>\n                <div className=\"ml-auto text-emerald-500\">\n                  <Check className=\"w-4 h-4\" />\n                </div>\n              </div>\n            </nav>\n          </div>\n\n          <div className=\"mt-auto p-4 bg-slate-900 rounded-xl text-white\">\n            <div className=\"text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-2\">\n              Analysis Status\n            </div>\n            <div className=\"text-xs text-slate-300 leading-relaxed\">\n              All training examples processed. Engine calibrated for IB Command\n              Terms: <span className=\"text-emerald-400 italic\">Discuss, Examine, Evaluate</span>.\n            </div>\n          </div>\n        </aside>\n\n        {/* Content Area: Data Preview */}\n        <main className=\"flex-1 p-8 overflow-hidden flex flex-col space-y-6\">\n          {/* Top Info Card */}\n          <div className=\"bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex items-start space-x-6\">\n            <div className=\"w-40 h-40 bg-slate-100 rounded-lg flex items-center justify-center border-2 border-dashed border-slate-200\">\n              <div className=\"text-center flex flex-col items-center\">\n                <BarChart2 className=\"w-8 h-8 text-slate-400 mb-2\" />\n                <div className=\"text-[10px] font-semibold text-slate-400 uppercase\">\n                  Infographic 01\n                </div>\n              </div>\n            </div>\n            <div className=\"flex-1\">\n              <h2 className=\"text-xl font-bold text-slate-900 mb-2\">\n                Analysis of Global Water Stress (2020-2050)\n              </h2>\n              <p className=\"text-sm text-slate-500 leading-relaxed mb-4\">\n                The infographic showcases spatial variations in physical vs\n                economic water scarcity. AI has parsed 14 data points, 3 map\n                layers, and the accompanying choropleth legend.\n              </p>\n              <div className=\"flex space-x-4\">\n                <span className=\"px-2 py-1 bg-slate-100 text-[10px] font-bold rounded uppercase tracking-wide text-slate-600\">\n                  Unit 1: Freshwater\n                </span>\n                <span className=\"px-2 py-1 bg-slate-100 text-[10px] font-bold rounded uppercase tracking-wide text-slate-600\">\n                  HL Extension\n                </span>\n              </div>\n            </div>\n          </div>\n\n          {/* Detailed Breakdown Grid */}\n          <div className=\"flex-1 grid grid-cols-2 gap-6 min-h-0\">\n            {/* Left: Questions */}\n            <div className=\"bg-white border border-slate-200 rounded-2xl flex flex-col overflow-hidden\">\n              <div className=\"px-6 py-4 border-b border-slate-100 bg-slate-50/50\">\n                <h3 className=\"text-xs font-bold uppercase tracking-widest text-slate-400\">\n                  Calibrated Questions\n                </h3>\n              </div>\n              <div className=\"p-6 space-y-6 overflow-y-auto\">\n                <div className=\"space-y-2\">\n                  <p className=\"text-xs font-bold text-emerald-600\">[2 Marks]</p>\n                  <p className=\"text-sm italic text-slate-700\">\n                    \"Identify the region showing the highest projected increase\n                    in physical water scarcity between 2025 and 2050 based on\n                    Figure 1.\"\n                  </p>\n                </div>\n                <div className=\"space-y-2\">\n                  <p className=\"text-xs font-bold text-emerald-600\">[6 Marks]</p>\n                  <p className=\"text-sm italic text-slate-700\">\n                    \"Examine the relationship between GDP per capita and\n                    economic water scarcity as depicted in the infographic\n                    data.\"\n                  </p>\n                </div>\n              </div>\n            </div>\n\n            {/* Right: Markscheme */}\n            <div className=\"bg-white border border-slate-200 rounded-2xl flex flex-col overflow-hidden\">\n              <div className=\"px-6 py-4 border-b border-slate-100 bg-slate-50/50\">\n                <h3 className=\"text-xs font-bold uppercase tracking-widest text-slate-400\">\n                  Logic & Markscheme Calibration\n                </h3>\n              </div>\n              <div className=\"p-6 space-y-4 overflow-y-auto\">\n                <div className=\"p-4 bg-emerald-50 rounded-lg border border-emerald-100\">\n                  <div className=\"flex items-center text-emerald-800 text-xs font-bold mb-2\">\n                    <span>CRITERIA A: KNOWLEDGE</span>\n                    <span className=\"ml-auto\">SCORE: OPTIMAL</span>\n                  </div>\n                  <p className=\"text-xs text-emerald-700 leading-relaxed\">\n                    The engine has recognized the requirement for referencing\n                    specific map coordinates and quantitative data\n                    (m&sup3;/capita/year) in top-tier responses.\n                  </p>\n                </div>\n                <div className=\"space-y-2\">\n                  <p className=\"text-xs font-bold text-slate-400\">\n                    CALIBRATED RESPONSE PATHS:\n                  </p>\n                  <ul className=\"text-xs text-slate-600 space-y-2\">\n                    <li className=\"flex items-start\">\n                      <span className=\"mr-2 text-emerald-500\">&bull;</span>{\" \"}\n                      Synthesis of climate change factors\n                    </li>\n                    <li className=\"flex items-start\">\n                      <span className=\"mr-2 text-emerald-500\">&bull;</span>{\" \"}\n                      Population density correlation\n                    </li>\n                    <li className=\"flex items-start\">\n                      <span className=\"mr-2 text-emerald-500\">&bull;</span>{\" \"}\n                      Infrastructural investment impacts\n                    </li>\n                  </ul>\n                </div>\n              </div>\n            </div>\n          </div>\n        </main>\n      </div>\n\n      {/* Bottom Bar: User Interaction */}\n      <footer className=\"h-20 bg-white border-t border-slate-200 px-8 flex items-center justify-between shrink-0\">\n        <div className=\"text-xs text-slate-400 font-medium\">\n          Training Engine Version 4.2.0-Alpha &bull;{\" \"}\n          <span className=\"text-emerald-500 uppercase tracking-tighter\">\n            Ready to Proceed\n          </span>\n        </div>\n        <div className=\"flex space-x-4\">\n          <button className=\"px-6 py-2 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-50 transition-colors border border-slate-200\">\n            Re-analyze Datasets\n          </button>\n          <button className=\"px-8 py-2 rounded-lg text-sm font-semibold text-white bg-[#5cb36d] shadow-lg shadow-emerald-200 hover:bg-emerald-600 transition-all\">\n            Submit New Infographic\n          </button>\n        </div>\n      </footer>\n    </div>\n  );\n}"
      replacement_content: "import { Check, BarChart2, Upload, Loader2 } from \'lucide-react\';\nimport React, { useState, useRef } from \'react\';\n\ntype Question = {\n  marks: number;\n  text: string;\n};\n\ntype Markscheme = {\n  criteria: string;\n  paths: string[];\n};\n\ntype GenerationResult = {\n  questions: Question[];\n  markscheme: Markscheme;\n  summary: string;\n};\n\nexport default function App() {\n  const [isGenerating, setIsGenerating] = useState(false);\n  const [result, setResult] = useState<GenerationResult | null>(null);\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  const handleUploadClick = () => {\n    fileInputRef.current?.click();\n  };\n\n  const handleFileChange = async (event: React.ChangeEvent<HTMLInputElement>) => {\n    const file = event.target.files?.[0];\n    if (!file) return;\n\n    setIsGenerating(true);\n    const formData = new FormData();\n    formData.append(\'image\', file);\n\n    try {\n      const response = await fetch(\'/api/generate\', {\n        method: \'POST\',\n        body: formData,\n      });\n      \n      if (!response.ok) {\n        throw new Error(\'Generation failed\');\n      }\n\n      const data = await response.json();\n      setResult(data);\n    } catch (error) {\n      console.error(error);\n      alert(\'Failed to generate. Ensure API key is configured.\');\n    } finally {\n      setIsGenerating(false);\n      // Reset input so the same file could be uploaded again if needed\n      if (fileInputRef.current) {\n        fileInputRef.current.value = \'\';\n      }\n    }\n  };\n\n  return (\n    <div className=\"w-screen h-screen bg-white flex flex-col font-sans text-slate-900 overflow-hidden border border-slate-200\">\n      {/* Header Navigation */}\n      <header className=\"h-16 border-b border-slate-100 px-8 flex items-center justify-between bg-white shrink-0 shadow-sm\">\n        <div className=\"flex items-center space-x-4\">\n          <div className=\"w-10 h-10 bg-[#5cb36d] rounded-2xl flex items-center justify-center text-white font-bold text-xl border-[3px] border-emerald-50 shadow-sm leading-none pt-0.5\">\n            DP\n          </div>\n          <h1 className=\"text-lg font-semibold tracking-tight text-slate-800\">\n            Infographic Generator\n          </h1>\n        </div>\n        <div className=\"flex items-center space-x-3\">\n          <span className={`flex h-2 w-2 rounded-full ${isGenerating ? \'bg-amber-500 animate-pulse\' : \'bg-emerald-500\'}`}></span>\n          <span className=\"text-xs font-medium uppercase tracking-widest text-slate-500\">\n            {isGenerating ? \'Analyzing Infographic...\' : \'Model Training Active\'}\n          </span>\n        </div>\n      </header>\n\n      {/* Main Workspace */}\n      <div className=\"flex-1 flex overflow-hidden bg-slate-50\">\n        {/* Sidebar: Dataset Inventory */}\n        <aside className=\"w-72 bg-white border-r border-slate-200 p-6 flex flex-col\">\n          <div className=\"mb-8\">\n            <label className=\"text-[10px] font-bold uppercase tracking-widest text-slate-400 block mb-4\">\n              Training Queue\n            </label>\n            <nav className=\"space-y-1\">\n              <div className=\"group flex items-center p-3 rounded-lg bg-emerald-50 border border-emerald-100\">\n                <div className=\"w-6 h-6 rounded border border-emerald-200 flex items-center justify-center bg-white text-[10px] font-bold text-emerald-600 mr-3\">\n                  01\n                </div>\n                <div className=\"text-sm font-medium text-emerald-900\">\n                  Hydrological Cycles\n                </div>\n                <div className=\"ml-auto text-emerald-500\">\n                  <Check className=\"w-4 h-4\" />\n                </div>\n              </div>\n              <div className=\"group flex items-center p-3 rounded-lg hover:bg-slate-50 transition-colors cursor-pointer\">\n                <div className=\"w-6 h-6 rounded border border-slate-200 flex items-center justify-center bg-white text-[10px] font-bold text-slate-400 mr-3\">\n                  02\n                </div>\n                <div className=\"text-sm font-medium text-slate-600\">\n                  Urban Stress Patterns\n                </div>\n                <div className=\"ml-auto text-emerald-500\">\n                  <Check className=\"w-4 h-4\" />\n                </div>\n              </div>\n              <div className=\"group flex items-center p-3 rounded-lg hover:bg-slate-50 transition-colors cursor-pointer\">\n                <div className=\"w-6 h-6 rounded border border-slate-200 flex items-center justify-center bg-white text-[10px] font-bold text-slate-400 mr-3\">\n                  03\n                </div>\n                <div className=\"text-sm font-medium text-slate-600\">\n                  GNI & HDI Disparities\n                </div>\n                <div className=\"ml-auto text-emerald-500\">\n                  <Check className=\"w-4 h-4\" />\n                </div>\n              </div>\n            </nav>\n          </div>\n\n          <div className=\"mt-auto p-4 bg-slate-900 rounded-xl text-white\">\n            <div className=\"text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-2\">\n              Analysis Status\n            </div>\n            <div className=\"text-xs text-slate-300 leading-relaxed\">\n              All training examples processed. Engine calibrated for IB Command\n              Terms: <span className=\"text-emerald-400 italic\">Discuss, Examine, Evaluate</span>.\n            </div>\n          </div>\n        </aside>\n\n        {/* Content Area: Data Preview */}\n        <main className=\"flex-1 p-8 overflow-hidden flex flex-col space-y-6\">\n          {/* Top Info Card */}\n          <div className=\"bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex items-start space-x-6\">\n            <div className=\"w-40 h-40 bg-slate-100 rounded-lg flex items-center justify-center border-2 border-dashed border-slate-200\">\n              <div className=\"text-center flex flex-col items-center\">\n                <BarChart2 className=\"w-8 h-8 text-slate-400 mb-2\" />\n                <div className=\"text-[10px] font-semibold text-slate-400 uppercase\">\n                  Infographic {result ? \'Parsed\' : \'01\'}\n                </div>\n              </div>\n            </div>\n            <div className=\"flex-1\">\n              <h2 className=\"text-xl font-bold text-slate-900 mb-2\">\n                {result ? \'Analysis of Uploaded Infographic\' : \'Training Mode: Waiting for Input\'}\n              </h2>\n              <p className=\"text-sm text-slate-500 leading-relaxed mb-4\">\n                {result ? result.summary : \'Upload a new infographic to generate custom Paper 2 questions and a calibrated markscheme.\'}\n              </p>\n              <div className=\"flex space-x-4\">\n                <span className=\"px-2 py-1 bg-slate-100 text-[10px] font-bold rounded uppercase tracking-wide text-slate-600\">\n                  Unit: Auto-detected\n                </span>\n                <span className=\"px-2 py-1 bg-slate-100 text-[10px] font-bold rounded uppercase tracking-wide text-slate-600\">\n                  Paper 2\n                </span>\n              </div>\n            </div>\n          </div>\n\n          {/* Detailed Breakdown Grid */}\n          <div className=\"flex-1 grid grid-cols-2 gap-6 min-h-0\">\n            {/* Left: Questions */}\n            <div className=\"bg-white border border-slate-200 rounded-2xl flex flex-col overflow-hidden\">\n              <div className=\"px-6 py-4 border-b border-slate-100 bg-slate-50/50\">\n                <h3 className=\"text-xs font-bold uppercase tracking-widest text-slate-400\">\n                  Calibrated Questions\n                </h3>\n              </div>\n              <div className=\"p-6 space-y-6 overflow-y-auto\">\n                {isGenerating ? (\n                  <div className=\"flex items-center justify-center h-full text-slate-400\">\n                     <Loader2 className=\"w-6 h-6 animate-spin mr-2\" />\n                     <span className=\"text-sm font-medium\">Drafting questions...</span>\n                  </div>\n                ) : result ? (\n                  result.questions.map((q, i) => (\n                    <div key={i} className=\"space-y-2\">\n                      <p className=\"text-xs font-bold text-emerald-600\">[{q.marks} Marks]</p>\n                      <p className=\"text-sm italic text-slate-700\">\n                        \"{q.text}\"\n                      </p>\n                    </div>\n                  ))\n                ) : (\n                  <div className=\"flex items-center justify-center h-full text-slate-400 text-sm\">\n                    No questions generated yet.\n                  </div>\n                )}\n              </div>\n            </div>\n\n            {/* Right: Markscheme */}\n            <div className=\"bg-white border border-slate-200 rounded-2xl flex flex-col overflow-hidden\">\n              <div className=\"px-6 py-4 border-b border-slate-100 bg-slate-50/50\">\n                <h3 className=\"text-xs font-bold uppercase tracking-widest text-slate-400\">\n                  Logic & Markscheme Calibration\n                </h3>\n              </div>\n              <div className=\"p-6 space-y-4 overflow-y-auto\">\n                {isGenerating ? (\n                  <div className=\"flex items-center justify-center h-full text-slate-400\">\n                     <Loader2 className=\"w-6 h-6 animate-spin mr-2\" />\n                     <span className=\"text-sm font-medium\">Constructing markscheme...</span>\n                  </div>\n                ) : result && result.markscheme ? (\n                  <>\n                    <div className=\"p-4 bg-emerald-50 rounded-lg border border-emerald-100\">\n                      <div className=\"flex items-center text-emerald-800 text-xs font-bold mb-2\">\n                        <span>CRITERIA A: KNOWLEDGE</span>\n                        <span className=\"ml-auto\">SCORE: OPTIMAL</span>\n                      </div>\n                      <p className=\"text-xs text-emerald-700 leading-relaxed\">\n                        {result.markscheme.criteria}\n                      </p>\n                    </div>\n                    <div className=\"space-y-2\">\n                      <p className=\"text-xs font-bold text-slate-400\">\n                        CALIBRATED RESPONSE PATHS:\n                      </p>\n                      <ul className=\"text-xs text-slate-600 space-y-2\">\n                         {result.markscheme.paths.map((path, i) => (\n                          <li key={i} className=\"flex items-start\">\n                            <span className=\"mr-2 text-emerald-500\">&bull;</span>{\" \"}\n                            {path}\n                          </li>\n                         ))}\n                      </ul>\n                    </div>\n                  </>\n                ) : (\n                   <div className=\"flex items-center justify-center h-full text-slate-400 text-sm\">\n                    No markscheme generated yet.\n                  </div>\n                )}\n              </div>\n            </div>\n          </div>\n        </main>\n      </div>\n\n      {/* Bottom Bar: User Interaction */}\n      <footer className=\"h-20 bg-white border-t border-slate-200 px-8 flex items-center justify-between shrink-0\">\n        <div className=\"text-xs text-slate-400 font-medium\">\n          Training Engine Version 4.2.0-Alpha &bull;{\" \"}\n          <span className=\"text-emerald-500 uppercase tracking-tighter\">\n            Ready to Proceed\n          </span>\n        </div>\n        <div className=\"flex space-x-4\">\n          <input \n            type=\"file\" \n            ref={fileInputRef} \n            onChange={handleFileChange} \n            accept=\"image/*\" \n            className=\"hidden\" \n          />\n          <button className=\"px-6 py-2 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-50 transition-colors border border-slate-200\">\n             Re-analyze Datasets\n          </button>\n          <button \n            onClick={handleUploadClick}\n            disabled={isGenerating}\n            className=\"flex items-center px-8 py-2 rounded-lg text-sm font-semibold text-white bg-[#5cb36d] shadow-lg shadow-emerald-200 hover:bg-emerald-600 transition-all disabled:opacity-50\">\n            {isGenerating ? (\n              <Loader2 className=\"w-4 h-4 animate-spin mr-2\" />\n            ) : (\n              <Upload className=\"w-4 h-4 mr-2\" />\n            )}\n            {isGenerating ? \'Processing...\' : \'Submit New Infographic\'}\n          </button>\n        </div>\n      </footer>\n    </div>\n  );\n}"
    }
