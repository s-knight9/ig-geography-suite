ics_decorator.go:24\n  | google3/third_party/gemini_coder/framework/executor/executor.(*ExecutionWrapper).asyncHandleStep.func1\n  | \tthird_party/gemini_coder/framework/executor/execution_wrapper.go:317\n  | google3/go/context/detach.Go.func1\n  | \tgo/context/detach.go:250\n  | runtime.goexit\n  | \tthird_party/go/gc/src/runtime/asm_amd64.s:1736\n              \342\224\224\342\224\200 Wraps: (10) chunk 0\n                \342\224\224\342\224\200 Wraps: (11)\n                  \342\224\224\342\224\200 Wraps: (12) target content not found in file\nError types: (1) *go_utils.withTags (2) *withstack.withStack (3) *errutil.withPrefix (4) *utils.UserFacingHandlerError (5) *withstack.withStack (6) *errutil.withPrefix (7) *withstack.withStack (8) *join.joinError (9) *withstack.withStack (10) *errutil.withPrefix (11) *applyedit.repairFixableError (12) *applyedit.fastApplyFixableError"
