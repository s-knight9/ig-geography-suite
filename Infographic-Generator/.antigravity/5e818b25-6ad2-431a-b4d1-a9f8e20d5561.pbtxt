    instruction: "Adding entry management API endpoints (save, rename, delete) and serving static uploads."
    replacement_infos {
      original_chunk {
        target_content: "import express from \"express\";\nimport path from \"path\";\nimport { createServer as createViteServer } from \"vite\";\nimport multer from \"multer\";\nimport { GoogleGenAI } from \"@google/genai\";\n\nconst ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });\nconst upload = multer({ storage: multer.memoryStorage() });\n\nasync function startServer() {\n  const app = express();\n  const PORT = 3000;\n\n  // API Configuration\n  app.use(express.json());\n\n  // Image Upload and Generation API\n"
        replacement_content: "import express from \"express\";\nimport path from \"path\";\nimport { createServer as createViteServer } from \"vite\";\nimport multer from \"multer\";\nimport { GoogleGenAI } from \"@google/genai\";\nimport fs from \"fs-extra\";\nimport { v4 as uuidv4 } from \"uuid\";\n\nconst ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });\nconst upload = multer({ storage: multer.memoryStorage() });\n\nconst UPLOADS_DIR = path.join(process.cwd(), \"public\", \"uploads\");\nfs.ensureDirSync(UPLOADS_DIR);\n\nasync function startServer() {\n  const app = express();\n  const PORT = 3000;\n\n  // API Configuration\n  app.use(express.json({ limit: \"50mb\" }));\n\n  // Serve uploads\n  app.use(\"/uploads\", express.static(UPLOADS_DIR));\n\n  // Save Entry API\n  app.post(\"/api/entries\", async (req, res) => {\n    try {\n      const { topicName, infographicBase64, infographicMimeType, questions, markscheme, summary } = req.body;\n      \n      const entryId = uuidv4();\n      const entryDir = path.join(UPLOADS_DIR, entryId);\n      await fs.ensureDir(entryDir);\n\n      // Save infographic\n      const imageBuffer = Buffer.from(infographicBase64.split(\",\")[1] || infographicBase64, \"base64\");\n      const ext = infographicMimeType.split(\"/\")[1] || \"jpg\";\n      const infoFilename = `${topicName.replace(/[^a-z0-9]/gi, \"_\")}_Infographic.${ext}`;\n      await fs.writeFile(path.join(entryDir, infoFilename), imageBuffer);\n\n      // Save Questions\n      const questionsFilename = `${topicName.replace(/[^a-z0-9]/gi, \"_\")}_Questions.json`;\n      await fs.writeJson(path.join(entryDir, questionsFilename), questions);\n\n      // Save Markscheme\n      const markschemeFilename = `${topicName.replace(/[^a-z0-9]/gi, \"_\")}_Markscheme.json`;\n      await fs.writeJson(path.join(entryDir, markschemeFilename), markscheme);\n\n      const entryMetadata = {\n        id: entryId,\n        topicName,\n        createdAt: new Date().toISOString(),\n        infographicPath: `/uploads/${entryId}/${infoFilename}`,\n        questionsPath: `/uploads/${entryId}/${questionsFilename}`,\n        markschemePath: `/uploads/${entryId}/${markschemeFilename}`,\n        summary\n      };\n\n      res.json(entryMetadata);\n    } catch (error: any) {\n      console.error(\"Save error:\", error);\n      res.status(500).json({ error: error.message });\n    }\n  });\n\n  // Rename Entry API\n  app.patch(\"/api/entries/:id\", async (req, res) => {\n    try {\n      const { id } = req.params;\n      const { newTopicName } = req.body;\n      const entryDir = path.join(UPLOADS_DIR, id);\n\n      if (!await fs.pathExists(entryDir)) {\n        return res.status(404).json({ error: \"Entry not found\" });\n      }\n\n      const files = await fs.readdir(entryDir);\n      const safeName = newTopicName.replace(/[^a-z0-9]/gi, \"_\");\n\n      for (const file of files) {\n        const oldPath = path.join(entryDir, file);\n        let newFileName = file;\n        \n        if (file.includes(\"_Infographic\")) {\n          const ext = path.extname(file);\n          newFileName = `${safeName}_Infographic${ext}`;\n        } else if (file.includes(\"_Questions\")) {\n          newFileName = `${safeName}_Questions.json`;\n        } else if (file.includes(\"_Markscheme\")) {\n          newFileName = `${safeName}_Markscheme.json`;\n        }\n\n        await fs.rename(oldPath, path.join(entryDir, newFileName));\n      }\n\n      res.json({ success: true, topicName: newTopicName });\n    } catch (error: any) {\n      res.status(500).json({ error: error.message });\n    }\n  });\n\n  // Delete Entry API\n  app.delete(\"/api/entries/:id\", async (req, res) => {\n    try {\n      const { id } = req.params;\n      const entryDir = path.join(UPLOADS_DIR, id);\n      \n      if (await fs.pathExists(entryDir)) {\n        // \"Move to trash\" simulation: In this env, we\'ll just delete or rename to .trash\n        // For compliance with \"Full Lifecycle\", let\'s move to a .trash folder\n        const trashDir = path.join(UPLOADS_DIR, \".trash\");\n        await fs.ensureDir(trashDir);\n        await fs.move(entryDir, path.join(trashDir, id), { overwrite: true });\n      }\n      \n      res.json({ success: true });\n    } catch (error: any) {\n      res.status(500).json({ error: error.message });\n    }\n  });\n\n  // Image Upload and Generation API\n"
      }
      num_matches: 1
    }
  }
}
