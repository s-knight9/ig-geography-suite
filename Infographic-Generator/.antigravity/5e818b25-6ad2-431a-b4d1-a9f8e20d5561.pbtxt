  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import { Check, BarChart2, Upload, Loader2, FileImage, Moon, Sun } from \'lucide-react\';\nimport React, { useState, useRef, useEffect } from \'react\';\nimport { PDFGenerator } from \'./PDFGenerator\';\n\ntype Question = {\n  marks: number;\n  text: string;\n};\n\ntype Markscheme = {\n  criteria: string;\n  paths: string[];\n};\n\ntype GenerationResult = {\n  questions: Question[];\n  markscheme: Markscheme;\n  summary: string;\n};\n\nexport default function App() {\n  const [isGenerating, setIsGenerating] = useState(false);\n  const [result, setResult] = useState<GenerationResult | null>(null);\n  const [imageSrc, setImageSrc] = useState<string | null>(null);\n  const [isDarkMode, setIsDarkMode] = useState(false);\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  const handleUploadClick = () => {\n    fileInputRef.current?.click();\n  };\n\n  const onFileChange = async (event: React.ChangeEvent<HTMLInputElement>) => {\n    const file = event.target.files?.[0];\n    if (!file) return;\n\n    // Set local image preview\n    const objectUrl = URL.createObjectURL(file);\n    setImageSrc(objectUrl);\n\n    setIsGenerating(true);\n    const formData = new FormData();\n    formData.append(\'image\', file);\n\n    try {\n      const response = await fetch(\'/api/generate\', {\n        method: \'POST\',\n        body: formData,\n      });\n\n      if (!response.ok) {\n        throw new Error(\'Generation failed\');\n      }\n\n      const data = await response.json();\n      setResult(data);\n    } catch (error) {\n      console.error(\'Error:\', error);\n      alert(\'Generation failed. Please try again.\');\n    } finally {\n      setIsGenerating(false);\n    }\n  };\n\n  return (\n    <div className={isDarkMode ? \'dark\' : \'\'}>\n      <div className=\"w-screen h-screen bg-slate-50 dark:bg-slate-950 flex flex-col font-sans text-slate-900 dark:text-slate-100 overflow-hidden border border-slate-200 dark:border-slate-800\">\n        {/* Header Navigation */}\n        <header className=\"h-20 border-b border-slate-200 dark:border-slate-800 px-8 flex items-center justify-between bg-white dark:bg-slate-900 shrink-0 shadow-sm\">\n          <div className=\"flex items-center space-x-4\">\n            <div className=\"w-12 h-12 bg-[#00c473] rounded-xl flex items-center justify-center text-white font-black text-2xl shadow-sm leading-none pt-0.5\">\n              DP\n            </div>\n            <div className=\"flex flex-col justify-center\">\n              <h1 className=\"text-xl font-black tracking-tight text-slate-800 dark:text-white uppercase flex items-center gap-1.5 mt-1\">\n                <span className=\"text-[#00c473] font-black\">INFOGRAPHIC</span> GENERATOR\n              </h1>\n              <span className=\"text-[10px] text-slate-400 dark:text-slate-500 font-bold uppercase tracking-widest mt-[-2px]\">\n                Generating to the IBDP Geo Spec\n              </span>\n            </div>\n          </div>\n          <div className=\"flex items-center space-x-4\">\n            <div className=\"flex items-center space-x-3 bg-slate-100 dark:bg-slate-800 px-4 py-2 rounded-full\">\n              <span className={`flex h-2 w-2 rounded-full ${isGenerating ? \'bg-amber-500 animate-pulse\' : \'bg-[#00c473]\'}`}></span>\n              <span className=\"text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400\">\n                {isGenerating ? \'Analyzing...\' : \'Model Active\'}\n              </span>\n            </div>\n            <button \n              onClick={() => setIsDarkMode(!isDarkMode)} \n              className=\"w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors\"\n            >\n              {isDarkMode ? <Sun className=\"w-5 h-5\" /> : <Moon className=\"w-5 h-5\" />}\n            </button>\n          </div>\n        </header>\n\n      {/* Main Workspace */}\n      <div className=\"flex-1 flex overflow-hidden bg-slate-50 dark:bg-slate-950 justify-center\">\n\n        {/* Content Area: Data Preview */}\n        <main className=\"flex-1 p-8 overflow-hidden flex flex-col space-y-6 max-w-5xl w-full\">\n          {/* Top Info Card */}\n          <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm flex items-start space-x-6\">\n            <div className=\"w-40 h-40 bg-slate-100 dark:bg-slate-800 rounded-lg flex items-center justify-center border-2 border-dashed border-slate-200 dark:border-slate-700 overflow-hidden relative\">\n              {imageSrc ? (\n                <img src={imageSrc} alt=\"Preview\" className=\"w-full h-full object-cover\" />\n              ) : (\n                <div className=\"text-center flex flex-col items-center\">\n                  <BarChart2 className=\"w-8 h-8 text-slate-400 dark:text-slate-500 mb-2\" />\n                  <div className=\"text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase\">\n                    Infographic 01\n                  </div>\n                </div>\n              )}\n            </div>\n            <div className=\"flex-1\">\n              <h2 className=\"text-xl font-bold text-slate-900 dark:text-white mb-2\">\n                {result ? \'Analysis of Uploaded Infographic\' : \'Training Mode: Waiting for Input\'}\n              </h2>\n              <p className=\"text-sm font-medium text-slate-500 dark:text-slate-400 leading-relaxed mb-4\">\n                {result ? result.summary : \'Upload a new infographic to generate custom Paper 2 questions and a calibrated markscheme.\'}\n              </p>\n              <div className=\"flex space-x-4\">\n                <span className=\"px-2 py-1 bg-slate-100 dark:bg-slate-800 text-[10px] font-bold rounded uppercase tracking-wide text-slate-600 dark:text-slate-300\">\n                  Unit: Auto-detected\n                </span>\n                <span className=\"px-2 py-1 bg-slate-100 dark:bg-slate-800 text-[10px] font-bold rounded uppercase tracking-wide text-slate-600 dark:text-slate-300\">\n                  Paper 2\n                </span>\n              </div>\n            </div>\n          </div>\n\n          {/* Detailed Breakdown Grid */}\n          <div className=\"flex-1 grid grid-cols-2 gap-6 min-h-0\">\n            {/* Left: Questions */}\n            <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl flex flex-col overflow-hidden\">\n              <div className=\"px-6 py-4 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/50\">\n                <h3 className=\"text-xs font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500\">\n                  Calibrated Questions\n                </h3>\n              </div>\n              <div className=\"flex-1 overflow-y-auto p-6 space-y-6\">\n                {isGenerating ? (\n                  <div className=\"flex items-center justify-center h-full text-slate-400 dark:text-slate-500\">\n                     <Loader2 className=\"w-6 h-6 animate-spin mr-2\" />\n                     <span className=\"text-sm font-semibold\">Drafting questions...</span>\n                  </div>\n                ) : result ? (\n                  result.questions.map((q, i) => (\n                    <div key={i} className=\"space-y-1\">\n                      <p className=\"text-xs font-bold text-[#00c473]\">[{q.marks} Marks]</p>\n                      <p className=\"text-sm italic font-medium text-slate-700 dark:text-slate-300 whitespace-pre-wrap\">\n                        \"{q.text}\"\n                      </p>\n                    </div>\n                  ))\n                ) : (\n                  <div className=\"flex items-center justify-center h-full font-medium text-slate-400 dark:text-slate-500 text-sm\">\n                    No questions generated yet.\n                  </div>\n                )}\n              </div>\n            </div>\n\n            {/* Right: Markscheme */}\n            <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl flex flex-col overflow-hidden\">\n              <div className=\"px-6 py-4 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/50\">\n                <h3 className=\"text-xs font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500\">\n                  Logic & Markscheme Calibration\n                </h3>\n              </div>\n              <div className=\"flex-1 overflow-y-auto p-6 space-y-4\">\n                {isGenerating ? (\n                  <div className=\"flex items-center justify-center h-full text-slate-400 dark:text-slate-500\">\n                     <Loader2 className=\"w-6 h-6 animate-spin mr-2\" />\n                     <span className=\"text-sm font-semibold\">Constructing markscheme...</span>\n                  </div>\n                ) : result && result.markscheme ? (\n                  <>\n                    <div className=\"p-4 bg-[#00c473]/10 dark:bg-[#00c473]/10 rounded-lg border border-[#00c473]/20\">\n                      <div className=\"flex items-center text-[#00c473] text-xs font-bold mb-2\">\n                        <span>CRITERIA A: KNOWLEDGE</span>\n                        <span className=\"ml-auto\">SCORE: OPTIMAL</span>\n                      </div>\n                      <p className=\"text-xs font-medium text-[#00c473] leading-relaxed\">\n                        {result.markscheme.criteria}\n                      </p>\n                    </div>\n                    <div className=\"space-y-2\">\n                      <p className=\"text-xs font-bold text-slate-400 dark:text-slate-500\">\n                        CALIBRATED RESPONSE PATHS:\n                      </p>\n                      <ul className=\"text-xs font-medium text-slate-600 dark:text-slate-300 space-y-2\">\n                         {result.markscheme.paths.map((path, i) => (\n                          <li key={i} className=\"flex items-start\">\n                            <span className=\"mr-2 text-[#00c473]\">&bull;</span>{\" \"}\n                            {path}\n                          </li>\n                         ))}\n                      </ul>\n                    </div>\n                  </>\n                ) : (\n                   <div className=\"flex items-center justify-center h-full font-medium text-slate-400 dark:text-slate-500 text-sm\">\n                    No markscheme generated yet.\n                  </div>\n                )}\n              </div>\n            </div>\n          </div>\n        </main>\n      </div>\n\n      {/* Bottom Bar: User Interaction */}\n      <footer className=\"h-20 bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 px-8 flex items-center justify-between shrink-0\">\n        <div className=\"text-xs text-slate-400 dark:text-slate-500 font-bold uppercase tracking-widest\">\n          Training Engine Version 4.2.0-Alpha &bull;{\" \"}\n          <span className=\"text-[#00c473] tracking-tighter\">\n            {isGenerating ? \'Processing...\' : result ? \'Generation Complete\' : \'Ready to Proceed\'}\n          </span>\n        </div>\n        <div className=\"flex items-center space-x-4\">\n          <input \n            type=\"file\" \n            ref={fileInputRef} \n            onChange={onFileChange} \n            accept=\"image/*\" \n            className=\"hidden\" \n          />\n          \n          {/* Show download buttons when complete */}\n          {!isGenerating && result && (\n            <PDFGenerator imageSrc={imageSrc} result={result} />\n          )}\n\n          <button \n            onClick={handleUploadClick}\n            disabled={isGenerating}\n            className=\"flex items-center px-8 py-2.5 rounded-lg text-sm font-bold text-white bg-[#00c473] shadow-lg shadow-[#00c473]/20 hover:bg-[#00aa63] transition-all disabled:opacity-50\">\n            {isGenerating ? (\n              <Loader2 className=\"w-5 h-5 animate-spin mr-2 text-white\" />\n            ) : (\n              <Upload className=\"w-5 h-5 mr-2 text-white\" />\n            )}\n            {isGenerating ? \'Processing...\' : result ? \'Upload New\' : \'Submit New Infographic\'}\n          </button>\n        </div>\n      </footer>\n    </div>\n    </div>\n  );\n}\n"
      replacement_content: "import { Check, BarChart2, Upload, Loader2, FileImage, Moon, Sun, Edit3, Trash2, Folder, Clock, ChevronRight } from \'lucide-react\';\nimport React, { useState, useRef, useEffect } from \'react\';\nimport { PDFGenerator } from \'./PDFGenerator\';\nimport { SavedEntry, GenerationResult } from \'./types\';\nimport { SwipeToDelete } from \'./components/SwipeToDelete\';\nimport { db } from \'./lib/firebase\';\nimport { collection, addDoc, getDocs, updateDoc, deleteDoc, doc, query, orderBy, getDocFromServer } from \'firebase/firestore\';\nimport { motion, AnimatePresence } from \'motion/react\';\n\nexport default function App() {\n  const [isGenerating, setIsGenerating] = useState(false);\n  const [result, setResult] = useState<GenerationResult | null>(null);\n  const [imageSrc, setImageSrc] = useState<string | null>(null);\n  const [imageMimeType, setImageMimeType] = useState<string>(\"\");\n  const [isDarkMode, setIsDarkMode] = useState(false);\n  const [topicName, setTopicName] = useState(\"\");\n  const [savedEntries, setSavedEntries] = useState<SavedEntry[]>([]);\n  const [isLoadingEntries, setIsLoadingEntries] = useState(true);\n  const [entryToDelete, setEntryToDelete] = useState<SavedEntry | null>(null);\n  const [editingEntryId, setEditingEntryId] = useState<string | null>(null);\n  const [editValue, setEditValue] = useState(\"\");\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  useEffect(() => {\n    fetchEntries();\n    testFirebaseConnection();\n  }, []);\n\n  const testFirebaseConnection = async () => {\n    try {\n      await getDocFromServer(doc(db, \'test\', \'connection\'));\n    } catch (error) {\n      console.warn(\"Firebase connection notice (ignored if just missing test doc):\", error);\n    }\n  };\n\n  const fetchEntries = async () => {\n    setIsLoadingEntries(true);\n    try {\n      const q = query(collection(db, \"entries\"), orderBy(\"createdAt\", \"desc\"));\n      const snapshot = await getDocs(q);\n      const entries = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() } as SavedEntry));\n      setSavedEntries(entries);\n    } catch (error) {\n      console.error(\"Fetch error:\", error);\n    } finally {\n      setIsLoadingEntries(false);\n    }\n  };\n\n  const handleUploadClick = () => {\n    if (!topicName.trim() && !result) {\n      alert(\"Please enter a Case Study or Topic name first.\");\n      return;\n    }\n    fileInputRef.current?.click();\n  };\n\n  const onFileChange = async (event: React.ChangeEvent<HTMLInputElement>) => {\n    const file = event.target.files?.[0];\n    if (!file) return;\n\n    setImageMimeType(file.type);\n    const objectUrl = URL.createObjectURL(file);\n    setImageSrc(objectUrl);\n\n    setIsGenerating(true);\n    const formData = new FormData();\n    formData.append(\'image\', file);\n\n    try {\n      const response = await fetch(\'/api/generate\', {\n        method: \'POST\',\n        body: formData,\n      });\n\n      if (!response.ok) throw new Error(\'Generation failed\');\n      const data = await response.json();\n      setResult(data);\n\n      // Convert image to base64 for saving to server\n      const reader = new FileReader();\n      reader.onloadend = async () => {\n        const base64 = reader.result as string;\n        await saveToWebsite(data, base64, file.type);\n      };\n      reader.readAsDataURL(file);\n\n    } catch (error) {\n      console.error(\'Error:\', error);\n      alert(\'Generation failed. Please try again.\');\n    } finally {\n      setIsGenerating(false);\n    }\n  };\n\n  const saveToWebsite = async (genResult: GenerationResult, base64: string, mimeType: string) => {\n    try {\n      // 1. Save files to Express backend\n      const saveRes = await fetch(\'/api/entries\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          topicName: topicName || \"Untitled Topic\",\n          infographicBase64: base64,\n          infographicMimeType: mimeType,\n          questions: genResult.questions,\n          markscheme: genResult.markscheme,\n          summary: genResult.summary\n        }),\n      });\n\n      const metadata = await saveRes.json();\n\n      // 2. Save metadata to Firestore\n      await addDoc(collection(db, \"entries\"), {\n        ...metadata,\n        topicName: topicName || \"Untitled Topic\",\n        createdAt: new Date().toISOString(),\n      });\n\n      fetchEntries();\n    } catch (error) {\n      console.error(\"Save failed:\", error);\n    }\n  };\n\n  const handleDelete = async () => {\n    if (!entryToDelete) return;\n\n    try {\n      // 1. Delete files on server\n      await fetch(`/api/entries/${entryToDelete.id}`, { method: \'DELETE\' });\n\n      // 2. Delete metadata on Firestore\n      // We need to find the Firestore doc with this internal ID (which we stored)\n      const q = query(collection(db, \"entries\"));\n      const snapshot = await getDocs(q);\n      const docToDelete = snapshot.docs.find(d => d.data().id === entryToDelete.id);\n      \n      if (docToDelete) {\n        await deleteDoc(doc(db, \"entries\", docToDelete.id));\n      }\n\n      setSavedEntries(prev => prev.filter(e => e.id !== entryToDelete.id));\n      setEntryToDelete(null);\n    } catch (error) {\n      console.error(\"Delete failed:\", error);\n    }\n  };\n\n  const startEditing = (entry: SavedEntry) => {\n    setEditingEntryId(entry.id);\n    setEditValue(entry.topicName);\n  };\n\n  const confirmRename = async (entry: SavedEntry) => {\n    if (!editValue.trim() || editValue === entry.topicName) {\n      setEditingEntryId(null);\n      return;\n    }\n\n    try {\n      // 1. Rename files on server\n      await fetch(`/api/entries/${entry.id}`, {\n        method: \'PATCH\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ newTopicName: editValue }),\n      });\n\n      // 2. Update Firestore\n      const q = query(collection(db, \"entries\"));\n      const snapshot = await getDocs(q);\n      const docToUpdate = snapshot.docs.find(d => d.data().id === entry.id);\n      \n      if (docToUpdate) {\n        await updateDoc(doc(db, \"entries\", docToUpdate.id), { topicName: editValue });\n      }\n\n      setSavedEntries(prev => prev.map(e => e.id === entry.id ? { ...e, topicName: editValue } : e));\n      setEditingEntryId(null);\n    } catch (error) {\n      console.error(\"Rename failed:\", error);\n    }\n  };\n\n  return (\n    <div className={isDarkMode ? \'dark\' : \'\'}>\n      <div className=\"w-screen h-screen bg-slate-50 dark:bg-slate-950 flex flex-col font-sans text-slate-900 dark:text-slate-100 overflow-hidden border border-slate-200 dark:border-slate-800\">\n        \n        <AnimatePresence>\n          {entryToDelete && (\n            <SwipeToDelete \n              title={entryToDelete.topicName}\n              onConfirm={handleDelete}\n              onCancel={() => setEntryToDelete(null)}\n            />\n          )}\n        </AnimatePresence>\n\n        {/* Header Navigation */}\n        <header className=\"h-20 border-b border-slate-200 dark:border-slate-800 px-8 flex items-center justify-between bg-white dark:bg-slate-900 shrink-0 shadow-sm z-20\">\n          <div className=\"flex items-center space-x-4\">\n            <div className=\"w-12 h-12 bg-[#00c473] rounded-xl flex items-center justify-center text-white font-black text-2xl shadow-sm leading-none pt-0.5 shrink-0\">\n              DP\n            </div>\n            <div className=\"flex flex-col justify-center min-w-0\">\n              <h1 className=\"text-xl font-black tracking-tight text-slate-800 dark:text-white uppercase flex items-center gap-1.5 mt-1 truncate\">\n                <span className=\"text-[#00c473] font-black\">INFOGRAPHIC</span> GENERATOR\n              </h1>\n              <span className=\"text-[10px] text-slate-400 dark:text-slate-500 font-bold uppercase tracking-widest mt-[-2px] truncate\">\n                Generating to the IBDP Geo Spec\n              </span>\n            </div>\n          </div>\n          <div className=\"flex items-center space-x-4\">\n            <div className=\"hidden md:flex items-center space-x-3 bg-slate-100 dark:bg-slate-800 px-4 py-2 rounded-full\">\n              <span className={`flex h-2 w-2 rounded-full ${isGenerating ? \'bg-amber-500 animate-pulse\' : \'bg-[#00c473]\'}`}></span>\n              <span className=\"text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 whitespace-nowrap\">\n                {isGenerating ? \'Analyzing...\' : \'Model Active\'}\n              </span>\n            </div>\n            <button \n              onClick={() => setIsDarkMode(!isDarkMode)} \n              className=\"w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors shrink-0\"\n            >\n              {isDarkMode ? <Sun className=\"w-5 h-5\" /> : <Moon className=\"w-5 h-5\" />}\n            </button>\n          </div>\n        </header>\n\n      {/* Main Workspace */}\n      <div className=\"flex-1 flex overflow-hidden bg-white dark:bg-slate-950\">\n        \n        {/* Sidebar: Entry History */}\n        <aside className=\"w-80 border-r border-slate-200 dark:border-slate-800 flex flex-col bg-slate-50 dark:bg-slate-900/50\">\n          <div className=\"p-6 border-b border-slate-200 dark:border-slate-800\">\n            <h3 className=\"text-[10px] font-black uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-4\">\n              Stored Case Studies\n            </h3>\n            \n            <div className=\"space-y-3\">\n              <input \n                type=\"text\" \n                placeholder=\"Set Topic Name...\"\n                value={topicName}\n                onChange={(e) => setTopicName(e.target.value)}\n                className=\"w-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 text-sm font-bold text-slate-900 dark:text-white placeholder:text-slate-400 outline-none focus:ring-2 focus:ring-[#00c473]/20 focus:border-[#00c473] transition-all\"\n              />\n            </div>\n          </div>\n\n          <div className=\"flex-1 overflow-y-auto p-4 space-y-2\">\n            {isLoadingEntries ? (\n              <div className=\"flex flex-col items-center justify-center h-40 space-y-4\">\n                <Loader2 className=\"w-6 h-6 animate-spin text-slate-300\" />\n                <span className=\"text-[10px] font-bold uppercase tracking-widest text-slate-400\">Syncing...</span>\n              </div>\n            ) : savedEntries.length === 0 ? (\n              <div className=\"px-4 py-8 text-center bg-white dark:bg-slate-900/50 rounded-2xl border-2 border-dashed border-slate-200 dark:border-slate-800\">\n                <Folder className=\"w-8 h-8 text-slate-300 mx-auto mb-3\" />\n                <p className=\"text-[10px] font-bold text-slate-400 uppercase leading-relaxed\">\n                  No saved materials found.\n                </p>\n              </div>\n            ) : (\n              savedEntries.map((entry) => (\n                <div \n                  key={entry.id}\n                  className=\"group relative bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 hover:shadow-md hover:border-[#00c473]/30 transition-all cursor-pointer overflow-hidden\"\n                  onClick={() => {\n                    setResult(null); // Clear current if viewing history? Or implement \"View\"\n                    // For now, let\'s just make it a list.\n                  }}\n                >\n                  <div className=\"flex items-start justify-between mb-2\">\n                    {editingEntryId === entry.id ? (\n                      <input \n                        autoFocus\n                        value={editValue}\n                        onChange={(e) => setEditValue(e.target.value)}\n                        onBlur={() => confirmRename(entry)}\n                        onKeyDown={(e) => e.key === \'Enter\' && confirmRename(entry)}\n                        className=\"text-sm font-bold text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded outline-none w-full mr-8\"\n                      />\n                    ) : (\n                      <h4 className=\"text-sm font-black text-slate-800 dark:text-white truncate pr-6\">\n                        {entry.topicName}\n                      </h4>\n                    )}\n                    <div className=\"absolute top-4 right-4 flex space-x-1 opacity-0 group-hover:opacity-100 transition-opacity\">\n                      <button \n                        onClick={(e) => { e.stopPropagation(); startEditing(entry); }}\n                        className=\"p-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 hover:text-[#00c473]\"\n                      >\n                        <Edit3 className=\"w-3.5 h-3.5\" />\n                      </button>\n                      <button \n                        onClick={(e) => { e.stopPropagation(); setEntryToDelete(entry); }}\n                        className=\"p-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 hover:text-red-500\"\n                      >\n                        <Trash2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n                  </div>\n                  \n                  <div className=\"flex items-center text-[10px] font-bold text-slate-400 uppercase tracking-widest space-x-3\">\n                    <div className=\"flex items-center\">\n                      <Clock className=\"w-3 h-3 mr-1\" />\n                      {new Date(entry.createdAt).toLocaleDateString()}\n                    </div>\n                    <span>&bull;</span>\n                    <span className=\"text-[#00c473]\">3 Files</span>\n                  </div>\n                </div>\n              ))\n            )}\n          </div>\n\n          <div className=\"p-6 bg-slate-900 text-white\">\n            <h4 className=\"text-[10px] font-black uppercase tracking-widest text-[#00c473] mb-2 font-sans\">\n              System Instruction\n            </h4>\n            <p className=\"text-[10px] text-slate-400 leading-relaxed font-bold uppercase tracking-tighter\">\n              All folders are stored locally on the web server with automated paper 2 indexing.\n            </p>\n          </div>\n        </aside>\n\n        {/* Content Area: Data Preview */}\n        <main className=\"flex-1 p-8 overflow-hidden flex flex-col space-y-6 max-w-5xl\">\n          {/* Top Info Card */}\n          <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-8 shadow-sm flex items-start space-x-8 shrink-0\">\n            <div className=\"w-48 h-48 bg-slate-100 dark:bg-slate-800 rounded-2xl flex items-center justify-center border-2 border-dashed border-slate-200 dark:border-slate-700 overflow-hidden relative shrink-0\">\n              {imageSrc ? (\n                <img src={imageSrc} alt=\"Preview\" className=\"w-full h-full object-cover\" />\n              ) : (\n                <div className=\"text-center flex flex-col items-center\">\n                  <BarChart2 className=\"w-10 h-10 text-slate-400 dark:text-slate-500 mb-3\" />\n                  <div className=\"text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest\">\n                    Source Booklet\n                  </div>\n                </div>\n              )}\n            </div>\n            <div className=\"flex-1 pt-2\">\n              <h2 className=\"text-2xl font-black text-slate-900 dark:text-white mb-3 uppercase tracking-tight\">\n                {result ? `Unit: ${topicName || \'Analyzed Data\'}` : \'Project Initialization\'}\n              </h2>\n              <p className=\"text-sm font-medium text-slate-500 dark:text-slate-400 leading-relaxed max-w-2xl mb-6\">\n                {result ? result.summary : \'Define your Case Study name and upload an official IBDP infographic. The engine will calibrate a 3-part Paper 2 sequence with an extraction, application, and evaluative component.\'}\n              </p>\n              <div className=\"flex items-center space-x-6\">\n                <div className=\"flex flex-col\">\n                  <span className=\"text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1\">Spec Compliance</span>\n                  <div className=\"flex space-x-2\">\n                    <span className=\"px-3 py-1 bg-slate-100 dark:bg-slate-800 text-[10px] font-black rounded-lg uppercase tracking-wide text-slate-600 dark:text-slate-300\">\n                      Standard\n                    </span>\n                    <span className=\"px-3 py-1 bg-[#00c473]/10 text-[10px] font-black rounded-lg uppercase tracking-wide text-[#00c473]\">\n                      Paper 2\n                    </span>\n                  </div>\n                </div>\n                <div className=\"h-8 w-px bg-slate-200 dark:bg-slate-800\" />\n                <div className=\"flex flex-col\">\n                  <span className=\"text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1\">Entry Status</span>\n                  <span className=\"text-xs font-bold text-slate-900 dark:text-white\">\n                    {result ? \'Storage Synchronized\' : \'Ready for Calibration\'}\n                  </span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Detailed Breakdown Grid */}\n          <div className=\"flex-1 grid grid-cols-2 gap-8 min-h-0\">\n            {/* Left: Questions */}\n            <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl flex flex-col overflow-hidden shadow-sm\">\n              <div className=\"px-8 py-6 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/50 flex items-center justify-between\">\n                <h3 className=\"text-[10px] font-black uppercase tracking-widest text-slate-400 dark:text-slate-500\">\n                  Assessment Structure (10M)\n                </h3>\n                <span className=\"px-2 py-0.5 bg-slate-200 dark:bg-slate-800 rounded text-[9px] font-black text-slate-500 dark:text-slate-400 uppercase\">\n                  Section B\n                </span>\n              </div>\n              <div className=\"flex-1 overflow-y-auto p-8 space-y-8\">\n                {isGenerating ? (\n                  <div className=\"flex flex-col items-center justify-center h-full text-slate-400 dark:text-slate-500 space-y-6\">\n                     <div className=\"relative\">\n                        <Loader2 className=\"w-12 h-12 animate-spin text-[#00c473]\" />\n                        <div className=\"absolute inset-0 flex items-center justify-center\">\n                          <div className=\"w-2 h-2 bg-[#00c473] rounded-full animate-ping\" />\n                        </div>\n                     </div>\n                     <span className=\"text-sm font-black uppercase tracking-widest\">Drafting questions...</span>\n                  </div>\n                ) : result ? (\n                  result.questions.map((q, i) => (\n                    <div key={i} className=\"flex space-x-6 relative\">\n                      <div className=\"flex-shrink-0 w-8 h-8 rounded-xl bg-[#00c473]/10 text-[#00c473] flex items-center justify-center text-xs font-black\">\n                        {String.fromCharCode(97 + i).toUpperCase()}\n                      </div>\n                      <div className=\"space-y-2 flex-1\">\n                        <p className=\"text-sm italic font-semibold text-slate-700 dark:text-slate-200 leading-relaxed\">\n                          \"{q.text}\"\n                        </p>\n                        <div className=\"flex items-center text-[10px] font-black text-[#00c473] uppercase tracking-widest pt-1\">\n                          Assessment Value: {q.marks} Marks\n                        </div>\n                      </div>\n                    </div>\n                  ))\n                ) : (\n                  <div className=\"flex flex-col items-center justify-center h-full text-slate-300 dark:text-slate-700 space-y-4\">\n                    <Edit3 className=\"w-12 h-12\" />\n                    <div className=\"text-[10px] font-black uppercase tracking-widest\">Waiting for topic data...</div>\n                  </div>\n                )}\n              </div>\n            </div>\n\n            {/* Right: Markscheme */}\n            <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl flex flex-col overflow-hidden shadow-sm\">\n              <div className=\"px-8 py-6 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/50 flex items-center justify-between\">\n                <h3 className=\"text-[10px] font-black uppercase tracking-widest text-slate-400 dark:text-slate-500\">\n                  Examiner Rationalization\n                </h3>\n                <span className=\"px-2 py-0.5 bg-[#00c473]/10 rounded text-[9px] font-black text-[#00c473] uppercase\">\n                  Logical Key\n                </span>\n              </div>\n              <div className=\"flex-1 overflow-y-auto p-8 space-y-6\">\n                {isGenerating ? (\n                  <div className=\"flex flex-col items-center justify-center h-full text-slate-400 dark:text-slate-500 space-y-6\">\n                     <Loader2 className=\"w-10 h-10 animate-spin\" />\n                     <span className=\"text-sm font-black uppercase tracking-widest\">Constructing markscheme...</span>\n                  </div>\n                ) : result && result.markscheme ? (\n                  <>\n                    <div className=\"p-6 bg-[#00c473]/5 dark:bg-[#00c473]/5 rounded-2xl border border-[#00c473]/20\">\n                      <div className=\"flex items-center text-[#00c473] text-[10px] font-black mb-3 uppercase tracking-widest\">\n                        <span>Calibration Logic</span>\n                        <div className=\"ml-auto w-2 h-2 bg-[#00c473] rounded-full animate-pulse\" />\n                      </div>\n                      <p className=\"text-xs font-semibold text-slate-700 dark:text-slate-200 leading-relaxed italic\">\n                        {result.markscheme.criteria}\n                      </p>\n                    </div>\n                    <div className=\"space-y-4 pt-4\">\n                      <p className=\"text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest border-b border-slate-100 dark:border-slate-800 pb-2\">\n                        Marking Descriptors:\n                      </p>\n                      <ul className=\"text-xs font-bold text-slate-600 dark:text-slate-300 space-y-4\">\n                         {result.markscheme.paths.map((path, i) => (\n                          <li key={i} className=\"flex items-start\">\n                            <div className=\"mt-1.5 mr-3 w-1.5 h-1.5 rounded-full bg-[#00c473] flex-shrink-0\" />\n                            <span className=\"leading-relaxed\">{path}</span>\n                          </li>\n                         ))}\n                      </ul>\n                    </div>\n                  </>\n                ) : (\n                   <div className=\"flex flex-col items-center justify-center h-full text-slate-300 dark:text-slate-700 space-y-4\">\n                    <Check className=\"w-12 h-12\" />\n                    <div className=\"text-[10px] font-black uppercase tracking-widest\">Awaiting calibration...</div>\n                  </div>\n                )}\n              </div>\n            </div>\n          </div>\n        </main>\n      </div>\n\n      {/* Bottom Bar: User Interaction */}\n      <footer className=\"h-24 bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 px-10 flex items-center justify-between shrink-0 z-20\">\n        <div className=\"flex flex-col\">\n          <div className=\"text-[10px] text-slate-400 dark:text-slate-500 font-black uppercase tracking-widest mb-1 flex items-center\">\n            Active Core Engine \n            <span className=\"ml-2 w-1.5 h-1.5 bg-[#00c473] rounded-full\" />\n          </div>\n          <div className=\"text-xs font-bold text-slate-900 dark:text-white uppercase tracking-tighter\">\n            {isGenerating ? \'Computing Geospatial Patterns...\' : result ? \'Calibration Successful & Stored\' : \'System Ready for Dataset Upload\'}\n          </div>\n        </div>\n        <div className=\"flex items-center space-x-6\">\n          <input \n            type=\"file\" \n            ref={fileInputRef} \n            onChange={onFileChange} \n            accept=\"image/*\" \n            className=\"hidden\" \n          />\n          \n          <AnimatePresence>\n            {!isGenerating && result && (\n              <motion.div \n                initial={{ opacity: 0, y: 10 }}\n                animate={{ opacity: 1, y: 0 }}\n                exit={{ opacity: 0, y: 10 }}\n              >\n                <PDFGenerator imageSrc={imageSrc} result={result} />\n              </motion.div>\n            )}\n          </AnimatePresence>\n\n          <button \n            onClick={handleUploadClick}\n            disabled={isGenerating}\n            className=\"group flex items-center px-10 py-4 rounded-2xl text-sm font-black text-white bg-[#00c473] shadow-xl shadow-[#00c473]/20 hover:bg-[#00aa63] hover:shadow-[#00c473]/30 hover:-translate-y-0.5 transition-all disabled:opacity-50 disabled:translate-y-0 uppercase tracking-widest\"\n          >\n            {isGenerating ? (\n              <Loader2 className=\"w-5 h-5 animate-spin mr-3 text-white\" />\n            ) : (\n              <Upload className=\"w-5 h-5 mr-3 text-white group-hover:scale-110 transition-transform\" />\n            )}\n            {isGenerating ? \'Processing...\' : result ? \'Re-Calibrate\' : \'Initialize Generator\'}\n          </button>\n        </div>\n      </footer>\n    </div>\n    </div>\n  );\n}\n"
    }
    instruction: "Integrating topic naming, entry storage, renaming, and deletion workflow into the main App component."
  }
}
