          text: "                <div className=\"p-6 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/50 text-[10px] font-black uppercase tracking-widest text-slate-400\">Questions (10M)</div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
