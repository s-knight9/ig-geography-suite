 font-medium transition-colors ${state.cropMode ? \'bg-blue-100 text-blue-700\' : \'hover:bg-gray-100 text-gray-700\'}`}\n      >\n        <Crop className=\"w-4 h-4\" />\n        Crop Tool\n      </button>\n\n      <div className=\"w-px h-8 bg-gray-200\" />\n\n      <button\n        onClick={() => {\n          dispatch({ type: \'DELETE_ELEMENT\', payload: { id: selectedElement.id } });\n          dispatch({ type: \'SET_SELECTED_ELEMENT\', payload: null });\n        }}\n        className=\"flex items-center gap-2 px-3 py-1.5 rounded text-red-600 hover:bg-red-50 font-medium transition-colors\"\n      >\n        <Trash2 className=\"w-4 h-4\" />\n        Delete\n      </button>\n\n    </div>\n  );\n}\n"
