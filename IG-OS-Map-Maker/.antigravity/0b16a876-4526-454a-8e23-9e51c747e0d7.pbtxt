    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { useAppContext } from \'../store\';\nimport { Plus, Image as ImageIcon, Trash2 } from \'lucide-react\';\nimport { ElementData } from \'../types\';\n\nexport function Sidebar() {\n  const { state, dispatch } = useAppContext();\n\n  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n    const url = URL.createObjectURL(file);\n    const img = new Image();\n    img.onload = () => {\n      const el: ElementData = {\n        id: crypto.randomUUID(),\n        src: url,\n        x: 0,\n        y: 0,\n        width: img.naturalWidth,\n        height: img.naturalHeight,\n        rotation: 0\n      };\n      \n      el.x = (1587 - el.width) / 2;\n      el.y = (1122 - el.height) / 2;\n\n      dispatch({ type: \'ADD_ELEMENT\', payload: { pageId: state.activePageId, element: el } });\n      dispatch({ type: \'SET_SELECTED_ELEMENT\', payload: el.id });\n    };\n    img.src = url;\n    e.target.value = \'\';\n  };\n\n  return (\n    <div className=\"w-64 bg-white border-r flex flex-col h-full flex-shrink-0 shadow-sm z-10\">\n      <div className=\"p-4 border-b\">\n        <h1 className=\"font-bold text-lg flex items-center gap-2 text-gray-800\">\n          <ImageIcon className=\"w-5 h-5 text-blue-600\"/> \n          Map Maker\n        </h1>\n        <p className=\"text-xs text-gray-500 mt-1\">A3 Presentation Editor</p>\n      </div>\n      \n      <div className=\"flex-1 overflow-y-auto p-4 space-y-4\">\n        {state.pages.map((page, index) => (\n          <div \n            key={page.id} \n            onClick={() => dispatch({ type: \'SET_ACTIVE_PAGE\', payload: page.id })}\n            className={`cursor-pointer rounded-lg border-2 transition-all p-2 aspect-[420/297] flex flex-col items-center justify-center relative group shadow-sm ${state.activePageId === page.id ? \'border-blue-500 bg-blue-50\' : \'border-gray-200 hover:border-gray-300 bg-gray-50\'}`}\n          >\n            <span className={`font-semibold ${state.activePageId === page.id ? \'text-blue-700\' : \'text-gray-400\'}`}>Page {index + 1}</span>\n            <span className=\"text-[10px] text-gray-400 mt-1\">{page.elements.length} layer(s)</span>\n            {state.pages.length > 1 && (\n               <button \n                 onClick={(e) => { e.stopPropagation(); dispatch({ type: \'DELETE_PAGE\', payload: page.id }); }}\n                 className=\"absolute top-2 right-2 p-1.5 bg-white rounded-md shadow opacity-0 group-hover:opacity-100 text-red-500 hover:bg-red-50 hover:text-red-700 transition-all\"\n               >\n                 <Trash2 className=\"w-3.5 h-3.5\"/>\n               </button>\n            )}\n          </div>\n        ))}\n        \n        <button \n          onClick={() => {\n            const newId = crypto.randomUUID();\n            dispatch({ type: \'ADD_PAGE\', payload: { id: newId, elements: [] } });\n            dispatch({ type: \'SET_ACTIVE_PAGE\', payload: newId });\n          }}\n          className=\"w-full h-24 border-2 border-dashed border-gray-300 rounded-lg flex flex-col items-center justify-center text-gray-500 hover:text-blue-600 hover:border-blue-300 hover:bg-blue-50 transition-colors\"\n        >\n          <Plus className=\"w-6 h-6 mb-1\" />\n          <span className=\"text-sm font-medium\">New Page</span>\n        </button>\n      </div>\n\n      <div className=\"p-4 border-t bg-gray-50\">\n        <label className=\"w-full flex items-center justify-center gap-2 bg-blue-600 text-white py-2.5 px-4 rounded-md cursor-pointer hover:bg-blue-700 transition-colors font-medium shadow-sm\">\n          <Plus className=\"w-5 h-5\"/> Upload Map\n          <input type=\"file\" accept=\"image/png, image/jpeg, image/webp\" className=\"hidden\" onChange={handleFileUpload} />\n        </label>\n        <p className=\"text-[11px] text-gray-500 mt-2 text-center leading-tight\">Supported: PNG, JPEG, WEBP. Native dimensions will be preserved.</p>\n      </div>\n    </div>\n  );\n}\n"
    }
