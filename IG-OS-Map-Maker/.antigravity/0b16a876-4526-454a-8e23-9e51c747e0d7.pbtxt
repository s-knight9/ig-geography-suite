    instruction: "Update CropOverlay with Google-style handles, apply crop in place functionality, and an Apply Crop button."
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { useAppContext } from \'../store\';\nimport { extractCrop } from \'../utils\';\nimport { PIXELS_PER_CM } from \'../types\';\n\nexport function CropOverlay({ zoom }: { zoom: number }) {\n  const { state, dispatch } = useAppContext();\n  const selectedElement = state.pages.find(p => p.id === state.activePageId)?.elements.find(e => e.id === state.selectedElementId);\n  \n  const [cropBoxCm, setCropBoxCm] = useState(() => {\n    if (!selectedElement) return { x: 0, y: 0, w: 10, h: 10 };\n    return {\n      x: selectedElement.x,\n      y: selectedElement.y,\n      w: Math.min(selectedElement.width, 42),\n      h: Math.min(selectedElement.height, 29.7),\n    };\n  });\n\n  const [isLoading, setIsLoading] = useState(false);\n\n  if (!selectedElement) return null;\n\n  const handlePointerDown = (e: React.PointerEvent, corner: string) => {\n    e.stopPropagation();\n    const startX = e.clientX;\n    const startY = e.clientY;\n    const initial = { ...cropBoxCm };\n\n    const onPointerMove = (ev: PointerEvent) => {\n      const dx_px = (ev.clientX - startX) / zoom;\n      const dy_px = (ev.clientY - startY) / zoom;\n\n      const dx = dx_px / PIXELS_PER_CM;\n      const dy = dy_px / PIXELS_PER_CM;\n      \n      const newBox = { ...initial };\n      if (corner.includes(\'e\')) newBox.w = initial.w + dx;\n      if (corner.includes(\'s\')) newBox.h = initial.h + dy;\n      if (corner.includes(\'w\')) { newBox.x = initial.x + dx; newBox.w = initial.w - dx; }\n      if (corner.includes(\'n\')) { newBox.y = initial.y + dy; newBox.h = initial.h - dy; }\n      \n      if (newBox.w < 1) newBox.w = 1;\n      if (newBox.h < 1) newBox.h = 1;\n      \n      setCropBoxCm(newBox);\n    };\n\n    const onPointerUp = () => {\n      window.removeEventListener(\'pointermove\', onPointerMove);\n      window.removeEventListener(\'pointerup\', onPointerUp);\n    };\n\n    window.addEventListener(\'pointermove\', onPointerMove);\n    window.addEventListener(\'pointerup\', onPointerUp);\n  };\n\n  const handleBoxDrag = (e: React.PointerEvent) => {\n    e.stopPropagation();\n    const startX = e.clientX;\n    const startY = e.clientY;\n    const initial = { ...cropBoxCm };\n\n    const onPointerMove = (ev: PointerEvent) => {\n      const dx_px = (ev.clientX - startX) / zoom;\n      const dy_px = (ev.clientY - startY) / zoom;\n\n      const dx = dx_px / PIXELS_PER_CM;\n      const dy = dy_px / PIXELS_PER_CM;\n\n      setCropBoxCm({ ...initial, x: initial.x + dx, y: initial.y + dy });\n    };\n\n    const onPointerUp = () => {\n      window.removeEventListener(\'pointermove\', onPointerMove);\n      window.removeEventListener(\'pointerup\', onPointerUp);\n    };\n\n    window.addEventListener(\'pointermove\', onPointerMove);\n    window.addEventListener(\'pointerup\', onPointerUp);\n  };\n\n  const executeCrop = async (e: React.MouseEvent) => {\n    e.stopPropagation();\n    setIsLoading(true);\n    try {\n      const { url, nativeW, nativeH } = await extractCrop(selectedElement, cropBoxCm);\n      const newPageId = crypto.randomUUID();\n      const newElement = {\n        id: crypto.randomUUID(),\n        src: url,\n        x: cropBoxCm.x,\n        y: cropBoxCm.y,\n        width: cropBoxCm.w,\n        height: cropBoxCm.h,\n        rotation: 0,\n        dpi: selectedElement.dpi,\n        nativeWidth: nativeW,\n        nativeHeight: nativeH,\n      };\n      \n      dispatch({ type: \'ADD_PAGE\', payload: { id: newPageId, elements: [newElement] }});\n      dispatch({ type: \'SET_ACTIVE_PAGE\', payload: newPageId });\n      dispatch({ type: \'SET_SELECTED_ELEMENT\', payload: newElement.id });\n      dispatch({ type: \'SET_CROP_MODE\', payload: false });\n    } catch (err) {\n      console.error(err);\n      alert(\"Failed to crop image.\");\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const Handle = ({ pos, cursor }: { pos: string, cursor: string }) => (\n    <div \n      onPointerDown={(e) => handlePointerDown(e, pos)} \n      className={`absolute w-3 h-3 bg-blue-500 border-2 border-white rounded-full shadow-md ${cursor} pointer-events-auto`}\n      style={{\n        top: pos.includes(\'n\') ? -6 : \'auto\',\n        bottom: pos.includes(\'s\') ? -6 : \'auto\',\n        left: pos.includes(\'w\') ? -6 : \'auto\',\n        right: pos.includes(\'e\') ? -6 : \'auto\',\n        transform: \'scale(1)\',\n      }}\n    />\n  );\n\n  const cssX = cropBoxCm.x * PIXELS_PER_CM;\n  const cssY = cropBoxCm.y * PIXELS_PER_CM;\n  const cssW = cropBoxCm.w * PIXELS_PER_CM;\n  const cssH = cropBoxCm.h * PIXELS_PER_CM;\n\n  return (\n    <>\n      <div \n        className=\"absolute inset-0 bg-black/40 pointer-events-none\" \n        style={{ zIndex: 40 }}\n      />\n      <div \n        style={{\n          position: \'absolute\',\n          left: cssX, top: cssY, width: cssW, height: cssH,\n          zIndex: 50,\n          boxShadow: \'0 0 0 9999px rgba(0,0,0,0.4)\',\n          outline: \'1px dashed #3b82f6\'\n        }}\n        className=\"cursor-move pointer-events-auto flex items-center justify-center\"\n        onPointerDown={handleBoxDrag}\n      >\n        <div style={{ position: \'absolute\', top: -56, right: 0 }} className=\"flex gap-2 pointer-events-auto\">\n          <button \n             onClick={executeCrop} \n             disabled={isLoading}\n             className=\"bg-blue-600 text-white px-4 py-2 rounded text-[10px] font-bold hover:bg-blue-700 shadow-sm uppercase tracking-wider disabled:opacity-50\"\n          >\n            {isLoading ? \'Extracting...\' : \'Extract to New\'}\n          </button>\n          <button \n            onClick={(e) => { e.stopPropagation(); dispatch({ type: \'SET_CROP_MODE\', payload: false }) }} \n            className=\"bg-white text-gray-800 px-4 py-2 rounded border border-gray-300 text-[10px] font-bold hover:bg-gray-50 shadow-sm uppercase tracking-wider\"\n          >\n            Cancel\n          </button>\n        </div>\n        \n        <div className=\"absolute -bottom-10 left-1/2 -translate-x-1/2 bg-blue-600 text-white px-2 py-1 rounded text-[9px] font-bold whitespace-nowrap shadow-md uppercase\">\n          Active Crop Area\n        </div>\n\n        <Handle pos=\"nw\" cursor=\"cursor-nwse-resize\" />\n        <Handle pos=\"ne\" cursor=\"cursor-nesw-resize\" />\n        <Handle pos=\"sw\" cursor=\"cursor-nesw-resize\" />\n        <Handle pos=\"se\" cursor=\"cursor-nwse-resize\" />\n      </div>\n    </>\n  );\n}"
        replacement_content: "import React, { useState } from \'react\';\nimport { useAppContext } from \'../store\';\nimport { extractCrop } from \'../utils\';\nimport { PIXELS_PER_CM } from \'../types\';\n\nexport function CropOverlay({ zoom }: { zoom: number }) {\n  const { state, dispatch } = useAppContext();\n  const selectedElement = state.pages.find(p => p.id === state.activePageId)?.elements.find(e => e.id === state.selectedElementId);\n  \n  const [cropBoxCm, setCropBoxCm] = useState(() => {\n    if (!selectedElement) return { x: 0, y: 0, w: 10, h: 10 };\n    return {\n      x: selectedElement.x,\n      y: selectedElement.y,\n      w: selectedElement.width,\n      h: selectedElement.height,\n    };\n  });\n\n  const [isLoading, setIsLoading] = useState(false);\n\n  if (!selectedElement) return null;\n\n  const handlePointerDown = (e: React.PointerEvent, corner: string) => {\n    e.stopPropagation();\n    const startX = e.clientX;\n    const startY = e.clientY;\n    const initial = { ...cropBoxCm };\n\n    const onPointerMove = (ev: PointerEvent) => {\n      const dx_px = (ev.clientX - startX) / zoom;\n      const dy_px = (ev.clientY - startY) / zoom;\n\n      const dx = dx_px / PIXELS_PER_CM;\n      const dy = dy_px / PIXELS_PER_CM;\n      \n      const newBox = { ...initial };\n      if (corner.includes(\'e\')) newBox.w = initial.w + dx;\n      if (corner.includes(\'s\')) newBox.h = initial.h + dy;\n      if (corner.includes(\'w\')) { newBox.x = initial.x + dx; newBox.w = initial.w - dx; }\n      if (corner.includes(\'n\')) { newBox.y = initial.y + dy; newBox.h = initial.h - dy; }\n      \n      if (newBox.w < 1) newBox.w = 1;\n      if (newBox.h < 1) newBox.h = 1;\n      \n      setCropBoxCm(newBox);\n    };\n\n    const onPointerUp = () => {\n      window.removeEventListener(\'pointermove\', onPointerMove);\n      window.removeEventListener(\'pointerup\', onPointerUp);\n    };\n\n    window.addEventListener(\'pointermove\', onPointerMove);\n    window.addEventListener(\'pointerup\', onPointerUp);\n  };\n\n  const handleBoxDrag = (e: React.PointerEvent) => {\n    e.stopPropagation();\n    const startX = e.clientX;\n    const startY = e.clientY;\n    const initial = { ...cropBoxCm };\n\n    const onPointerMove = (ev: PointerEvent) => {\n      const dx_px = (ev.clientX - startX) / zoom;\n      const dy_px = (ev.clientY - startY) / zoom;\n\n      const dx = dx_px / PIXELS_PER_CM;\n      const dy = dy_px / PIXELS_PER_CM;\n\n      setCropBoxCm({ ...initial, x: initial.x + dx, y: initial.y + dy });\n    };\n\n    const onPointerUp = () => {\n      window.removeEventListener(\'pointermove\', onPointerMove);\n      window.removeEventListener(\'pointerup\', onPointerUp);\n    };\n\n    window.addEventListener(\'pointermove\', onPointerMove);\n    window.addEventListener(\'pointerup\', onPointerUp);\n  };\n\n  const extractToNew = async (e: React.MouseEvent) => {\n    e.stopPropagation();\n    setIsLoading(true);\n    try {\n      const { url, nativeW, nativeH } = await extractCrop(selectedElement, cropBoxCm);\n      const newPageId = crypto.randomUUID();\n      const newElement = {\n        id: crypto.randomUUID(),\n        src: url,\n        x: cropBoxCm.x,\n        y: cropBoxCm.y,\n        width: cropBoxCm.w,\n        height: cropBoxCm.h,\n        rotation: 0,\n        dpi: selectedElement.dpi,\n        nativeWidth: nativeW,\n        nativeHeight: nativeH,\n      };\n      \n      dispatch({ type: \'ADD_PAGE\', payload: { id: newPageId, elements: [newElement] }});\n      dispatch({ type: \'SET_ACTIVE_PAGE\', payload: newPageId });\n      dispatch({ type: \'SET_SELECTED_ELEMENT\', payload: newElement.id });\n      dispatch({ type: \'SET_CROP_MODE\', payload: false });\n    } catch (err) {\n      console.error(err);\n      alert(\"Failed to extract image.\");\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const applyCropInPlace = async (e: React.MouseEvent) => {\n    e.stopPropagation();\n    setIsLoading(true);\n    try {\n      const { url, nativeW, nativeH } = await extractCrop(selectedElement, cropBoxCm);\n      dispatch({ \n        type: \'UPDATE_ELEMENT\', \n        payload: { \n          id: selectedElement.id, \n          updates: { \n            src: url, \n            x: cropBoxCm.x, \n            y: cropBoxCm.y, \n            width: cropBoxCm.w, \n            height: cropBoxCm.h, \n            nativeWidth: nativeW, \n            nativeHeight: nativeH \n          }\n        }\n      });\n      dispatch({ type: \'SET_CROP_MODE\', payload: false });\n    } catch (err) {\n      console.error(err);\n      alert(\"Failed to crop image.\");\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const Handle = ({ pos, cursor, style }: { pos: string, cursor: string, style: React.CSSProperties }) => (\n    <div \n      onPointerDown={(e) => handlePointerDown(e, pos)} \n      className={`absolute bg-gray-900 pointer-events-auto shadow-sm ${cursor}`}\n      style={style}\n    />\n  );\n\n  const cssX = cropBoxCm.x * PIXELS_PER_CM;\n  const cssY = cropBoxCm.y * PIXELS_PER_CM;\n  const cssW = cropBoxCm.w * PIXELS_PER_CM;\n  const cssH = cropBoxCm.h * PIXELS_PER_CM;\n\n  // Thick black line dimensions similar to Google Slides Crop handles\n  const hLength = 24;\n  const hThick = 4;\n\n  return (\n    <>\n      <div \n        className=\"absolute inset-0 pointer-events-auto bg-black/50\" \n        style={{ zIndex: 40 }}\n        onClick={() => dispatch({ type: \'SET_CROP_MODE\', payload: false })}\n      >\n        <div style={{ position: \'absolute\', top: 20, right: \'50%\', transform: \'translateX(50%)\' }} className=\"text-white text-sm font-bold opacity-70\">\n          Click outside to cancel\n        </div>\n      </div>\n      <div \n        style={{\n          position: \'absolute\',\n          left: cssX, top: cssY, width: cssW, height: cssH,\n          zIndex: 50,\n          boxShadow: \'0 0 0 9999px rgba(0,0,0,0.5)\',\n          border: \'1px dashed rgba(255,255,255,0.7)\',\n        }}\n        className=\"cursor-move pointer-events-none flex items-center justify-center\"\n      >\n        <div \n          className=\"absolute inset-0 pointer-events-auto\"\n          onPointerDown={handleBoxDrag}\n        />\n        \n        <div style={{ position: \'absolute\', top: -56, right: 0 }} className=\"flex gap-2 pointer-events-auto\">\n          <button \n             onClick={applyCropInPlace} \n             disabled={isLoading}\n             className=\"bg-blue-600 text-white px-4 py-2 rounded text-[10px] font-bold hover:bg-blue-700 shadow-sm uppercase tracking-wider disabled:opacity-50\"\n          >\n            {isLoading ? \'Processing...\' : \'Apply Crop\'}\n          </button>\n          <button \n             onClick={extractToNew} \n             disabled={isLoading}\n             className=\"bg-white text-blue-700 border border-blue-600 px-4 py-2 rounded text-[10px] font-bold hover:bg-blue-50 shadow-sm uppercase tracking-wider disabled:opacity-50\"\n          >\n            Extract to New\n          </button>\n        </div>\n\n        {/* Top-Left Corner Handle */}\n        <Handle pos=\"nw\" cursor=\"cursor-nwse-resize\" style={{ top: -hThick, left: -hThick, width: hLength, height: hThick }} />\n        <Handle pos=\"nw\" cursor=\"cursor-nwse-resize\" style={{ top: -hThick, left: -hThick, width: hThick, height: hLength }} />\n        \n        {/* Top-Right Corner Handle */}\n        <Handle pos=\"ne\" cursor=\"cursor-nesw-resize\" style={{ top: -hThick, right: -hThick, width: hLength, height: hThick }} />\n        <Handle pos=\"ne\" cursor=\"cursor-nesw-resize\" style={{ top: -hThick, right: -hThick, width: hThick, height: hLength }} />\n        \n        {/* Bottom-Left Corner Handle */}\n        <Handle pos=\"sw\" cursor=\"cursor-nesw-resize\" style={{ bottom: -hThick, left: -hThick, width: hLength, height: hThick }} />\n        <Handle pos=\"sw\" cursor=\"cursor-nesw-resize\" style={{ bottom: -hThick, left: -hThick, width: hThick, height: hLength }} />\n        \n        {/* Bottom-Right Corner Handle */}\n        <Handle pos=\"se\" cursor=\"cursor-nwse-resize\" style={{ bottom: -hThick, right: -hThick, width: hLength, height: hThick }} />\n        <Handle pos=\"se\" cursor=\"cursor-nwse-resize\" style={{ bottom: -hThick, right: -hThick, width: hThick, height: hLength }} />\n        \n        {/* Middle-Top Handle */}\n        <Handle pos=\"n\" cursor=\"cursor-ns-resize\" style={{ top: -hThick, left: \'50%\', transform: \'translateX(-50%)\', width: hLength, height: hThick }} />\n        \n        {/* Middle-Bottom Handle */}\n        <Handle pos=\"s\" cursor=\"cursor-ns-resize\" style={{ bottom: -hThick, left: \'50%\', transform: \'translateX(-50%)\', width: hLength, height: hThick }} />\n        \n        {/* Middle-Left Handle */}\n        <Handle pos=\"w\" cursor=\"cursor-ew-resize\" style={{ left: -hThick, top: \'50%\', transform: \'translateY(-50%)\', width: hThick, height: hLength }} />\n        \n        {/* Middle-Right Handle */}\n        <Handle pos=\"e\" cursor=\"cursor-ew-resize\" style={{ right: -hThick, top: \'50%\', transform: \'translateY(-50%)\', width: hThick, height: hLength }} />\n      </div>\n    </>\n  );\n}"
