        replacement_content: "    case \'SET_CROP_MODE\':\n      return { ...state, cropMode: action.payload };\n    case \'COPY_ELEMENT\': {\n      const activePageForCopy = state.pages.find(p => p.id === state.activePageId);\n      if (!activePageForCopy || !state.selectedElementId) return state;\n      const elToCopy = activePageForCopy.elements.find(e => e.id === state.selectedElementId);\n      return { ...state, clipboardElement: elToCopy || null };\n    }\n    case \'PASTE_ELEMENT\': {\n      if (!state.clipboardElement) return state;\n      const newEl = { \n        ...state.clipboardElement, \n        id: Math.random().toString(36).substr(2, 9),\n        x: state.clipboardElement.x + 1, // Offset by 1 cm\n        y: state.clipboardElement.y + 1 \n      };\n      return {\n        ...state,\n        pages: state.pages.map(p => \n          p.id === state.activePageId \n            ? { ...p, elements: [...p.elements, newEl] }\n            : p\n        ),\n        selectedElementId: newEl.id\n      };\n    }\n    default:\n      return state;\n  }\n}"
      }
      num_matches: 1
    }
