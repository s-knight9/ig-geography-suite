        target_content: "  const handleZoomFit = (e: React.MouseEvent) => {\n    e.stopPropagation();\n    setManualZoom(null);\n  };\n\n  useLayoutEffect(() => {"
        replacement_content: "  const handleZoomFit = (e: React.MouseEvent) => {\n    e.stopPropagation();\n    setManualZoom(null);\n  };\n\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      // Avoid intercepting inputs like input boxes in toolbar\n      if (document.activeElement?.tagName === \'INPUT\' || document.activeElement?.tagName === \'TEXTAREA\') return;\n\n      if ((e.metaKey || e.ctrlKey) && e.key === \'c\') {\n         dispatch({ type: \'COPY_ELEMENT\' });\n      }\n      if ((e.metaKey || e.ctrlKey) && e.key === \'v\') {\n         dispatch({ type: \'PASTE_ELEMENT\' });\n      }\n    };\n    window.addEventListener(\'keydown\', handleKeyDown);\n    return () => window.removeEventListener(\'keydown\', handleKeyDown);\n  }, [dispatch]);\n\n  useLayoutEffect(() => {"
      }
