          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "       const dxLocalCm = (dxScreen * cosA - dyScreen * sinA) / PIXELS_PER_CM;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "       const dyLocalCm = (dxScreen * sinA + dyScreen * cosA) / PIXELS_PER_CM;"
