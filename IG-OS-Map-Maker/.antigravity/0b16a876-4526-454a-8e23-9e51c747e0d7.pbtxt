      target_content: "import React from \'react\';\nimport { useAppContext } from \'../store\';\nimport { Plus, Image as ImageIcon, Trash2 } from \'lucide-react\';\nimport { ElementData } from \'../types\';\n\nexport function Sidebar() {\n  const { state, dispatch } = useAppContext();\n\n  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n    const url = URL.createObjectURL(file);\n    const img = new Image();\n    img.onload = () => {\n      const el: ElementData = {\n        id: crypto.randomUUID(),\n        src: url,\n        x: 0,\n        y: 0,\n        width: img.naturalWidth,\n        height: img.naturalHeight,\n        rotation: 0\n      };\n      \n      el.x = (1587 - el.width) / 2;\n      el.y = (1122 - el.height) / 2;\n\n      dispatch({ type: \'ADD_ELEMENT\', payload: { pageId: state.activePageId, element: el } });\n      dispatch({ type: \'SET_SELECTED_ELEMENT\', payload: el.id });\n    };\n    img.src = url;\n    e.target.value = \'\';\n  };"
      replacement_content: "import React, { useState } from \'react\';\nimport { useAppContext } from \'../store\';\nimport { Plus, Image as ImageIcon, Trash2, Loader2 } from \'lucide-react\';\nimport { ElementData } from \'../types\';\nimport { convertPdfToImage } from \'../utils\';\n\nexport function Sidebar() {\n  const { state, dispatch } = useAppContext();\n  const [isProcessing, setIsProcessing] = useState(false);\n\n  const handleFileUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n    \n    setIsProcessing(true);\n    try {\n      let url = URL.createObjectURL(file);\n      if (file.type === \'application/pdf\') {\n        url = await convertPdfToImage(file);\n      }\n      \n      const img = new Image();\n      img.onload = () => {\n        const el: ElementData = {\n          id: crypto.randomUUID(),\n          src: url,\n          x: 0,\n          y: 0,\n          width: img.naturalWidth,\n          height: img.naturalHeight,\n          rotation: 0\n        };\n        \n        el.x = (1587 - el.width) / 2;\n        el.y = (1122 - el.height) / 2;\n\n        dispatch({ type: \'ADD_ELEMENT\', payload: { pageId: state.activePageId, element: el } });\n        dispatch({ type: \'SET_SELECTED_ELEMENT\', payload: el.id });\n        setIsProcessing(false);\n      };\n      img.onerror = () => {\n        alert(\'Failed to load image\');\n        setIsProcessing(false);\n      };\n      img.src = url;\n    } catch (err) {\n      console.error(err);\n      alert(\'Failed to process file\');\n      setIsProcessing(false);\n    }\n    e.target.value = \'\';\n  };"
    }
