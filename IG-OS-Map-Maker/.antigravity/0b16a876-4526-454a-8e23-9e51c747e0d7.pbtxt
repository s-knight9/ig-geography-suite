    replacement_chunks {
      replacement_content: "import React, { useRef, useEffect, useState } from \'react\';\nimport { useAppContext } from \'../store\';\nimport { ElementNode } from \'./ElementNode\';\nimport { Toolbar } from \'./Toolbar\';\nimport { CropOverlay } from \'./CropOverlay\';\n\nconst A3_WIDTH = 1587;\nconst A3_HEIGHT = 1122;\n\nexport function Workspace() {\n  const { state, dispatch } = useAppContext();\n  const activePage = state.pages.find(p => p.id === state.activePageId);\n  const containerRef = useRef<HTMLDivElement>(null);\n  const [zoom, setZoom] = useState(1);\n\n  useEffect(() => {\n    const updateZoom = () => {\n      if (!containerRef.current) return;\n      const { clientWidth, clientHeight } = containerRef.current;\n      const scaleX = Math.max((clientWidth - 80) / A3_WIDTH, 0.1); \n      const scaleY = Math.max((clientHeight - 80) / A3_HEIGHT, 0.1);\n      setZoom(Math.min(scaleX, scaleY));\n    };\n    updateZoom();\n    window.addEventListener(\'resize\', updateZoom);\n    return () => window.removeEventListener(\'resize\', updateZoom);\n  }, []);\n\n  if (!activePage) return null;\n\n  return (\n    <div \n      className=\"flex-1 overflow-hidden bg-[#e5e7eb] relative flex items-center justify-center\"\n      ref={containerRef}\n      onPointerDown={() => dispatch({ type: \'SET_SELECTED_ELEMENT\', payload: null })}\n    >\n      <div \n        style={{\n          width: A3_WIDTH,\n          height: A3_HEIGHT,\n          transform: `scale(${zoom})`,\n          transformOrigin: \'center center\',\n          backgroundColor: \'#fff\',\n          boxShadow: \'0 10px 40px rgba(0,0,0,0.15)\',\n        }}\n        className=\"relative overflow-visible\"\n      >\n        {activePage.elements.map(el => (\n          <ElementNode key={el.id} element={el} zoom={zoom} />\n        ))}\n\n        {state.cropMode && state.selectedElementId && (\n          <CropOverlay zoom={zoom} />\n        )}\n      </div>\n\n      <Toolbar />\n    </div>\n  );\n}\n"
    }
