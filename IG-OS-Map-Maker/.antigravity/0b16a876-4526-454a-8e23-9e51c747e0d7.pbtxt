    replacement_chunks {
      target_content: "  const CropHandle = ({ pos, style, cursor }: { pos: string, style: React.CSSProperties, cursor: string }) => (\n    <div \n      onPointerDown={(e) => handleCropDrag(e, pos)}\n      className={`absolute bg-gray-900 pointer-events-auto shadow-sm ${cursor}`}\n      style={style}\n    />\n  );\n\n  const hThick = 4;\n  const hLength = 24;\n\n  return (\n    <div\n      onPointerDown={handlePointerDown}\n      onDoubleClick={(e) => {\n        e.stopPropagation();\n        dispatch({ type: \'SET_SELECTED_ELEMENT\', payload: element.id });\n        dispatch({ type: \'SET_CROP_MODE\', payload: true });\n      }}\n      style={{\n        position: \'absolute\',\n        top: element.y * PIXELS_PER_CM,\n        left: element.x * PIXELS_PER_CM,\n        width: element.width * PIXELS_PER_CM,\n        height: element.height * PIXELS_PER_CM,\n        transform: `rotate(${element.rotation}deg)`,\n        transformOrigin: \'center center\',\n        cursor: state.cropMode && isSelected ? \'default\' : \'move\',\n        outline: isSelected && !state.cropMode ? \'2px solid #8ab4f8\' : \'none\',\n        outlineOffset: 0,\n        userSelect: \'none\',\n      }}\n      className=\"transition-shadow\"\n    >\n      {state.cropMode && isSelected && (\n        <img \n          src={element.src} \n          alt=\"\"\n          style={{ width: \'100%\', height: \'100%\', objectFit: \'fill\', position: \'absolute\', top: 0, left: 0, opacity: 0.4 }}\n          className=\"pointer-events-none\" \n        />\n      )}\n\n      <img \n        src={element.src} \n        alt=\"Map section layer\" \n        draggable={false}\n        style={{ \n          width: \'100%\', \n          height: \'100%\', \n          objectFit: \'fill\',\n          position: \'relative\',\n          zIndex: 5,\n          clipPath: `inset(${cropT}px ${cropR}px ${cropB}px ${cropL}px)`\n        }}\n        className=\"pointer-events-none\" \n      />\n\n      {state.cropMode && isSelected && (\n        <div style={{\n          position: \'absolute\',\n          top: cropT, left: cropL, right: cropR, bottom: cropB,\n          border: \'1px solid rgba(0,0,0,0.5)\',\n          boxShadow: \'inset 0 0 0 1px rgba(255,255,255,0.7), 0 0 0 9999px rgba(0,0,0,0.5)\',\n          pointerEvents: \'none\',\n          zIndex: 10\n        }}>\n          {/* Top-Left */}\n          <CropHandle pos=\"nw\" cursor=\"cursor-nwse-resize\" style={{ top: -hThick, left: -hThick, width: hLength, height: hThick }} />\n          <CropHandle pos=\"nw\" cursor=\"cursor-nwse-resize\" style={{ top: -hThick, left: -hThick, width: hThick, height: hLength }} />\n          \n          {/* Top-Right */}\n          <CropHandle pos=\"ne\" cursor=\"cursor-nesw-resize\" style={{ top: -hThick, right: -hThick, width: hLength, height: hThick }} />\n          <CropHandle pos=\"ne\" cursor=\"cursor-nesw-resize\" style={{ top: -hThick, right: -hThick, width: hThick, height: hLength }} />\n          \n          {/* Bottom-Left */}\n          <CropHandle pos=\"sw\" cursor=\"cursor-nesw-resize\" style={{ bottom: -hThick, left: -hThick, width: hLength, height: hThick }} />\n          <CropHandle pos=\"sw\" cursor=\"cursor-nesw-resize\" style={{ bottom: -hThick, left: -hThick, width: hThick, height: hLength }} />\n          \n          {/* Bottom-Right */}\n          <CropHandle pos=\"se\" cursor=\"cursor-nwse-resize\" style={{ bottom: -hThick, right: -hThick, width: hLength, height: hThick }} />\n          <CropHandle pos=\"se\" cursor=\"cursor-nwse-resize\" style={{ bottom: -hThick, right: -hThick, width: hThick, height: hLength }} />\n          \n          {/* Middles */}\n          <CropHandle pos=\"n\" cursor=\"cursor-ns-resize\" style={{ top: -hThick, left: \'50%\', transform: \'translateX(-50%)\', width: hLength, height: hThick }} />\n          <CropHandle pos=\"s\" cursor=\"cursor-ns-resize\" style={{ bottom: -hThick, left: \'50%\', transform: \'translateX(-50%)\', width: hLength, height: hThick }} />\n          <CropHandle pos=\"w\" cursor=\"cursor-ew-resize\" style={{ left: -hThick, top: \'50%\', transform: \'translateY(-50%)\', width: hThick, height: hLength }} />\n          <CropHandle pos=\"e\" cursor=\"cursor-ew-resize\" style={{ right: -hThick, top: \'50%\', transform: \'translateY(-50%)\', width: hThick, height: hLength }} />\n        </div>\n      )}\n      \n      {isSelected && !state.cropMode && (\n        <div \n          className=\"absolute left-1/2 -top-12 w-6 h-6 bg-white border border-[#8ab4f8] rounded-full flex items-center justify-center cursor-crosshair text-[#8ab4f8] shadow-sm pointer-events-auto\"\n          style={{ transform: \'translateX(-50%)\', zIndex: 20 }}\n          onPointerDown={handleRotatePointerDown}\n        >\n          <RotateCw className=\"w-3 h-3\" />\n          <div className=\"absolute top-full left-1/2 w-[1px] h-6 bg-[#8ab4f8]\" style={{ transform: \'translateX(-50%)\' }} />\n        </div>\n      )}\n    </div>\n  );\n}"
      replacement_content: "  const getCursorClass = (pos: string) => {\n    const posAngleMap: Record<string, number> = {\n      \'n\': 0, \'ne\': 45, \'e\': 90, \'se\': 135, \'s\': 180, \'sw\': 225, \'w\': 270, \'nw\': 315\n    };\n    const baseAngle = posAngleMap[pos];\n    let angle = Math.round((baseAngle + element.rotation) / 45) * 45;\n    angle = ((angle % 360) + 360) % 360; // Normalize\n    \n    if (angle === 0 || angle === 180) return \'cursor-ns-resize\';\n    if (angle === 45 || angle === 225) return \'cursor-nesw-resize\';\n    if (angle === 90 || angle === 270) return \'cursor-ew-resize\';\n    if (angle === 135 || angle === 315) return \'cursor-nwse-resize\';\n    return \'cursor-default\';\n  };\n\n  const CropHandle = ({ pos, style }: { pos: string, style: React.CSSProperties }) => (\n    <div \n      onPointerDown={(e) => handleCropDrag(e, pos)}\n      className={`absolute bg-gray-900 pointer-events-auto shadow-sm ${getCursorClass(pos)}`}\n      style={style}\n    />\n  );\n\n  const hThick = 4;\n  const hLength = 24;\n\n  return (\n    <div\n      onPointerDown={handlePointerDown}\n      onDoubleClick={(e) => {\n        e.stopPropagation();\n        dispatch({ type: \'SET_SELECTED_ELEMENT\', payload: element.id });\n        dispatch({ type: \'SET_CROP_MODE\', payload: true });\n      }}\n      style={{\n        position: \'absolute\',\n        top: element.y * PIXELS_PER_CM,\n        left: element.x * PIXELS_PER_CM,\n        width: element.width * PIXELS_PER_CM,\n        height: element.height * PIXELS_PER_CM,\n        transform: `rotate(${element.rotation}deg)`,\n        transformOrigin: \'center center\',\n        cursor: state.cropMode && isSelected ? \'default\' : \'move\',\n        userSelect: \'none\',\n        pointerEvents: \'none\',\n      }}\n      className=\"transition-shadow\"\n    >\n      {state.cropMode && isSelected && (\n        <img \n          src={element.src} \n          alt=\"\"\n          style={{ width: \'100%\', height: \'100%\', objectFit: \'fill\', position: \'absolute\', top: 0, left: 0, opacity: 0.4, pointerEvents: \'auto\' }}\n        />\n      )}\n\n      <img \n        src={element.src} \n        alt=\"Map section layer\" \n        draggable={false}\n        style={{ \n          width: \'100%\', \n          height: \'100%\', \n          objectFit: \'fill\',\n          position: \'relative\',\n          zIndex: 5,\n          clipPath: `inset(${cropT}px ${cropR}px ${cropB}px ${cropL}px)`,\n          pointerEvents: \'auto\'\n        }}\n      />\n\n      {state.cropMode && isSelected && (\n        <div style={{\n          position: \'absolute\',\n          top: cropT, left: cropL, right: cropR, bottom: cropB,\n          border: \'1px solid rgba(0,0,0,0.5)\',\n          boxShadow: \'inset 0 0 0 1px rgba(255,255,255,0.7), 0 0 0 9999px rgba(0,0,0,0.5)\',\n          pointerEvents: \'none\',\n          zIndex: 10\n        }}>\n          {/* Top-Left */}\n          <CropHandle pos=\"nw\" style={{ top: -hThick, left: -hThick, width: hLength, height: hThick }} />\n          <CropHandle pos=\"nw\" style={{ top: -hThick, left: -hThick, width: hThick, height: hLength }} />\n          \n          {/* Top-Right */}\n          <CropHandle pos=\"ne\" style={{ top: -hThick, right: -hThick, width: hLength, height: hThick }} />\n          <CropHandle pos=\"ne\" style={{ top: -hThick, right: -hThick, width: hThick, height: hLength }} />\n          \n          {/* Bottom-Left */}\n          <CropHandle pos=\"sw\" style={{ bottom: -hThick, left: -hThick, width: hLength, height: hThick }} />\n          <CropHandle pos=\"sw\" style={{ bottom: -hThick, left: -hThick, width: hThick, height: hLength }} />\n          \n          {/* Bottom-Right */}\n          <CropHandle pos=\"se\" style={{ bottom: -hThick, right: -hThick, width: hLength, height: hThick }} />\n          <CropHandle pos=\"se\" style={{ bottom: -hThick, right: -hThick, width: hThick, height: hLength }} />\n          \n          {/* Middles */}\n          <CropHandle pos=\"n\" style={{ top: -hThick, left: \'50%\', transform: \'translateX(-50%)\', width: hLength, height: hThick }} />\n          <CropHandle pos=\"s\" style={{ bottom: -hThick, left: \'50%\', transform: \'translateX(-50%)\', width: hLength, height: hThick }} />\n          <CropHandle pos=\"w\" style={{ left: -hThick, top: \'50%\', transform: \'translateY(-50%)\', width: hThick, height: hLength }} />\n          <CropHandle pos=\"e\" style={{ right: -hThick, top: \'50%\', transform: \'translateY(-50%)\', width: hThick, height: hLength }} />\n        </div>\n      )}\n      \n      {isSelected && !state.cropMode && (\n        <>\n          <div style={{\n            position: \'absolute\',\n            top: cropT, left: cropL, right: cropR, bottom: cropB,\n            border: \'2px solid #8ab4f8\',\n            pointerEvents: \'none\',\n          }} />\n          <div \n            className=\"absolute bg-white border border-[#8ab4f8] rounded-full flex items-center justify-center cursor-crosshair text-[#8ab4f8] shadow-sm pointer-events-auto w-6 h-6\"\n            style={{ \n              left: `calc(${cropL}px + (${element.width * PIXELS_PER_CM - cropL - cropR}px / 2))`,\n              top: `calc(${cropT}px - 48px)`,\n              transform: \'translateX(-50%)\', \n              zIndex: 20 \n            }}\n            onPointerDown={handleRotatePointerDown}\n          >\n            <RotateCw className=\"w-3 h-3\" />\n            <div className=\"absolute top-full left-1/2 w-[1px] h-6 bg-[#8ab4f8]\" style={{ transform: \'translateX(-50%)\' }} />\n          </div>\n        </>\n      )}\n    </div>\n  );\n}"
