        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const onPointerMove = (ev: PointerEvent) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "       const dxScreen = (ev.clientX - startX) / zoom;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "       const dyScreen = (ev.clientY - startY) / zoom;"
