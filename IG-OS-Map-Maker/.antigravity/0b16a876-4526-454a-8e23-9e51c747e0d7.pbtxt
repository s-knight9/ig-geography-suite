        replacement_content: "  return (\n    <aside className=\"w-64 bg-white border-l border-gray-200 shrink-0 p-4 flex flex-col z-10\">\n      <h2 className=\"text-xs font-bold text-gray-900 uppercase tracking-wider mb-4 border-b border-gray-100 pb-2\">Layer Controls</h2>\n      \n      {!selectedElement ? (\n        <p className=\"text-xs text-gray-400 italic\">No layer selected</p>\n      ) : (\n        <>\n          <div className=\"mb-6\">\n            <label className=\"text-[10px] text-gray-500 font-bold uppercase mb-2 block\">Rotation</label>\n            <div className=\"flex items-center gap-3\">\n              <input \n                type=\"range\" \n                min=\"-180\" max=\"180\" \n                value={selectedElement.rotation}\n                onChange={(e) => dispatch({ \n                  type: \'UPDATE_ELEMENT\', \n                  payload: { id: selectedElement.id, updates: { rotation: Number(e.target.value) } }\n                })}\n                className=\"flex-1 h-1 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-blue-600\"\n              />\n              <span className=\"text-[11px] font-mono bg-gray-100 px-2 py-0.5 rounded border border-gray-200\">{selectedElement.rotation}\302\260</span>\n            </div>\n            <div className=\"flex justify-between mt-2\">\n              <button \n                onClick={() => dispatch({ \n                  type: \'UPDATE_ELEMENT\', \n                  payload: { id: selectedElement.id, updates: { rotation: selectedElement.rotation - 90 } }\n                })}\n                className=\"px-2 py-1 border border-gray-200 rounded text-[9px] hover:bg-gray-50\">90\302\260 CCW</button>\n              <button \n                onClick={() => dispatch({ \n                  type: \'UPDATE_ELEMENT\', \n                  payload: { id: selectedElement.id, updates: { rotation: selectedElement.rotation + 90 } }\n                })}\n                className=\"px-2 py-1 border border-gray-200 rounded text-[9px] hover:bg-gray-50\">90\302\260 CW</button>\n            </div>\n          </div>\n\n          <div className=\"mb-6\">\n            <label className=\"text-[10px] text-gray-500 font-bold uppercase mb-2 block\">Crop Options</label>\n            <div className=\"grid grid-cols-2 gap-2\">\n              <button\n                onClick={() => dispatch({ type: \'SET_CROP_MODE\', payload: !state.cropMode })}\n                className={`flex items-center justify-center gap-2 py-2 border rounded text-[10px] font-medium transition-colors ${state.cropMode ? \'border-blue-600 bg-blue-50 text-blue-700\' : \'border-gray-300 hover:bg-gray-50\'}`}\n              >\n                <svg className=\"w-3 h-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M3 6h18M3 12h18M3 18h18\"/></svg>\n                {state.cropMode ? \'Cancel\' : \'Apply Crop\'}\n              </button>\n              <button \n                disabled={!state.cropMode}\n                className=\"flex items-center justify-center gap-2 py-2 border border-blue-600 bg-blue-50 text-blue-700 rounded text-[10px] font-bold shadow-sm disabled:opacity-50 disabled:border-gray-300 disabled:text-gray-400 disabled:bg-gray-50\"\n              >\n                <svg className=\"w-3 h-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M12 4v16m8-8H4\"/></svg>\n                Extract to New\n              </button>\n            </div>\n            <p className=\"text-[9px] text-gray-400 mt-2\">Active crop box must be applied from the workspace interface over the image.</p>\n          </div>\n\n          <div className=\"flex-1 bg-gray-50 rounded p-3 border border-gray-200\">\n            <label className=\"text-[10px] text-gray-500 font-bold uppercase mb-2 block\">Metadata</label>\n            <div className=\"space-y-2\">\n              <div className=\"flex justify-between\">\n                <span className=\"text-[10px] text-gray-400\">Resolution</span>\n                <span className=\"text-[10px] font-mono\">300 DPI</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-[10px] text-gray-400\">Native Size</span>\n                <span className=\"text-[10px] font-mono\">{Math.round(selectedElement.width)} x {Math.round(selectedElement.height)}px</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-[10px] text-gray-400\">Scale Locking</span>\n                <span className=\"text-[10px] font-bold text-green-600\">ACTIVE</span>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"mt-4 flex gap-2\">\n             <button\n              onClick={() => {\n                dispatch({ type: \'DELETE_ELEMENT\', payload: { id: selectedElement.id } });\n                dispatch({ type: \'SET_SELECTED_ELEMENT\', payload: null });\n              }}\n              className=\"flex-1 py-2 text-[10px] font-bold border border-red-200 text-red-600 rounded hover:bg-red-50 uppercase\"\n             >\n                Delete Layer\n             </button>\n          </div>\n        </>\n      )}\n    </aside>\n  );"
      }
      num_matches: 1
