     onChange={(e) => setCommandWord(e.target.value as CommandWordTuple)}\n                className=\"w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-colors\"\n                required\n              >\n                <option value=\"\" disabled>Select Format...</option>\n                {COMMAND_WORDS.map((cw) => (\n                  <option key={cw} value={cw}>\n                    {cw}\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            <button\n              type=\"submit\"\n              disabled={loading || !paper || !topic || !commandWord}\n              className=\"w-full mt-2 bg-indigo-600 hover:bg-indigo-700 disabled:bg-indigo-400 text-white font-bold py-3 rounded-lg shadow-lg shadow-indigo-100 flex items-center justify-center gap-2 transition-all\"\n            >\n              {loading ? (\n                <Loader2 className=\"w-5 h-5 animate-spin\" />\n              ) : (\n                <>\n                  <span>Generate Materials</span>\n                  <Send className=\"w-4 h-4 ml-1\" />\n                </>\n              )}\n            </button>\n\n            {error && (\n              <div className=\"bg-rose-50 border border-rose-200 text-rose-600 text-sm p-3 rounded-lg mt-2\">\n                {error}\n              </div>\n            )}\n          </form>\n\n          <div className=\"mt-auto p-4 bg-slate-50 rounded-xl border border-dashed border-slate-300 hidden lg:block\">\n            <p className=\"text-[11px] text-slate-400 leading-relaxed uppercase font-semibold\">\n              System: Using IGCSE_HIGH_5_V1\n              <br />Temp: 0.7 | Top-P: 0.95\n            </p>\n          </div>\n        </aside>\n\n        {/* Main Content (Bento Grid) */}\n        <main className=\"flex-1 p-4 lg:p-8 lg:overflow-y-auto\">\n          {!result && !loading ? (\n            <div className=\"bg-white rounded-2xl border border-slate-200 shadow-sm p-12 text-center flex flex-col items-center justify-center h-full min-h-[400px]\">\n              <div className=\"w-16 h-16 bg-slate-50 rounded-2xl border border-slate-100 flex items-center justify-center mb-4\">\n                <RefreshCw className=\"w-8 h-8 text-slate-400\" />\n              </div>\n              <h3 className=\"text-lg font-bold text-slate-700 mb-2\">Awaiting Parameters</h3>\n              <p className=\"text-sm text-slate-500 max-w-sm\">\n                Select a paper, dynamic topic, and command word from the sidebar controls to generate IGCSE 0460 aligned questions and mark schemes.\n              </p>\n            </div>\n          ) : loading ? (\n             <div className=\"bg-white rounded-2xl border border-slate-200 shadow-sm p-12 text-center flex flex-col items-center justify-center h-full min-h-[400px]\">\n              <Loader2 className=\"w-10 h-10 animate-spin text-indigo-600 mb-4\" />\n              <h3 className=\"text-lg font-bold text-slate-700 mb-2\">Synthesizing Materials</h3>\n              <p className=\"text-sm text-slate-500 font-mono\">\n                Generating scenario-based questions and structured mark schemes...\n              </p>\n            </div>\n          ) : result ? (\n            <div className=\"grid grid-cols-1 md:grid-cols-12 md:grid-rows-12 gap-6 auto-rows-min md:h-full animate-in fade-in duration-500\">\n              \n              {/* The Question */}\n              <section className=\"col-span-1 md:col-span-12 md:row-span-4 bg-white rounded-2xl border border-slate-200 shadow-sm p-6 overflow-hidden flex flex-col\">\n                <div className=\"flex items-center gap-2 mb-4\">\n                  <div className=\"w-2 h-6 bg-indigo-500 rounded-full\"></div>\n                  <h2 className=\"text-sm font-bold text-slate-500 uppercase tracking-widest\">The Question</h2>\n                </div>\n                <div className=\"prose prose-slate max-w-none text-slate-800 flex-1 overflow-y-auto pr-2\">\n                   <div className=\"text-xl font-medium leading-relaxed\">\n                      <Markdown>{result.question}</Markdown>\n                   </div>\n                </div>\n              </section>\n\n              {/* The 1-5 Mark Scheme */}\n              <section className=\"col-span-1 md:col-span-6 md:row-span-8 bg-white rounded-2xl border border-slate-200 shadow-sm p-6 overflow-hidden flex flex-col\">\n                <div className=\"flex items-center gap-2 mb-4 shrink-0\">\n                  <div className=\"w-2 h-6 bg-rose-500 rounded-full\"></div>\n                  <h2 className=\"text-sm font-bold text-slate-500 uppercase tracking-widest\">1\342\200\2235 Mark Scheme</h2>\n                </div>\n                <div className=\"prose prose-slate max-w-none text-sm text-slate-600 overflow-y-auto pr-2\">\n                  <div className=\"markdown-body\">\n                    <Markdown>{result.markScheme}</Markdown>\n                  </div>\n                </div>\n              </section>\n\n              {/* The Sentence Starters */}\n              <section className=\"col-span-1 md:col-span-6 md:row-span-8 bg-[#1e293b] rounded-2xl border border-slate-800 shadow-xl p-6 overflow-hidden flex flex-col\">\n                <div className=\"flex items-center gap-2 mb-4 shrink-0\">\n                  <div className=\"w-2 h-6 bg-cyan-400 rounded-full\"></div>\n                  <h2 className=\"text-sm font-bold text-cyan-400 uppercase tracking-widest\">Sentence Starters</h2>\n                </div>\n                <div className=\"space-y-3 overflow-y-auto pr-2\">\n                  {result.starters.map((starter, index) => (\n                    <div key={index} className=\"p-4 bg-slate-800/50 rounded-lg border border-slate-700 font-mono text-sm text-cyan-50 flex gap-3\">\n                      <span className=\"text-slate-500 shrink-0\">{String(index + 1).padStart(2, \'0\')}</span>\n                      <p>{starter}</p>\n                    </div>\n                  ))}\n                </div>\n              </section>\n\n            </div>\n          ) : null}\n        </main>\n      </div>\n    </div>"
