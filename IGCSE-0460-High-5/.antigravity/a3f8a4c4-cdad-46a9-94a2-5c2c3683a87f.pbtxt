nerate} className=\"flex flex-col gap-6\">\n            \n            {/* Paper Dropdown */}\n            <div>\n              <label htmlFor=\"paper\" className=\"block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2\">\n                Dropdown 1: Select Component\n              </label>\n              <select\n                id=\"paper\"\n                value={paper}\n                onChange={(e) => setPaper(e.target.value as PaperTuple)}\n                className=\"w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-[#1d5cf9] outline-none transition-colors\"\n                required\n              >"
