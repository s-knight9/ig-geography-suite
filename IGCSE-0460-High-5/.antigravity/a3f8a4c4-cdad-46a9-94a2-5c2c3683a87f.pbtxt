    replacement_chunks {
      target_content: "      <div className=\"flex flex-col flex-1 overflow-hidden max-w-[1600px] mx-auto w-full\">\n        {/* Top Controls */}\n        <div className=\"w-full bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 p-4 sm:p-6 shrink-0 transition-colors z-0 flex justify-center\">\n          <form onSubmit={handleGenerate} className=\"flex flex-col gap-4 w-full max-w-5xl\">\n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n              {/* Paper Dropdown */}\n              <select\n                id=\"paper\"\n                value={paper}\n                onChange={(e) => setPaper(e.target.value as PaperTuple)}\n                className=\"w-full p-3 bg-slate-50 dark:bg-slate-950/50 border border-slate-200 dark:border-slate-700 rounded-lg text-sm text-black dark:text-white focus:ring-2 focus:ring-[#1d5cf9] outline-none transition-colors\"\n                required\n              >\n                <option value=\"\" disabled>Select Paper...</option>\n                <option value=\"Paper 1: Physical Geography\">Paper 1: Physical Geography</option>\n                <option value=\"Paper 2: Human Geography\">Paper 2: Human Geography</option>\n              </select>\n\n              {/* Topic Dropdown */}\n              <select\n                id=\"topic\"\n                value={topic}\n                onChange={(e) => setTopic(e.target.value)}\n                className=\"w-full p-3 bg-slate-50 dark:bg-slate-950/50 border border-slate-200 dark:border-slate-700 rounded-lg text-sm text-black dark:text-white focus:ring-2 focus:ring-[#1d5cf9] outline-none transition-colors disabled:opacity-60 disabled:cursor-not-allowed\"\n                disabled={!paper}\n                required\n              >\n                <option value=\"\" disabled>Select Unit...</option>\n                {activeTopics.map((t) => (\n                  <option key={t.id} value={t.id}>\n                    {t.name}\n                  </option>\n                ))}\n              </select>\n\n              {/* Command Word Dropdown */}\n              <select\n                id=\"commandWord\"\n                value={commandWord}\n                onChange={(e) => setCommandWord(e.target.value as CommandWordTuple)}\n                className=\"w-full p-3 bg-slate-50 dark:bg-slate-950/50 border border-slate-200 dark:border-slate-700 rounded-lg text-sm text-black dark:text-white focus:ring-2 focus:ring-[#1d5cf9] outline-none transition-colors\"\n                required\n              >\n                <option value=\"\" disabled>Select Command...</option>\n                {COMMAND_WORDS.map((cw) => (\n                  <option key={cw} value={cw}>\n                    {cw}\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            <button\n              type=\"submit\"\n              disabled={loading || !paper || !topic || !commandWord}\n              className=\"w-full bg-[#1d5cf9] hover:bg-[#154ad3] disabled:bg-[#5a86fb] text-white text-[15px] font-bold py-3 rounded-lg shadow-lg shadow-[#1d5cf9]/20 flex items-center justify-center gap-2 transition-all\"\n            >\n              {loading ? (\n                <Loader2 className=\"w-5 h-5 animate-spin\" />\n              ) : (\n                <>\n                  <span>Generate Materials</span>\n                  <Send className=\"w-4 h-4 ml-1\" />\n                </>\n              )}\n            </button>\n\n            {error && (\n              <div className=\"bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/50 text-rose-600 dark:text-rose-400 text-sm p-3 rounded-lg mt-2\">\n                {error}\n              </div>\n            )}\n          </form>\n        </div>"
      replacement_content: "      <div className=\"flex flex-col flex-1 overflow-hidden max-w-[1600px] mx-auto w-full\">\n        {/* Top Controls */}\n        <div className=\"w-full bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 p-4 sm:p-6 shrink-0 transition-colors z-0 flex flex-col xl:flex-row justify-between items-start xl:items-center gap-6\">\n          <form onSubmit={handleGenerate} className=\"flex flex-col gap-4 w-full xl:max-w-4xl\">\n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n              {/* Paper Dropdown */}\n              <select\n                id=\"paper\"\n                value={paper}\n                onChange={(e) => setPaper(e.target.value as PaperTuple)}\n                className=\"w-full p-3 bg-slate-50 dark:bg-slate-950/50 border border-slate-200 dark:border-slate-700 rounded-lg text-sm text-black dark:text-white focus:ring-2 focus:ring-[#1d5cf9] outline-none transition-colors\"\n                required\n              >\n                <option value=\"\" disabled>Select Paper...</option>\n                <option value=\"Paper 1: Physical Geography\">Paper 1: Physical Geography</option>\n                <option value=\"Paper 2: Human Geography\">Paper 2: Human Geography</option>\n              </select>\n\n              {/* Topic Dropdown */}\n              <select\n                id=\"topic\"\n                value={topic}\n                onChange={(e) => setTopic(e.target.value)}\n                className=\"w-full p-3 bg-slate-50 dark:bg-slate-950/50 border border-slate-200 dark:border-slate-700 rounded-lg text-sm text-black dark:text-white focus:ring-2 focus:ring-[#1d5cf9] outline-none transition-colors disabled:opacity-60 disabled:cursor-not-allowed\"\n                disabled={!paper}\n                required\n              >\n                <option value=\"\" disabled>Select Unit...</option>\n                {activeTopics.map((t) => (\n                  <option key={t.id} value={t.id}>\n                    {t.name}\n                  </option>\n                ))}\n              </select>\n\n              {/* Command Word Dropdown */}\n              <select\n                id=\"commandWord\"\n                value={commandWord}\n                onChange={(e) => setCommandWord(e.target.value as CommandWordTuple)}\n                className=\"w-full p-3 bg-slate-50 dark:bg-slate-950/50 border border-slate-200 dark:border-slate-700 rounded-lg text-sm text-black dark:text-white focus:ring-2 focus:ring-[#1d5cf9] outline-none transition-colors\"\n                required\n              >\n                <option value=\"\" disabled>Select Command...</option>\n                {COMMAND_WORDS.map((cw) => (\n                  <option key={cw} value={cw}>\n                    {cw}\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            <button\n              type=\"submit\"\n              disabled={loading || !paper || !topic || !commandWord}\n              className=\"w-full bg-[#1d5cf9] hover:bg-[#154ad3] disabled:bg-[#5a86fb] text-white text-[15px] font-bold py-3 rounded-lg shadow-lg shadow-[#1d5cf9]/20 flex items-center justify-center gap-2 transition-all\"\n            >\n              {loading ? (\n                <Loader2 className=\"w-5 h-5 animate-spin\" />\n              ) : (\n                <>\n                  <span>Generate Materials</span>\n                  <Send className=\"w-4 h-4 ml-1\" />\n                </>\n              )}\n            </button>\n\n            {error && (\n              <div className=\"bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/50 text-rose-600 dark:text-rose-400 text-sm p-3 rounded-lg mt-2\">\n                {error}\n              </div>\n            )}\n          </form>\n          \n          <TeacherTimer />\n        </div>"
