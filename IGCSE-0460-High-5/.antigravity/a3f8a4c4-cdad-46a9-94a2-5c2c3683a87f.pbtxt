    replacement_chunks {
      target_content: "    <div className=\"min-h-screen bg-[#0E1117] text-[#FAFAFA] font-sans selection:bg-[#F23A3A]/30\">\n      <header className=\"border-b border-[#2D333B] bg-[#161B22] p-4 flex items-center justify-between sticky top-0 z-10\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"bg-gradient-to-br from-[#F23A3A] to-[#E31C1C] p-2 rounded-lg\">\n            <BookOpen className=\"w-5 h-5 text-white\" />\n          </div>\n          <div>\n            <h1 className=\"text-xl font-bold tracking-tight\">IGCSE 0460 HIGH 5</h1>\n            <p className=\"text-xs text-[#7D8590] uppercase font-mono tracking-widest mt-0.5\">\n              Exam Generator Engine\n            </p>\n          </div>\n        </div>\n      </header>\n\n      <main className=\"max-w-7xl mx-auto p-4 sm:p-6 lg:p-8\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8\">\n          \n          {/* Controls Panel */}\n          <div className=\"lg:col-span-4 flex flex-col gap-6\">\n            <div className=\"bg-[#161B22] border border-[#2D333B] rounded-xl p-6 shadow-xl shadow-black/20\">\n              <h2 className=\"text-sm font-semibold tracking-wide text-[#7D8590] uppercase mb-4\">\n                Test Parameters\n              </h2>\n              \n              <form onSubmit={handleGenerate} className=\"flex flex-col gap-5\">\n                \n                {/* Paper Dropdown */}\n                <div className=\"flex flex-col gap-2\">\n                  <label htmlFor=\"paper\" className=\"text-sm font-medium\">\n                    1. Paper\n                  </label>\n                  <select\n                    id=\"paper\"\n                    value={paper}\n                    onChange={(e) => setPaper(e.target.value as PaperTuple)}\n                    className=\"w-full bg-[#0D1117] border border-[#2D333B] rounded-lg p-2.5 text-sm outline-none focus:border-[#F23A3A] transition-colors appearance-none\"\n                    required\n                  >\n                    <option value=\"\" disabled>Select Paper...</option>\n                    <option value=\"Paper 1: Physical Geography\">Paper 1: Physical Geography</option>\n                    <option value=\"Paper 2: Human Geography\">Paper 2: Human Geography</option>\n                  </select>\n                </div>\n\n                {/* Topic Dropdown */}\n                <div className=\"flex flex-col gap-2\">\n                  <label htmlFor=\"topic\" className=\"text-sm font-medium\">\n                    2. Topic\n                  </label>\n                  <select\n                    id=\"topic\"\n                    value={topic}\n                    onChange={(e) => setTopic(e.target.value)}\n                    className=\"w-full bg-[#0D1117] border border-[#2D333B] rounded-lg p-2.5 text-sm outline-none focus:border-[#F23A3A] transition-colors appearance-none disabled:opacity-50 disabled:cursor-not-allowed\"\n                    disabled={!paper}\n                    required\n                  >\n                    <option value=\"\" disabled>Select Topic...</option>\n                    {activeTopics.map((t) => (\n                      <option key={t.id} value={t.id}>\n                        {t.name}\n                      </option>\n                    ))}\n                  </select>\n                </div>\n\n                {/* Command Word Dropdown */}\n                <div className=\"flex flex-col gap-2\">\n                  <label htmlFor=\"commandWord\" className=\"text-sm font-medium\">\n                    3. Command Word\n                  </label>\n                  <select\n                    id=\"commandWord\"\n                    value={commandWord}\n                    onChange={(e) => setCommandWord(e.target.value as CommandWordTuple)}\n                    className=\"w-full bg-[#0D1117] border border-[#2D333B] rounded-lg p-2.5 text-sm outline-none focus:border-[#F23A3A] transition-colors appearance-none\"\n                    required\n                  >\n                    <option value=\"\" disabled>Select Command Word...</option>\n                    {COMMAND_WORDS.map((cw) => (\n                      <option key={cw} value={cw}>\n                        {cw}\n                      </option>\n                    ))}\n                  </select>\n                </div>\n\n                <div className=\"pt-2\">\n                  <button\n                    type=\"submit\"\n                    disabled={loading || !paper || !topic || !commandWord}\n                    className=\"w-full bg-[#F23A3A] hover:bg-[#E31C1C] disabled:bg-[#F23A3A]/30 disabled:text-white/50 text-white font-medium py-3 px-4 rounded-lg flex items-center justify-center gap-2 transition-all active:scale-[0.98]\"\n                  >\n                    {loading ? (\n                      <Loader2 className=\"w-5 h-5 animate-spin\" />\n                    ) : (\n                      <Send className=\"w-5 h-5\" />\n                    )}\n                    {loading ? \"Generating...\" : \"Generate Resources\"}\n                  </button>\n                </div>\n\n                {error && (\n                  <div className=\"bg-red-500/10 border border-red-500/50 text-red-400 text-sm p-3 rounded-lg flex items-start gap-2\">\n                    <span className=\"shrink-0 mt-0.5 h-1.5 w-1.5 rounded-full bg-red-500 block\" />\n                    {error}\n                  </div>\n                )}\n              </form>\n            </div>\n          </div>\n\n          {/* Output Panel */}\n          <div className=\"lg:col-span-8 flex flex-col gap-6\">\n            {!result && !loading ? (\n              <div className=\"bg-[#161B22] border border-[#2D333B] border-dashed rounded-xl p-12 text-center flex flex-col items-center justify-center h-full min-h-[400px]\">\n                <div className=\"w-16 h-16 bg-[#2D333B]/50 rounded-2xl flex items-center justify-center mb-4\">\n                  <RefreshCw className=\"w-8 h-8 text-[#7D8590]\" />\n                </div>\n                <h3 className=\"text-lg font-medium text-[#FAFAFA] mb-2\">Awaiting Parameters</h3>\n                <p className=\"text-sm text-[#7D8590] max-w-sm\">\n                  Select a paper, dynamic topic, and command word from the controls panel to generate IGCSE 0460 aligned questions and mark schemes.\n                </p>\n              </div>\n            ) : loading ? (\n              <div className=\"bg-[#161B22] border border-[#2D333B] rounded-xl p-12 text-center flex flex-col items-center justify-center h-full min-h-[400px]\">\n                <Loader2 className=\"w-10 h-10 animate-spin text-[#F23A3A] mb-4\" />\n                <h3 className=\"text-lg font-medium text-[#FAFAFA] mb-2\">Synthesizing Exam Resources</h3>\n                <p className=\"text-sm text-[#7D8590] font-mono\">\n                  Loading structural logic / verifying constraints...\n                </p>\n              </div>\n            ) : result ? (\n              <div className=\"flex flex-col gap-6 animate-in slide-in-from-bottom-4 duration-500 fade-in\">\n                \n                {/* Container 1: The Question */}\n                <div className=\"bg-[#161B22] border border-[#2D333B] rounded-xl overflow-hidden shadow-xl shadow-black/20 relative\">\n                  <div className=\"bg-[#2D333B]/30 border-b border-[#2D333B] px-5 py-3 flex items-center justify-between\">\n                    <h2 className=\"text-sm font-semibold tracking-wide text-[#7D8590] uppercase\">\n                      The 5-Mark Question\n                    </h2>\n                    <span className=\"text-xs font-mono bg-[#0D1117] text-[#FAFAFA] px-2 py-1 rounded border border-[#2D333B]\">\n                      5 Marks\n                    </span>\n                  </div>\n                  <div className=\"p-6 prose prose-invert prose-p:leading-relaxed prose-pre:bg-[#0D1117] prose-pre:border prose-pre:border-[#2D333B] max-w-none\">\n                    <div className=\"markdown-body text-[#FAFAFA]\">\n                      <Markdown>{result.question}</Markdown>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Container 2: Mark Scheme */}\n                <div className=\"bg-[#161B22] border border-[#2D333B] rounded-xl overflow-hidden shadow-xl shadow-black/20\">\n                  <div className=\"bg-[#2D333B]/30 border-b border-[#2D333B] px-5 py-3 flex items-center justify-between\">\n                    <h2 className=\"text-sm font-semibold tracking-wide text-[#7D8590] uppercase\">\n                      The 1\342\200\2235 Mark Scheme\n                    </h2>\n                  </div>\n                  <div className=\"p-6 prose prose-invert prose-p:leading-relaxed prose-pre:bg-[#0D1117] prose-pre:border prose-pre:border-[#2D333B] max-w-none\">\n                    <div className=\"markdown-body text-[#C9D1D9]\">\n                      <Markdown>{result.markScheme}</Markdown>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Container 3: Sentence Starters */}\n                <div className=\"bg-[#161B22] border border-[#2D333B] rounded-xl overflow-hidden shadow-xl shadow-black/20\">\n                  <div className=\"bg-[#2D333B]/30 border-b border-[#2D333B] px-5 py-3 flex items-center justify-between\">\n                    <h2 className=\"text-sm font-semibold tracking-wide text-[#7D8590] uppercase\">\n                      Tailored Scaffolding (Sentence Starters)\n                    </h2>\n                  </div>\n                  <div className=\"p-6\">\n                    <ul className=\"space-y-3\">\n                      {result.starters.map((starter, index) => (\n                        <li key={index} className=\"flex items-start gap-3 bg-[#0D1117] border border-[#2D333B] p-4 rounded-lg\">\n                          <span className=\"shrink-0 flex items-center justify-center w-6 h-6 rounded bg-[#F23A3A]/10 text-[#F23A3A] font-mono text-xs font-bold mt-0.5\">\n                            {index + 1}\n                          </span>\n                          <span className=\"text-[#FAFAFA]\">{starter}</span>\n                        </li>\n                      ))}\n                    </ul>\n                  </div>\n                </div>\n\n              </div>\n            ) : null}\n          </div>\n        </div>\n      </main>\n    </div>"
      replacement_content: "    <div className=\"min-h-screen bg-[#f8fafc] text-slate-900 font-sans flex flex-col overflow-hidden\">\n      <header className=\"h-16 bg-white border-b border-slate-200 flex items-center justify-between px-4 sm:px-8 shrink-0 sticky top-0 z-10\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center\">\n            <span className=\"text-white font-bold text-lg\">5</span>\n          </div>\n          <h1 className=\"text-xl font-bold tracking-tight text-slate-800\">\n            IGCSE <span className=\"text-indigo-600\">High 5</span>\n          </h1>\n        </div>\n        <div className=\"hidden sm:flex items-center gap-4\">\n          <div className=\"flex items-center gap-2 px-3 py-1.5 bg-green-50 text-green-700 rounded-full border border-green-100\">\n            <div className=\"w-2 h-2 bg-green-500 rounded-full\"></div>\n            <span className=\"text-xs font-semibold uppercase tracking-wider\">Gemini 1.5 Flash Connected</span>\n          </div>\n          <div className=\"w-10 h-10 rounded-full bg-slate-200 border border-slate-300 flex items-center justify-center\">\n             <BookOpen className=\"w-5 h-5 text-slate-500\" />\n          </div>\n        </div>\n      </header>\n\n      <div className=\"flex flex-col lg:flex-row flex-1 overflow-hidden max-w-[1600px] mx-auto w-full\">\n        {/* Sidebar Controls */}\n        <aside className=\"w-full lg:w-80 bg-white lg:border-r border-b lg:border-b-0 border-slate-200 p-6 flex flex-col gap-6 shrink-0 lg:overflow-y-auto\">\n          <form onSubmit={handleGenerate} className=\"flex flex-col gap-6\">\n            \n            {/* Paper Dropdown */}\n            <div>\n              <label htmlFor=\"paper\" className=\"block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2\">\n                Dropdown 1: Select Component\n              </label>\n              <select\