    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "html-to-docx": "^1.8.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "leaflet": "^1.9.4",
    "leaflet-image": "^0.4.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.5",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
